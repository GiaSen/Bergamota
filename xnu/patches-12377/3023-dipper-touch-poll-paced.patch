diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
index b7ad5c8..9544e3d 100644
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -411,6 +411,15 @@ static unsigned bb_half_us = 5u;
 #define BB_HALF_US bb_half_us
 /* Poll period of the touch thread in ms (IRQ latch check; reads only on edges or while down) */
 static unsigned touch_poll_ms = 10u;
+/*
+ * 3023: looking at the IRQ line every 2 ms was the kernel's largest idle cost, 5.5% of a core with the screen off too: 500 wake-ups a
+ * second. The ST FTS holds its line low while events wait in its FIFO, so looking less often loses no event, only time. Screen off: 100 ms.
+ * Screen on, no finger for 2 s: 4 ms, half of the IC's scan period. A finger, or within those 2 s: touch_poll_ms as before.
+ */
+extern int sweet_fb_display_off;
+static int touch_idle_ms = 4, touch_off_ms = 100;
+SYSCTL_INT(_kern, OID_AUTO, sweet_touch_idle_ms, CTLFLAG_RW | CTLFLAG_LOCKED, &touch_idle_ms, 0, "Mi 8 touch poll with the screen on and no finger");
+SYSCTL_INT(_kern, OID_AUTO, sweet_touch_off_ms, CTLFLAG_RW | CTLFLAG_LOCKED, &touch_off_ms, 0, "Mi 8 touch poll with the screen off");
 static void
 bb_line(unsigned pin, bool high)
 {
@@ -1306,6 +1315,27 @@ touch_se_init(void)
 	return true;
 }
 
+/* 3023: how long until the next look at the IRQ line */
+static unsigned
+touch_pace(void)
+{
+	static uint64_t last_finger, two_s;
+	uint64_t now = mach_absolute_time();
+	int ms;
+	if (st.kind != TOUCH_STFTS) {
+		return touch_poll_ms;
+	}
+	if (two_s == 0) {
+		nanoseconds_to_absolutetime(2ull * NSEC_PER_SEC, &two_s);
+	}
+	if (st.active) {
+		last_finger = now;
+		return touch_poll_ms;
+	}
+	ms = __atomic_load_n(&sweet_fb_display_off, __ATOMIC_RELAXED) ? touch_off_ms : now - last_finger < two_s ? (int)touch_poll_ms : touch_idle_ms;
+	return ms >= 1 && ms <= 1000 ? (unsigned)ms : touch_poll_ms;
+}
+
 static void
 touch_thread(void *arg, wait_result_t result)
 {
@@ -1466,7 +1496,7 @@ selected:
 				errors = 0;
 			}
 		}
-		touch_wait(touch_poll_ms);
+		touch_wait(touch_pace());
 	}
 	touch_report(0, st.x, st.y);
