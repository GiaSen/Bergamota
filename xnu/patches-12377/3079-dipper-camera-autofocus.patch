+/*
+ * 3079: the lens actuator, an AKM AK7372 (the IMX363 module file's actuatorDriver "dipper_imx363_ak7372_semco": 8-bit
+ * slave 0x18, byte register addresses, the 10-bit lens code << 6 as a word in 0x00/0x01, init 0x00 = 0x3c, 0x01 = 0,
+ * 0x02 = 0, 100 us apart; power VAF on, 10 ms). VAF = the live DT's actuator_rear_regulator: TLMM GPIO 26 high, fed by
+ * PMI8998 BOB. Contrast autofocus after the exposure is on target: a coarse pass over the codes 0-1023, a fine pass
+ * around the best, each code scored on the frame finished 3 frames after the move.
+ */
+#define AF_ADDR         0x18u
+#define AF_INIT_CODE    240u    /* 0x3c00 >> 6 */
+static unsigned cam_af = 1;
+static unsigned cam_lens = AF_INIT_CODE;
+static unsigned af_pos;
+SYSCTL_UINT(_kern, OID_AUTO, sweet_cam_af, CTLFLAG_RW | CTLFLAG_LOCKED, &cam_af, 0, "3079: kern.sweet_cam=4 contrast autofocus (1) or the lens at kern.sweet_cam_lens (0)");
+SYSCTL_UINT(_kern, OID_AUTO, sweet_cam_lens, CTLFLAG_RW | CTLFLAG_LOCKED, &cam_lens, 0, "3079: manual lens code 0-1023");
+
+static bool
+af_write(uint8_t reg, const uint8_t *v, int n)
+{
+	i2c_start();
+	bool ok = i2c_tx(AF_ADDR) && i2c_tx(reg);
+	for (int i = 0; ok && i < n; i++) {
+		ok = i2c_tx(v[i]);
+	}
+	i2c_stop();
+	return ok;
+}
+
+/* the lens to a code in steps of at most 96, 1 ms apart (big jumps ring) */
+static bool
+af_move(unsigned code)
+{
+	bool ok = true;
+
+	if (code > 1023u) {
+		code = 1023u;
+	}
+	while (ok && af_pos != code) {
+		unsigned next = code > af_pos ? (code - af_pos > 96u ? af_pos + 96u : code) : (af_pos - code > 96u ? af_pos - 96u : code);
+		uint16_t w = (uint16_t)(next << 6);
+		const uint8_t b[2] = { (uint8_t)(w >> 8), (uint8_t)w };
+		ok = af_write(0x00, b, 2);
+		af_pos = next;
+		if (af_pos != code) {
+			delay(1000);
+		}
+	}
+	return ok;
+}
+
+/* contrast of the middle third: squared differences of neighbouring greens along even lines (8 high bits) */
+static uint64_t
+af_sharpness(const uint8_t *f)
+{
+	uint64_t sum = 0;
+	const unsigned g0 = C4_W / 12, g1 = 2 * C4_W / 12;     /* 4-pixel groups 160-319 */
+
+	for (unsigned y = C4_H / 3; y < 2 * C4_H / 3; y += 2) {
+		const uint8_t *r = f + (size_t)y * C4_STRIDE;
+		sweet_dma_sync_va(r + 5 * g0, 5 * (g1 - g0) + 8);
+		for (unsigned g = g0; g < g1; g++) {
+			int a = r[5 * g + 1], b = r[5 * g + 3], c = r[5 * (g + 1) + 1];
+			sum += (uint64_t)((a - b) * (a - b) + (b - c) * (b - c));
+		}
+	}
+	return sum;
+}
+
+/* who answers on the CCI 0 pins' bus (an address byte with the write bit, then a stop) */
+static void
+i2c_scan_say(const char *what)
+{
+	char line[200];
+	size_t k = (size_t)snprintf(line, sizeof(line), "%s, 7-bit addresses that ACK:", what);
+	unsigned n = 0;
+	for (unsigned a = 0x08; a < 0x78; a++) {
+		i2c_start();
+		bool ack = i2c_tx((uint8_t)(a << 1));
+		i2c_stop();
+		if (ack && k < sizeof(line) - 8) {
+			k += (size_t)snprintf(line + k, sizeof(line) - k, " %#04x", a);
+			n++;
+		}
+	}
+	cam_say("%s%s", line, n ? "" : " none");
+}
