+/*
+ * 3021: BOs closed while their last submission is still on the ring. Turnip lists every BO of the device in every
+ * submission, so nearly every close saw an unfinished fence and its caller, often the render thread, waited for the GPU.
+ * Turnip closes only what the GPU no longer needs, but freeing pages the GPU can still write would corrupt the kernel:
+ * the pages and the GPU mapping stay here until the fence has passed, as Linux's msm keeps them until it retires the
+ * submission. Reaped at GEM_NEW, GEM_CLOSE and submit (lock held). A GPU recovery advances the fence past everything
+ * lost; a lost GPU never reaps, which leaks them as releaseGem always did.
+ */
+struct sweet_gem_zombie {
+	struct sweet_gem_zombie *next;
+	IOMemoryDescriptor      *md;
+	SweetSurface            *surface;
+	uint64_t                 iova, mapped, vaLen;
+	uint32_t                 fence;
+};
+static struct sweet_gem_zombie *gGemZombies;
+
+static void
+sweet_gem_reap(void)
+{
+	struct sweet_gem_zombie **p = &gGemZombies, *z;
+
+	if (!sweet_gpu_ready()) {
+		return;
+	}
+	while ((z = *p) != NULL) {
+		if (!sweet_gpu_fence_done(z->fence)) {
+			p = &z->next;
+			continue;
+		}
+		*p = z->next;
+		sweet_gpu_vm_unmap(z->iova, z->mapped);
+		sweet_gpu_iova_free(z->iova, z->vaLen);
+		OSSafeReleaseNULL(z->md);
+		if (z->surface != NULL) {
+			z->surface->release();
+		}
+		IOFreeData(z, sizeof(*z));
+	}
+}
