--- a/bsd/conf/files
+++ b/bsd/conf/files
@@ -120,6 +120,7 @@ bsd/dev/sweet_a630_pas.c			standard
 bsd/dev/beryllium_wlan.c		standard
 bsd/dev/dipper_audio.c		standard
 bsd/dev/dipper_haptics.c	standard
