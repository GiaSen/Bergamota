+#define CC_MCLK_CMD(n)  (0x4004u + 0x20u * (n))
+#define CC_MCLK_CBCR(n) (0x401cu + 0x20u * (n))
+
+static void
+xpin_out(struct cam_pin *pp, bool high)
+{
+	if (pp->gpio == NOPIN) {
+		return;
+	}
+	vm_offset_t b = pin_base(pp->tile, pp->gpio);
+	cam_wr(b, 4, high ? 2u : 0u);
+	cam_wr(b, 0, PIN_CFG(0, PULL_NONE, 2, 1));
+}
+
+/*
+ * MCLKn on or off; true on success. xo: 19.2 MHz straight from XO (CFG 0, as the C2 probe of the main sensor: no PLL
+ * needed, enough for its registers); else 24 MHz as MCLK0 streams (PLL2 even 480 MHz / 10, M/N 1/2: PLL2 must run)
+ */
+static bool
+mclk_set(unsigned n, bool on, bool xo)
+{
+	uint32_t cmd = CC_MCLK_CMD(n), cbcr = CC_MCLK_CBCR(n);
+	if (!on) {
+		cam_wr(camcc, cbcr, cam_rd(camcc, cbcr) & ~CBCR_ENABLE);
+		(void)wait_set(camcc, cbcr, CBCR_OFF, 500);
+		cam_wr(camcc, cmd + 4, 0);
+		cam_wr(camcc, cmd, cam_rd(camcc, cmd) | RCG_UPDATE);
+		(void)wait_clear(camcc, cmd, RCG_UPDATE, 1000);
+		return true;
+	}
+	if (xo) {
+		cam_wr(camcc, cmd + 4, 0);
+	} else {
+		cam_wr(camcc, cmd + 8, 1);                      /* M */
+		cam_wr(camcc, cmd + 0xc, ~(2u - 1u) & 0xffu);   /* N */
+		cam_wr(camcc, cmd + 0x10, ~2u & 0xffu);         /* D */
+		cam_wr(camcc, cmd + 4, 19u | 1u << 8 | 2u << 12);
+	}
+	cam_wr(camcc, cmd, cam_rd(camcc, cmd) | RCG_UPDATE);
+	if (!wait_clear(camcc, cmd, RCG_UPDATE, 1000)) {
+		cam_say("MCLK%u generator did not update (CMD %#x)", n, cam_rd(camcc, cmd));
+		return false;
+	}
+	cam_wr(camcc, cbcr, cam_rd(camcc, cbcr) | CBCR_ENABLE);
+	if (!wait_clear(camcc, cbcr, CBCR_OFF, 1000)) {
+		cam_say("MCLK%u branch did not start (CBCR %#x)", n, cam_rd(camcc, cbcr));
+		return false;
+	}
+	return true;
+}
