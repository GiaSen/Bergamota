+/* 3090: one of the other sensors up for a run (as cam_probe, MCLK 24 MHz from PLL2, the bus left selected) and down */
+struct x_state { bool powered, mclk_on, pmg_set; uint8_t pmg[7]; };
+
+static bool
+x_up(struct cam_sensor_desc *sd, struct x_state *st)
+{
+	struct cam_pin *pp = sd->pins;
+	static const uint16_t gpio_offs[] = { 0x05, 0x40, 0x41, 0x42, 0x44, 0x45, 0x46 };
+	uint8_t bob = 0;
+
+	if (sweet_spmi_read(3, 0xa008u, &bob) != 0 || !(bob & 0x80)) {
+		cam_say("PMI8998 BOB not ready (STATUS1 %#x): %s not powered", bob, sd->name);
+		return false;
+	}
+	if (sd->pm_vdig_gpio) {
+		pm_regs("PM8998 VDIG GPIO (subtype, mode, vin, pull, out src, out ctl, en)", 0xc000u + 0x100u * (sd->pm_vdig_gpio - 1),
+		    gpio_offs, 7, st->pmg);
+	}
+	for (unsigned i = 0; i < X_COUNT; i++) {
+		if (pp[i].gpio == NOPIN) {
+			continue;
+		}
+		vm_offset_t b = pin_base(pp[i].tile, pp[i].gpio);
+		if (!b) {
+			cam_say("TLMM not mapped");
+			return false;
+		}
+		pp[i].cfg = cam_rd(b, 0);
+		pp[i].io = cam_rd(b, 4);
+		pp[i].saved = true;
+		unsigned fn = (pp[i].cfg >> 2) & 0xfu;
+		if (fn != 0 && !((i == X_SDA || i == X_SCL || i == X_MCLK) && fn == 1)) {
+			cam_say("pin %u is set to function %u: %s not powered", pp[i].gpio, fn, sd->name);
+			return false;
+		}
+	}
+	xpin_out(&pp[X_RESET], false);
+	xpin_out(&pp[X_VANA], false);
+	st->powered = true;
+	xpin_out(&pp[X_VANA], true);
+	delay(1000);
+	xpin_out(&pp[X_LDO_VIO], true);
+	xpin_out(&pp[X_VIO], true);
+	delay(1000);
+	xpin_out(&pp[X_LDO_VDIG], true);
+	xpin_out(&pp[X_VDIG], true);
+	if (sd->pm_vdig_gpio && (st->pmg[0] == 0x10 || st->pmg[0] == 0x11)) {
+		uint8_t m = 0x01, o = 0x80;
+		unsigned base = 0xc000u + 0x100u * (sd->pm_vdig_gpio - 1);
+		st->pmg_set = sweet_spmi_write(0, base + 0x44, &o, 1) == 0 && sweet_spmi_write(0, base + 0x40, &m, 1) == 0;
+	}
+	delay(1000);
+	xpin_out(&pp[X_RESET], true);
+	delay(12000);
+	if (!(st->mclk_on = mclk_set(sd->mclk, true, false))) {
+		return false;
+	}
+	cam_wr(pin_base(pp[X_MCLK].tile, pp[X_MCLK].gpio), 0, PIN_CFG(1, PULL_NONE, 4, 0));
+	cam_say("%s powered; MCLK%u 24 MHz%s", sd->name, sd->mclk, sd->pm_vdig_gpio ? (st->pmg_set ? ", PM8998 VDIG switch on" :
+	    ", PM8998 VDIG switch NOT set") : "");
+	delay(10000);
+	i2c_bus_sda = &pp[X_SDA];
+	i2c_bus_scl = &pp[X_SCL];
+	i2c_line(P_SCL, true);
+	i2c_line(P_SDA, true);
+	delay(100);
+	return true;
+}
+
+static void
+x_down(struct cam_sensor_desc *sd, struct x_state *st)
+{
+	struct cam_pin *pp = sd->pins;
+
+	if (st->powered) {
+		xpin_out(&pp[X_RESET], false);
+		delay(1000);
+	}
+	if (st->mclk_on) {
+		(void)mclk_set(sd->mclk, false, false);
+	}
+	if (st->powered) {
+		if (st->pmg_set) {
+			unsigned base = 0xc000u + 0x100u * (sd->pm_vdig_gpio - 1);
+			(void)sweet_spmi_write(0, base + 0x40, &st->pmg[1], 1);
+			(void)sweet_spmi_write(0, base + 0x44, &st->pmg[4], 1);
+		}
+		xpin_out(&pp[X_VAF], false);
+		xpin_out(&pp[X_VDIG], false);
+		xpin_out(&pp[X_LDO_VDIG], false);
+		delay(1000);
+		xpin_out(&pp[X_VIO], false);
+		xpin_out(&pp[X_LDO_VIO], false);
+		delay(1000);
+		xpin_out(&pp[X_VANA], false);
+		delay(1000);
+	}
+	for (unsigned i = 0; i < X_COUNT; i++) {
+		if (!pp[i].saved) {
+			continue;
+		}
+		vm_offset_t b = pin_base(pp[i].tile, pp[i].gpio);
+		cam_wr(b, 4, pp[i].io & 2u);
+		cam_wr(b, 0, pp[i].cfg);
+		pp[i].saved = false;
+	}
+	i2c_bus_sda = &c2_pins[P_SDA];
+	i2c_bus_scl = &c2_pins[P_SCL];
 }
 
