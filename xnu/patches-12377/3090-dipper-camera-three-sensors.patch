+/* 3090: the analog gain register code of a gain x 256, and back: Sony 512 - 512 / gain, SMIA (Samsung) gain x 32 */
+static unsigned
+again_code(uint64_t ag)
+{
+	if (CP->smia_gain) {
+		return ag < 256u ? 32u : (unsigned)(ag / 8u);
+	}
+	return 512u - (unsigned)(512u * 256u / ag);
+}
+
+static uint64_t
+again_x256(unsigned code)
+{
+	return CP->smia_gain ? (uint64_t)code * 8u : 512ull * 256u / (512u - code);
+}
