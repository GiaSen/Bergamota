+/*
+ * 3111: the display engine's clocks behind a sleeping panel. Nothing here ever switched off what the bootloader
+ * switched on: with the panel asleep (3107) the DSI link's PLL and its byte, pixel and escape clocks, the display
+ * engine's core, LUT, rotator and vsync clocks and its memory bus clock all kept running. kern.sweet_fb_clk_gate is a
+ * mask of what to stop once the display is off, dark and the panel asleep for two slow ticks: 1 the link's branches,
+ * 2 the link's PLL (only with 1), 4 the engine's clocks, 8 its bus clock. Only branches that were on are stopped, and
+ * exactly those come back, in the opposite order, before the display is "on" again for anybody: in the power request
+ * itself, under the lock. The register clock (AHB) and the power domain stay, so every setting keeps its value. While
+ * the clocks are away nothing touches the engine or the link: with the display off the swap paths do not (they test
+ * fPowerOff), dsiTick returns at once, and the panic hook leaves the scan-out alone. Order and registers as the vendor
+ * kernel's (clk/qcom/dispcc-sdm845.c; mdss-dsi-pll-10nm.c dsi_pll_disable / dsi_pll_enable: the PLL's output gated
+ * first, then the PLL, its buffer and bias; back: bias, start, wait for the lock, output, buffer). The link's lanes rest
+ * in LP-11 throughout (the panel's device tree does not force the clock lane to high speed).
+ */
+static const uint16_t kClkLink[] = { 0x2028, 0x202c, 0x2004, 0x2038 };  /* byte0, byte0_intf, pclk0, esc0 */
+static const uint16_t kClkMdp[] = { 0x200c, 0x201c, 0x2014, 0x2024 };   /* mdp, mdp_lut, rot, vsync */
+static const uint16_t kClkAxi[] = { 0x4008 };
+#define SWEET_CLK_GROUPS 3
+static const struct {
+	const uint16_t *off;
+	unsigned n, bit;
+} kClkGroup[SWEET_CLK_GROUPS] = {
+	{ kClkLink, 4, 1 }, { kClkMdp, 4, 4 }, { kClkAxi, 1, 8 },
+};
+
+/* A branch on or off, then its status (bit 31: the clock is off) for up to a millisecond */
+bool
+AppleCLCD::clkBranch(uint32_t off, bool on)
+{
+	uint32_t v = mdp_rd(fDispcc, off);
+	mdp_wr(fDispcc, off, on ? (v | 1u) : (v & ~1u));
+	__asm__ volatile ("dsb osh" ::: "memory");
+	for (int i = 0; i < 100; i++) {
+		if (((mdp_rd(fDispcc, off) >> 31) != 0) != on) {
+			return true;
+		}
+		IODelay(10);
+	}
+	sweet_fb_clk_fails++;
+	if (fClkLogged++ < 16) {
+		IOLog("SWEET FB: clock branch 0x%x did not go %s: 0x%08x\n", off, on ? "on" : "off", mdp_rd(fDispcc, off));
+	}
+	return false;
+}
+
+/* with fLock held; the panel asleep and no command in flight (gate), or about to wake (ungate) */
+void
+AppleCLCD::clkGate(bool gate)
+{
+	if (fDispcc == 0 || fDsiPhy == 0 || gate == fClkGated) {
+		return;
+	}
+	if (gate) {
+		uint32_t mask = (uint32_t)sweet_fb_clk_gate & 0xfu, was = 0;
+		for (unsigned g = 0, b = 0; g < SWEET_CLK_GROUPS; g++) {
+			for (unsigned i = 0; i < kClkGroup[g].n; i++, b++) {
+				if ((mask & kClkGroup[g].bit) && (mdp_rd(fDispcc, kClkGroup[g].off[i]) & 1u)) {
+					was |= 1u << b;
+				}
+			}
+		}
+		fClkMask = mask;
+		fClkWasOn = was;
+		fClkGated = true;
+		__atomic_store_n(&sweet_fb_clk_gated, (int)mask, __ATOMIC_RELEASE);
+		for (unsigned i = 0; i < 4; i++) {
+			if (was & (1u << i)) {
+				(void)clkBranch(kClkLink[i], false);
+			}
+		}
+		fClkPllWasOn = (mask & 3u) == 3u && (mdp_rd(fDsiPhy, DSIPHY_CMN_PLL_CNTRL) & 1u) != 0;
+		if (fClkPllWasOn) {
+			fClkRbuf = mdp_rd(fDsiPhy, DSIPHY_CMN_RBUF_CTRL);
+			fClkMuxes = mdp_rd(fDsiPhy, DSIPLL_SYSTEM_MUXES);
+			mdp_wr(fDsiPhy, DSIPHY_CMN_CLK_CFG1, mdp_rd(fDsiPhy, DSIPHY_CMN_CLK_CFG1) & ~(1u << 5));
+			mdp_wr(fDsiPhy, DSIPHY_CMN_PLL_CNTRL, 0);
+			mdp_wr(fDsiPhy, DSIPHY_CMN_RBUF_CTRL, 0);
+			mdp_wr(fDsiPhy, DSIPLL_SYSTEM_MUXES, 0);
+			mdp_wr(fDsiPhy, DSIPHY_CMN_CTRL_0, mdp_rd(fDsiPhy, DSIPHY_CMN_CTRL_0) & ~(1u << 5));
+			__asm__ volatile ("dsb osh" ::: "memory");
+		}
+		for (unsigned i = 0; i < 5; i++) {
+			if (was & (1u << (4 + i))) {
+				(void)clkBranch(i < 4 ? kClkMdp[i] : kClkAxi[0], false);
+			}
+		}
+		sweet_fb_clk_gates++;
+		sweet_fb_clk_was = (int)(was | (fClkPllWasOn ? 0x1000u : 0));
+		if (fClkLogged++ < 16) {
+			IOLog("SWEET FB: display clocks stopped: mask 0x%x, branches that were on 0x%x, DSI PLL %s\n", mask, was,
+			    fClkPllWasOn ? "stopped" : "left");
+		}
+		return;
+	}
+	uint32_t was = fClkWasOn;
+	for (int i = 4; i >= 0; i--) {
+		if (was & (1u << (4 + i))) {
+			(void)clkBranch(i < 4 ? kClkMdp[i] : kClkAxi[0], true);
+		}
+	}
+	if (fClkPllWasOn) {
+		mdp_wr(fDsiPhy, DSIPHY_CMN_CTRL_0, mdp_rd(fDsiPhy, DSIPHY_CMN_CTRL_0) | (1u << 5));
+		mdp_wr(fDsiPhy, DSIPLL_SYSTEM_MUXES, fClkMuxes);
+		__asm__ volatile ("dsb osh" ::: "memory");
+		IODelay(1);
+		mdp_wr(fDsiPhy, DSIPHY_CMN_PLL_CNTRL, 1);
+		__asm__ volatile ("dsb osh" ::: "memory");
+		int us = 0;
+		while (!(mdp_rd(fDsiPhy, DSIPLL_COMMON_STATUS_ONE) & 1u) && us < 10000) {
+			IODelay(50);
+			us += 50;
+		}
+		sweet_fb_clk_lock_us = us;
+		if (us >= 10000) {
+			sweet_fb_clk_fails++;
+			IOLog("SWEET FB: the DSI PLL did not lock in 10 ms: status 0x%x\n", mdp_rd(fDsiPhy, DSIPLL_COMMON_STATUS_ONE));
+		}
+		mdp_wr(fDsiPhy, DSIPHY_CMN_CLK_CFG1, mdp_rd(fDsiPhy, DSIPHY_CMN_CLK_CFG1) | (1u << 5));
+		mdp_wr(fDsiPhy, DSIPHY_CMN_RBUF_CTRL, fClkRbuf);
+		__asm__ volatile ("dsb osh" ::: "memory");
+	}
+	for (int i = 3; i >= 0; i--) {
+		if (was & (1u << i)) {
+			(void)clkBranch(kClkLink[i], true);
+		}
+	}
+	fClkGated = false;
+	fClkIdleTicks = 0;
+	__atomic_store_n(&sweet_fb_clk_gated, 0, __ATOMIC_RELEASE);
+	if (fClkLogged++ < 16) {
+		IOLog("SWEET FB: display clocks back (PLL lock after %d us)\n", sweet_fb_clk_lock_us);
+	}
+}
+
+/* from the vsync timer's slow tick with the display off, fLock held */
+void
+AppleCLCD::clkPolicy(bool dark)
+{
+	if (fDispcc == 0 || fDsiPhy == 0) {
+		return;
+	}
+	uint32_t want = (uint32_t)sweet_fb_clk_gate & 0xfu;
+	bool hand = __atomic_load_n(&sweet_fb_dcs, __ATOMIC_RELAXED) != 0 || __atomic_load_n(&sweet_fb_dcs_long_n, __ATOMIC_RELAXED) != 0;
+	bool can = fPowerOff && dark && fPanelState == 2 && !fDsiBusy && !hand;
+	if (fClkGated) {
+		if (want != fClkMask || hand) {
+			clkGate(false);         /* the switch changed, or a command by hand waits */
+		}
+		return;
+	}
+	if (!can || want == 0) {
+		fClkIdleTicks = 0;
+	} else if (++fClkIdleTicks >= 2) {
+		clkGate(true);
+	}
 }
 
