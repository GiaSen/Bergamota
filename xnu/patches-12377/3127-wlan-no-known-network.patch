+/*
+ * 3127: what iOS asks of the Wi-Fi interface, in numbers. kern.sweet_80211_scan: scan requests by type and by how they were
+ * answered, and the last 128 as ms since boot : type : how : scan type : dwell : channels asked : channels kept : names : flags
+ * (how 0 = a scan by the service, 1 = its cache because the last scan is recent, 2 = no service, joining or joined: the cache
+ * after 300 ms). kern.sweet_80211_scan_dump=N prints a line for each of the next N requests (channels, no names);
+ * kern.sweet_80211_scan_raw=N prints the next N requests' non-zero 32-bit words (they hold network names: for the console
+ * only). kern.sweet_80211_types: every ioctl type seen with its count.
+ */
+#define S8_SCAN_RING 128u
+#define S8_SCAN_REQ_LEN 0x1598u         /* apple80211_scan_data, IO80211 1565.3 (sweet_wlan.h) */
+static struct {
+	uint32_t t10, t86, how[3], ring_n;
+	struct {
+		uint32_t ms;
+		uint16_t dwell, nasked, flags;
+		uint8_t type, how, scan_type, nchan, nssid;
+	} ring[S8_SCAN_RING];
+	uint16_t set_n[IOC_MAX], get_n[IOC_MAX];
+} s8stat;
+static int s8_scan_dump, s8_scan_raw;
+SYSCTL_INT(_kern, OID_AUTO, sweet_80211_scan_dump, CTLFLAG_RW | CTLFLAG_LOCKED, &s8_scan_dump, 0,
+    "print a line for each of the next N scan requests: type, dwell, channels (3127)");
+SYSCTL_INT(_kern, OID_AUTO, sweet_80211_scan_raw, CTLFLAG_RW | CTLFLAG_LOCKED, &s8_scan_raw, 0,
+    "print the next N scan requests' non-zero words to the console; they hold network names (3127)");
+
+/* the request as user space wrote it (whole words, at most S8_SCAN_REQ_LEN), and what the service needs of it */
+static uint32_t *
+s8_scan_parse(const struct sweet80211_req *req, struct sweet_wlan_scan_req *sr, uint32_t *rawn)
+{
+	uint32_t n = MIN(req->len, S8_SCAN_REQ_LEN) & ~3u;
+	*rawn = 0;
+	if (req->data == 0 || n < 0x48) {
+		return NULL;
+	}
+	uint32_t *w = kalloc_data(n, Z_WAITOK | Z_ZERO);
+	if (w == NULL) {
+		return NULL;
+	}
+	if (copyin((user_addr_t)req->data, w, n) != 0) {
+		kfree_data(w, n);
+		return NULL;
+	}
+	*rawn = n;
+	if (req->type != IOC_SCAN_REQ || n < S8_SCAN_REQ_LEN || w[0] != 1) {
+		return w;
+	}
+	const uint8_t *b = (const uint8_t *)w;
+	sr->scan_type = (uint8_t)w[0x34 / 4];
+	memcpy(&sr->dwell_ms, b + 0x3c, 2);
+	sr->nchan_asked = (uint16_t)MIN(w[0x44 / 4], 400u);
+	for (uint32_t k = 0; k < sr->nchan_asked && sr->nchan < SWEET_WLAN_REQ_CHANS; k++) {
+		uint32_t ch = w[(0x48 + 12 * k) / 4 + 1], fl = w[(0x48 + 12 * k) / 4 + 2];
+		if ((fl & 0x2000) || ch == 0 || ch > 196) {
+			continue;                       /* 6 GHz: not this radio */
+		}
+		sr->mhz[sr->nchan++] = (uint16_t)(ch == 14 ? 2484 : (ch < 14 && !(fl & C_FLAG_5GHZ)) ? 2407 + 5 * ch : 5000 + 5 * ch);
+	}
+	sr->flags = w[0x1308 / 4];
+	uint32_t l = w[0x10 / 4];
+	if (l >= 1 && l <= 32) {
+		sr->ssid[0].len = (uint8_t)l;
+		memcpy(sr->ssid[0].ssid, b + 0x14, l);
+		sr->nssid = 1;
+	}
+	uint32_t cnt = MIN(w[0x1314 / 4], 10u);
+	for (uint32_t k = 0; k < cnt; k++) {
+		const uint8_t *e = b + 0x1318 + 56 * k;
+		uint32_t el;
+		memcpy(&el, e + 4, 4);
+		if (el < 1 || el > 32) {
+			continue;
+		}
+		if (sr->nssid < SWEET_WLAN_REQ_SSIDS) {
+			sr->ssid[sr->nssid].len = (uint8_t)el;
+			memcpy(sr->ssid[sr->nssid].ssid, e + 8, el);
+		}
+		sr->nssid++;
+	}
+	sr->parsed = 1;
+	return w;
+}
