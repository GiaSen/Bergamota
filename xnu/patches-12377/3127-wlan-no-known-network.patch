+	s8stat.ring[i].scan_type = sr ? sr->scan_type : 0;
+	s8stat.ring[i].dwell = sr ? sr->dwell_ms : 0;
+	s8stat.ring[i].nasked = sr && sr->parsed ? sr->nchan_asked : 0xffff;
+	s8stat.ring[i].nchan = sr ? (uint8_t)sr->nchan : 0;
+	s8stat.ring[i].nssid = sr ? sr->nssid : 0;
+	s8stat.ring[i].flags = sr ? (uint16_t)sr->flags : 0;
+	if (req->type == IOC_SCAN_REQ) {
+		s8stat.t10++;
+	} else {
+		s8stat.t86++;
