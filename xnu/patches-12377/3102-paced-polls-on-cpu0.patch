@@ -624,7 +624,9 @@ cf_thread(void *arg __unused, wait_result_t wr __unused)
 		(void)cf_cluster_load(&cf_dom[i], 1);   /* prime prev_idle */
 	}
 	for (;;) {
+		static bool cf_bound;
 		unsigned off_ms = cf_off_ms;
+		sweet_poll_bind(&cf_bound);
 		if (off_ms >= period && off_ms <= 2000 && sweet_paced()) {
 			static int off_chan;
 			(void)assert_wait_deadline(&off_chan, THREAD_UNINT, sweet_poll_deadline_us((uint64_t)off_ms * 1000, true));
@@ -1166,6 +1168,23 @@ SYSCTL_UINT(_kern, OID_AUTO, sweet_cpufreq_off_ms, CTLFLAG_RW | CTLFLAG_LOCKED,
 SYSCTL_UINT(_kern, OID_AUTO, sweet_pace, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_pace, 0,
     "screen-off pacing of the drivers' polls: 1 on, 0 every period as with the display on (3101)");
 
+/* 3102: see sweet_board.h */
+static unsigned sweet_poll_cpu0 = 1;
+SYSCTL_UINT(_kern, OID_AUTO, sweet_poll_cpu0, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_poll_cpu0, 0,
+    "paced polling threads stay on CPU 0 (3102)");
+extern processor_t cpu_to_processor(int cpu);
+extern processor_t thread_bind(processor_t processor);
+
+void
+sweet_poll_bind(bool *bound)
+{
+	bool want = sweet_poll_cpu0 != 0 && sweet_paced();
+	if (want != *bound) {
+		*bound = want;
+		(void)thread_bind(want ? cpu_to_processor(0) : PROCESSOR_NULL);         /* takes effect at the next block */
+	}
+}
+
