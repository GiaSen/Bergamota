diff --git a/bsd/dev/sweet_board.h b/bsd/dev/sweet_board.h
index 76c8c28..c29b17b 100644
--- a/bsd/dev/sweet_board.h
+++ b/bsd/dev/sweet_board.h
@@ -92,6 +92,14 @@ extern int sweet_fb_display_off;        /* bsd/dev/sweet_fb.c */
 extern unsigned sweet_pace;             /* bsd/dev/sweet_cpufreq.c */
 extern uint64_t sweet_poll_grid_abs;    /* the grid in timebase ticks; 0: none */
 extern void clock_interval_to_deadline(uint32_t interval, uint32_t scale_factor, uint64_t *result);
+/*
+ * 3102: a polling thread stays on CPU 0 while the display is off and paced (bsd/dev/sweet_cpufreq.c). A poll whose
+ * timer fires on one core and whose thread then runs on another wakes two cores, and a third when the core it ran on
+ * tells CPU 0 its next deadline; on CPU 0 it is one wake-up, on the core that is the others' timer anyway, and the
+ * other seven stay down. Call it in the thread's loop before its wait with a flag of the thread's own; the move
+ * happens at that wait. kern.sweet_poll_cpu0=0 leaves the threads where the scheduler puts them.
+ */
+extern void sweet_poll_bind(bool *bound);
 #ifdef __cplusplus
 }
 #endif
