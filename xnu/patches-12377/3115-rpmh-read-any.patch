+/* 3115: kern.sweet_rpmh_db: the command database's names and addresses, one kind at a time; reads memory only */
+static unsigned rh_db_kind = RH_ARC;
+
+static int
+sysctl_sweet_rpmh_db SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2)
+	if (req->newptr) {
+		char in[8] = "";
+		int error = sysctl_handle_string(oidp, in, sizeof(in), req);
+		if (error) {
+			return error;
+		}
+		unsigned kind = !strcmp(in, "arc") ? RH_ARC : !strcmp(in, "vrm") ? RH_VRM : !strcmp(in, "bcm") ? RH_BCM : 0;
+		if (kind == 0) {
+			return EINVAL;
+		}
+		rh_db_kind = kind;
+		return 0;
+	}
+	static char buf[3072];
+	size_t n = 0;
+	if (!rh_rsc || !rh_tcs || !rh_be) {
+		return ENXIO;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = rh_map();
+	unsigned kind = rh_db_kind;
+	n += (size_t)snprintf(buf + n, sizeof(buf) - n, "sweet_rpmh_db v1 %s:", kind == RH_ARC ? "arc" : kind == RH_VRM ? "vrm" : "bcm");
+	for (unsigned i = 0; !error && i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		unsigned count = rh_db16(h + 6);
+		if (slave < 3 || slave > 5 || (entries & 3u) || !rh_range(entries, count * RH_DB_ENTRY)) {
+			error = EINVAL;
+			break;
+		}
+		if (slave != kind) {
+			continue;
+		}
+		for (unsigned j = 0; j < count && n + 24 < sizeof(buf); ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			uint32_t w[2] = { rh_read(rh_db, e), rh_read(rh_db, e + 4) };
+			char nm[9];
+			for (unsigned c = 0; c < 8; c++) {
+				char ch = (char)(w[c / 4] >> (8u * (c % 4)));
+				nm[c] = (ch == 0 || (ch > 32 && ch < 127)) ? ch : '?';
+			}
+			nm[8] = 0;
+			n += (size_t)snprintf(buf + n, sizeof(buf) - n, " %s=%#x", nm, rh_read(rh_db, e + 16));
+		}
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	if (error) {
+		return error;
+	}
+	buf[sizeof(buf) - 1] = 0;
+	return SYSCTL_OUT(req, buf, strlen(buf) + 1);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_rpmh_db, CTLTYPE_STRING | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0, sysctl_sweet_rpmh_db, "A",
