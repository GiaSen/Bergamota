  * processor's own vote as the power controller holds it: the one thing that tells whether a sleep or wake set (3113)
  * was really sent, since those change the vote without the kernel asking. Whether the rails answer reads at all was not
  * known when this was written; a request that never finishes costs one of the two active TCSes until a reboot.
+ *
+ * 3115: any resource of the command database by its name, and "NAME+4", "+8", "+c" for a regulator's other
+ * registers (+0 the voltage, +4 enable, +8 mode, +c headroom, as the vendor's rpmh-regulator.c). For the inventory a
+ * system sleep needs: every vote standing in this processor's name, the bootloader's included, keeps its resource up
+ * while the cores are down unless the sleep set says otherwise. The rails answered reads (3114); regulators and bus
+ * votes had not been asked when this was written, and the same warning holds: two requests that never finish and this
+ * kernel can vote nothing more until a reboot. kern.sweet_rpmh_db lists the names: write arc, vrm or bcm, then read.
  */
-static char rh_read_text[96] = "sweet_rpmh_read v1 nothing read";
+static char rh_read_text[112] = "sweet_rpmh_read v2 nothing read";
+
+/* any entry by name, whatever its kind; with rh_map done */
+static int
+rh_lookup_any(const char *res, uint32_t *address)
+{
+	uint32_t key[2] = {0, 0};
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	unsigned matches = 0;
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		unsigned count = rh_db16(h + 6);
+		if (slave < 3 || slave > 5 || (entries & 3u) || !rh_range(entries, count * RH_DB_ENTRY)) {
+			return EINVAL;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t addr = rh_read(rh_db, e + 16);
+			if ((addr >> 16) != slave) {
+				return EINVAL;
+			}
+			*address = addr;
+			++matches;
+		}
+	}
+	return matches == 1 ? 0 : ENODEV;
+}
 
