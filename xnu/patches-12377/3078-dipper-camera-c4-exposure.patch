+/* the exposure into the sensor under group hold: frame length 0x0340, integration 0x0202, analog gain 0x0204, the four
+ * digital gains 0x020e-0x0215 */
+static bool
+s0_set_exposure(const struct cam_exp *a)
+{
+	uint8_t hold = 1, release = 0;
+	const uint8_t f[2] = { (uint8_t)(a->fll >> 8), (uint8_t)a->fll };
+	const uint8_t e[4] = { (uint8_t)(a->lines >> 8), (uint8_t)a->lines, (uint8_t)(a->acode >> 8), (uint8_t)a->acode };
+	const uint8_t d[8] = { (uint8_t)(a->dgain >> 8), (uint8_t)a->dgain, (uint8_t)(a->dgain >> 8), (uint8_t)a->dgain,
+		               (uint8_t)(a->dgain >> 8), (uint8_t)a->dgain, (uint8_t)(a->dgain >> 8), (uint8_t)a->dgain };
+	bool ok = i2c_write(0x34, 0x0104, &hold, 1) && i2c_write(0x34, 0x0340, f, 2) && i2c_write(0x34, 0x0202, e, 4) &&
+	    i2c_write(0x34, 0x020e, d, 8);
+	(void)i2c_write(0x34, 0x0104, &release, 1);
+	return ok;
+}
+
+static uint64_t
+c4_ns(uint64_t abs)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(abs, &ns);
+	return ns;
+}
