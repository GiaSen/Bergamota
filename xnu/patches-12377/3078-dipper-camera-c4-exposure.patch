+/*
+ * 3078: auto exposure. The meter: green pixels (RGGB: the odd pixels of even lines, the even pixels of odd lines), their
+ * 8 high bits x 4 less the black level, on every 16th line pair, every other 4-pixel group; saturated = high byte >= 0xfc.
+ */
+static void
+c4_meter(const uint8_t *f, unsigned *mean, unsigned *sat_pm)
+{
+	uint64_t sum = 0;
+	unsigned n = 0, sat = 0;
+
+	for (unsigned y = 0; y + 1 < C4_H; y += 16) {
+		const uint8_t *r0 = f + (size_t)y * C4_STRIDE, *r1 = r0 + C4_STRIDE;
+		sweet_dma_sync_va(r0, 2 * C4_STRIDE);
+		for (unsigned g = 0; g < C4_W / 4; g += 2) {
+			const unsigned v[4] = { r0[5 * g + 1], r0[5 * g + 3], r1[5 * g], r1[5 * g + 2] };
+			for (unsigned k = 0; k < 4; k++) {
+				unsigned p = v[k] * 4u;
+				sum += p > 64u ? p - 64u : 0u;
+				sat += v[k] >= 0xfcu;
+				n++;
+			}
+		}
+	}
+	*mean = n ? (unsigned)(sum / n) : 0;
+	*sat_pm = n ? sat * 1000u / n : 0;
+}
+
+/* a total exposure (lines x gain x 256) as integration lines (frame length stretched up to C4_FLL_MAX), then analog
+ * gain up to 16x, then digital gain up to 4x; e256 = what that gives */
+static void
+c4_exp_split(uint64_t e256, unsigned fll_mode, struct cam_exp *a)
+{
+	uint64_t lmax = C4_FLL_MAX - C4_MARGIN, l = e256 / 256;
+
+	if (l < 4) {
+		l = 4;
+	}
+	if (l > lmax) {
+		l = lmax;
+	}
+	uint64_t g = e256 / l;                                  /* total gain x 256 */
+	if (g < 256) {
+		g = 256;
+	}
+	uint64_t ag = g > 16u * 256u ? 16u * 256u : g;
+	unsigned code = 512u - (unsigned)(512u * 256u / ag);
+	if (code > C4_AGAIN_MAX) {
+		code = C4_AGAIN_MAX;
+	}
+	uint64_t ag_real = 512ull * 256u / (512u - code);       /* x 256 */
+	uint64_t dg = g * 256u / ag_real;                       /* 8.8 */
+	if (dg < 0x100u) {
+		dg = 0x100u;
+	}
+	if (dg > C4_DGAIN_MAX) {
+		dg = C4_DGAIN_MAX;
+	}
+	a->lines = (unsigned)l;
+	a->fll = (unsigned)l + C4_MARGIN > fll_mode ? (unsigned)l + C4_MARGIN : fll_mode;
+	a->acode = code;
+	a->dgain = (unsigned)dg;
+	a->e256 = l * ag_real * dg / 256u;
+}
