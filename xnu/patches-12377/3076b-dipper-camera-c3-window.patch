diff --git a/bsd/dev/sweet_smmu.c b/bsd/dev/sweet_smmu.c
index 163aa5c..be0dfea 100644
--- a/bsd/dev/sweet_smmu.c
+++ b/bsd/dev/sweet_smmu.c
@@ -286,6 +286,56 @@ out:
 	return error;
 }
 
+/*
+ * 3076b: a 32-bit window for masters whose address registers have 32 bits (the camera IFE's write masters) when their
+ * buffer is above 4 GiB (this kernel's memory is): the second GiB of IOVA space (0x40000000-0x7fffffff, below DRAM, so
+ * unused by the identity map) becomes one 1 GiB block onto the DRAM GiB that holds pa (Normal NC, RW), in the shared bank
+ * (and the IPA's, which reads the same tables). *iova is pa's address in the window. One window: a later call for another
+ * GiB moves it. Needs the bank (a sweet_smmu_map_sid() first).
+ */
+int sweet_smmu_window32(uint64_t pa, uint32_t *iova);
+int
+sweet_smmu_window32(uint64_t pa, uint32_t *iova)
+{
+	int error = 0;
+	uint64_t gib = pa >> 30;
+
+	if (gib < 2 || gib > 9 || !iova) {
+		return EINVAL;  /* only the identity map's DRAM, 0x80000000..0x27fffffff */
+	}
+	if (__atomic_exchange_n(&smmu_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	if (smmu_cb < 0 || smmu_base == 0 || smmu_l1v == 0) {
+		error = ENODEV;
+		goto out;
+	}
+	volatile uint64_t *l1 = (volatile uint64_t *)smmu_l1v;
+	l1[1] = gib << 30 | 1u << 10 | 2u << 8 | 1u << 6 | 1;  /* block, AF, OSH, RW, attr 0 (Normal NC) */
+	sweet_dma_sync_va((const void *)smmu_l1v, L1_SIZE);
+	{
+		uint32_t id1 = smmu_rd(0x24);
+		unsigned pgshift = (id1 >> 31) ? 16 : 12;
+		for (int b = 0; b < 2; b++) {
+			int bank = b ? smmu_cb2 : smmu_cb;
+			if (bank < 0) {
+				continue;
+			}
+			uint32_t cb = ((1u << (((id1 >> 28) & 7) + 1)) << pgshift) + ((uint32_t)bank << pgshift);
+			smmu_wr(cb + 0x618, 0);                 /* TLBIALL */
+			smmu_wr(cb + 0x7f0, 0);                 /* TLBSYNC */
+			for (int t = 0; t < 100000 && (smmu_rd(cb + 0x7f4) & 1); t++) {
+				delay(1);
+			}
+		}
+	}
+	*iova = 0x40000000u + (uint32_t)(pa & 0x3fffffffu);
+	printf("SWEET SMMU: bank %d: 32-bit window 0x40000000 -> DRAM GiB %#llx\n", smmu_cb, gib << 30);
+out:
+	__atomic_store_n(&smmu_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
