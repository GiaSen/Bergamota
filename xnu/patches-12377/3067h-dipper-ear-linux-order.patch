From ffa7db42b5fb78fc3b0720f864617e0b3247f5c9 Mon Sep 17 00:00:00 2001
From: Giammarco Senatore <giamma@wlan-114021.nbw.tue.nl>
Date: Fri, 6 Nov 2026 11:33:50 +0100
Subject: [PATCH] 3067h: the earpiece in the order of Xiaomi's kernel (RX0
 clocked and the channel up before the DSP port; ANA_BUCK_CTL; full teardown)

---
 bsd/dev/dipper_audio.c | 199 +++++++++++++++++++++++------------------
 1 file changed, 114 insertions(+), 85 deletions(-)

diff --git a/bsd/dev/dipper_audio.c b/bsd/dev/dipper_audio.c
index f335372..22b597e 100644
--- a/bsd/dev/dipper_audio.c
+++ b/bsd/dev/dipper_audio.c
@@ -3702,16 +3702,9 @@ cx_amic_off(void)
  * ---- 3067: the earpiece. Xiaomi's mixer_paths_overlay_static.xml (vendor /etc) redefines `handset` for the Mi 8:
  * SLIM RX0 (AIF1_PB) -> CDC_IF RX0 -> RX INT0_1 MIX1 INP0 = RX0 -> RX INT0 DEM MUX = CLSH_DSM_OUT -> EAR PA; the HAL
  * plays `handset` on SLIMBUS_0_RX (no backend entry). So the earpiece hangs on the WCD9340's EAR output.
- * Stage 10 (thread context, cx.busy held, codec up through stage 5):
- *   Android's defaults for this path (tavil_codec_reg_defaults / reg_init_common_val): RX0 DSMDEM_CTL bit 0, RX0 SEC0
- *   bit 3 clear, CLSH_DECAY_CTRL 0, CLSH_K2 0x060;
- *   SLIMbus: codec RX port 16 (RX0 = WCD934X_RX_START + 0: RX_PORT_MULTI_CHNL_0 0x180 = bit 0, RX_PORT_CFG 0x40 = 12-byte
- *   water mark + enable), AFE SLIMBUS_0_RX (0x4000) on shared channel 144 (= 144 + RX n, the machine driver's rx_ch),
- *   DEVICE_START, then the manager: CONNECT_SINK (0x2d: codec PGD, port 16, channel 144), DEF_ACT_CHAN, RECONFIG_NOW;
- *   RX INT0 (wcd934x.c / tavil): input RX0, 48 kHz, PGA muted, clock on, DEM = class-H DSM out (+ look-ahead delay),
- *   digital volume; RX bias; the EAR DAC's class-H (wcd-clsh-v2 state EAR, CLS_H_NORMAL): autochop timer off, CLSH
- *   CRC clock, RX0 class-H enable, VPOS/VNEG power level default, flyback on, flyback current 0xaa, buck on; EAR PA gain
- *   and enable, 5 ms, PGA unmuted, volume re-latched.
+ * Stage 10 (thread context, cx.busy held, codec up through stage 5) and stage 11 follow the order of Xiaomi's own
+ * kernel since 3067h (see cx_stage_ear): codec RX port 16 (RX0 = WCD934X_RX_START + 0), shared channel 144 (= 144 + RX n,
+ * the machine driver's rx_ch), AFE SLIMBUS_0_RX (0x4000) started last; class-H as wcd-clsh-v2 state EAR, CLS_H_NORMAL.
  * Gains: kern.sweet_ear_gain = (PA index << 8) | (uint8_t)RX0 dB; PA index 0 = +6 dB ... 4 = 0 dB, 5 = -2.5, 7 = -12;
  * RX0 volume signed dB (-84..+40). Default 0 dB / 0 dB.
  */
@@ -3755,6 +3748,15 @@ cx_codec_chain(void)
 	       (cx.la != 0xff && cx.la != 0 ? true : cx_stage_codec()) && (cx.mic_up || cx_stage_mic());
 }
 
+/*
+ * 3067h: stage 10 in the order Xiaomi's own kernel uses (TWRP 3.7.0_9, 4.9.151, dynamic debug of slim-msm-ngd.c and
+ * q6afe.c while the earpiece played, 2026-11-06; NOTES "EARPIECE REFERENCE"): the codec's RX0 path is clocked (still
+ * muted) and class-H is up BEFORE the channel exists; then the interface port, the manager's CONNECT_SINK, DEF_ACT_CHAN,
+ * RECONFIG_NOW; then the EAR PA, ~6 ms, unmute; and only then the DSP's AFE SLIMBUS_0_RX config and DEVICE_START (the
+ * player's ASM and ADM open after that). Up to 3067g the DSP port started first and the RX0 clock last: the codec's
+ * port 16 then overflowed for good. Also new from the reference: ANA_BUCK_CTL 0x0606 = 02, 03, 07 at stream start,
+ * interface 0x030 (RX port interrupt enable) = bit n before the port. The manager's bytes were already identical.
+ */
 static bool
 cx_stage_ear(void)
 {
@@ -3763,13 +3765,12 @@ cx_stage_ear(void)
 		CX_LOG("stage 10 needs stage 5 first\n");
 		return false;
 	}
-	CX_LOG("stage 10: earpiece: AFE SLIMBUS_0_RX -> channel %u -> codec RX0 (port %u) -> RX INT0 -> class-H -> EAR PA\n",
-	    CX_RX_CHAN, CX_RX_PORT);
-	CX_U(0x0b53, 0x01, 0x01);               /* CDC_RX0_RX_PATH_DSMDEM_CTL */
-	CX_U(0x0b49, 0x08, 0x00);               /* CDC_RX0_RX_PATH_SEC0 bit 3 */
-	CX_U(0x0c03, 0x03, 0x00);               /* CDC_CLSH_DECAY_CTRL */
-	CX_U(0x0c0a, 0x0f, 0x00);               /* CDC_CLSH_K2_MSB */
-	CX_W(0x0c0b, 0x60);                     /* CDC_CLSH_K2_LSB */
+	if (cx.ear_up) {
+		CX_LOG("stage 10: the earpiece is already up (stage 11 takes it down)\n");
+		return true;
+	}
+	CX_LOG("stage 10 (Linux order): codec RX0 (port %u) clocked, channel %u, EAR PA, then AFE SLIMBUS_0_RX\n",
+	    CX_RX_PORT, CX_RX_CHAN);
 	if (cx.la_if == 0xff) {
 		cx.la_if = cx_addr(cx_ifd_ea);
 		CX_LOG("codec interface device logical address %#x\n", cx.la_if);
@@ -3777,97 +3778,119 @@ cx_stage_ear(void)
 			return false;
 		}
 	}
-	if (!cx.ear_up) {
-		(void)cx_afe_slave_cfg();
-		cx.if_page = -1;
-		if (cx_if_wr((uint16_t)(0x140 + 4 * CX_RX_PORT), (uint8_t)(1u << cx_rx_n)) ||  /* RX_PORT_MULTI_CHNL_0: RX n */
-		    cx_if_wr((uint16_t)(0x30 + CX_RX_PORT), (2u << 1) | 1u)) {   /* RX_PORT_CFG: water mark, enable */
-			CX_LOG("interface RX port registers not written\n");
-			return false;
-		}
-		uint8_t a = 0, c = 0;
-		(void)cx_if_rd((uint16_t)(0x140 + 4 * CX_RX_PORT), &a);
-		(void)cx_if_rd((uint16_t)(0x30 + CX_RX_PORT), &c);
-		CX_LOG("interface: RX port %u multi-channel %02x, port cfg %02x\n", CX_RX_PORT, a, c);
-		struct {
-			uint32_t minor;
-			uint16_t dev, bits, fmt, chans;
-			uint8_t map[8];
-			uint32_t rate;
-		} __attribute__((packed)) sb = { 1, 0, 16, 0, 1, { CX_RX_CHAN }, AU_RATE };
-		lck_mtx_lock(&au_mtx);
-		r = afe_port_param(AFE_PORT_SLIMBUS_0_RX, AFE_MODULE_AUDIO_DEV_INTERFACE, AFE_PARAM_ID_SLIMBUS_CONFIG, &sb,
-		    sizeof(sb));
-		int st = r ? -1 : afe_port_cmd(AFE_PORT_SLIMBUS_0_RX, AFE_PORT_CMD_DEVICE_START);
-		lck_mtx_unlock(&au_mtx);
-		CX_LOG("AFE SLIMBUS_0_RX config -> %d, start -> %d\n", r, st);
-		if (r || st) {
-			return false;
-		}
-		uint8_t con[4] = { cx.la, CX_RX_PORT, CX_RX_CHAN, 0 };
-		r = cx_mgr_acked(0x2d, con, sizeof(con), 3);   /* SLIM_USR_MC_CONNECT_SINK: la, port, channel, tid */
-		CX_LOG("CONNECT_SINK -> %d\n", r);
-		if (r) {
-			return false;
-		}
-		uint8_t def[6] = { (uint8_t)(cx.la & 0x1f), (16 >> 2) | (1 << 5), (uint8_t)((2 << 4) | cx_rx_prot), cx_rx_prate, 0,
-			           (uint8_t)CX_RX_CHAN };
-		r = cx_mgr_acked(0x21, def, sizeof(def), 4);   /* SLIM_USR_MC_DEF_ACT_CHAN */
-		CX_LOG("DEF_ACT_CHAN (prot %u, presence %#x) -> %d\n", cx_rx_prot, cx_rx_prate, r);
-		if (r) {
-			return false;
-		}
-		uint8_t rec[2] = { 0, cx.la };
-		r = cx_mgr_acked(0x24, rec, sizeof(rec), 0);   /* SLIM_USR_MC_RECONFIG_NOW */
-		CX_LOG("RECONFIG_NOW -> %d\n", r);
-		if (r) {
-			return false;
-		}
-	}
-	/* RX INT0 */
+	(void)cx_afe_slave_cfg();
+	/* the path as Android's defaults and Xiaomi's `handset` leave it before a stream */
+	CX_U(0x0b53, 0x01, 0x01);               /* CDC_RX0_RX_PATH_DSMDEM_CTL */
+	CX_U(0x0b49, 0x08, 0x00);               /* CDC_RX0_RX_PATH_SEC0 bit 3 */
+	CX_U(0x0c03, 0x03, 0x00);               /* CDC_CLSH_DECAY_CTRL */
+	CX_U(0x0c0a, 0x0f, 0x00);               /* CDC_CLSH_K2_MSB */
+	CX_W(0x0c0b, 0x60);                     /* CDC_CLSH_K2_LSB */
+	CX_W(0x06c7, 0xaa);                     /* RX_BIAS_FLYB_BUFF (Linux reads aa) */
+	CX_U(0x073a, 0x02, 0x00);               /* HPH_NEW_INT_HPH_TIMER1: autochop timer off */
 	CX_U(0x0d01, 0x0f, (uint8_t)(0x05 + cx_rx_n));  /* CDC_RX_INP_MUX_RX_INT0_CFG0: INP0 = RX n (RX0 = 5) */
-	CX_U(0x0b41, 0x0f, 0x04);               /* CDC_RX0_RX_PATH_CTL: 48 kHz */
-	CX_U(0x0b41, 0x10, 0x10);               /* PGA muted while it starts */
-	CX_U(0x0b41, 0x20, 0x20);               /* interpolator clock */
 	CX_U(0x0b42, 0x08, 0x08);               /* CDC_RX0_RX_PATH_CFG0: look-ahead delay (DEM = class-H) */
 	CX_U(0x0b49, 0x01, 0x01);               /* CDC_RX0_RX_PATH_SEC0: DEM = CLSH_DSM_OUT */
-	CX_W(0x0b45, (uint8_t)cx_ear_db);       /* CDC_RX0_RX_VOL_CTL */
+	/* stream start, Linux's writes in Linux's order (bias, RCO and MCLK are already up for the mic) */
+	CX_W(0x0606, 0x02);                     /* ANA_BUCK_CTL */
+	CX_W(0x0606, 0x03);
+	CX_W(0x0606, 0x07);
 	CX_U(0x0608, 0x01, 0x01);               /* ANA_RX_SUPPLIES: RX bias */
-	/* EAR DAC: class-H for the EAR */
-	CX_U(0x073a, 0x02, 0x00);               /* HPH_NEW_INT_HPH_TIMER1: autochop timer off */
+	CX_U(0x0b41, 0x1f, 0x14);               /* CDC_RX0_RX_PATH_CTL: 48 kHz, PGA muted */
+	CX_U(0x0b41, 0x20, 0x20);               /* interpolator clock */
+	CX_W(0x0b45, (uint8_t)cx_ear_db);       /* CDC_RX0_RX_VOL_CTL */
 	CX_U(0x0c01, 0x01, 0x01);               /* CDC_CLSH_CRC: clock */
 	CX_U(0x0b42, 0x40, 0x40);               /* RX0 class-H enable */
-	CX_U(0x0608, 0x0c, 0x00);               /* VPOS / VNEG power level default (not HIFI) */
+	CX_U(0x0608, 0x0c, 0x00);               /* VPOS / VNEG power level default */
 	CX_U(0x0608, 0x40, 0x40);               /* flyback (VNEG) on */
 	au_sleep(1);
-	CX_U(0x06c7, 0xff, 0xaa);               /* RX_BIAS_FLYB_BUFF: 0xa / 0xa */
 	CX_U(0x0608, 0x80, 0x80);               /* buck (VPOS) on */
 	au_sleep(1);
-	/* EAR PA */
+	/* the codec's interface port, then the channel through the manager */
+	cx.if_page = -1;
+	if (cx_if_wr(0x030, (uint8_t)(1u << cx_rx_n)) ||       /* RX port interrupt enable (Linux writes it here) */
+	    cx_if_wr((uint16_t)(0x140 + 4 * CX_RX_PORT), (uint8_t)(1u << cx_rx_n)) ||  /* RX_PORT_MULTI_CHNL_0: RX n */
+	    cx_if_wr((uint16_t)(0x30 + CX_RX_PORT), (2u << 1) | 1u)) {   /* RX_PORT_CFG: water mark, enable */
+		CX_LOG("interface RX port registers not written\n");
+		return false;
+	}
+	uint8_t con[4] = { cx.la, CX_RX_PORT, CX_RX_CHAN, 0 };
+	r = cx_mgr_acked(0x2d, con, sizeof(con), 3);   /* SLIM_USR_MC_CONNECT_SINK: la, port, channel, tid */
+	CX_LOG("CONNECT_SINK -> %d\n", r);
+	if (r) {
+		return false;
+	}
+	uint8_t def[6] = { (uint8_t)(cx.la & 0x1f), (16 >> 2) | (1 << 5), (uint8_t)((2 << 4) | cx_rx_prot), cx_rx_prate, 0,
+		           (uint8_t)CX_RX_CHAN };
+	r = cx_mgr_acked(0x21, def, sizeof(def), 4);   /* SLIM_USR_MC_DEF_ACT_CHAN */
+	CX_LOG("DEF_ACT_CHAN (prot %u, presence %#x) -> %d\n", cx_rx_prot, cx_rx_prate, r);
+	if (r) {
+		return false;
+	}
+	uint8_t rec[2] = { 0, cx.la };
+	r = cx_mgr_acked(0x24, rec, sizeof(rec), 0);   /* SLIM_USR_MC_RECONFIG_NOW */
+	CX_LOG("RECONFIG_NOW -> %d\n", r);
+	if (r) {
+		return false;
+	}
+	/* EAR PA, then unmute */
 	CX_U(0x060a, 0x70, (uint8_t)((cx_ear_pa & 7) << 4));
 	CX_U(0x060a, 0x80, 0x80);               /* ANA_EAR: PA on */
 	au_sleep(6);
 	CX_U(0x0b41, 0x10, 0x00);               /* PGA unmuted */
-	CX_W(0x0b45, (uint8_t)cx_ear_db);       /* volume applied after the clock */
+	/* the DSP last */
+	struct {
+		uint32_t minor;
+		uint16_t dev, bits, fmt, chans;
+		uint8_t map[8];
+		uint32_t rate;
+	} __attribute__((packed)) sb = { 1, 0, 16, 0, 1, { CX_RX_CHAN }, AU_RATE };
+	lck_mtx_lock(&au_mtx);
+	r = afe_port_param(AFE_PORT_SLIMBUS_0_RX, AFE_MODULE_AUDIO_DEV_INTERFACE, AFE_PARAM_ID_SLIMBUS_CONFIG, &sb,
+	    sizeof(sb));
+	int st = r ? -1 : afe_port_cmd(AFE_PORT_SLIMBUS_0_RX, AFE_PORT_CMD_DEVICE_START);
+	lck_mtx_unlock(&au_mtx);
+	CX_LOG("AFE SLIMBUS_0_RX config -> %d, start -> %d\n", r, st);
+	if (r || st) {
+		return false;
+	}
 	cx.ear_up = true;
 	au_sleep(50);
-	uint8_t s0 = 0, s1 = 0, src = 0;
+	uint8_t s0 = 0, s1 = 0, src = 0, ps = 0;
 	(void)cx_if_rd(0x34, &s0);              /* PORT_INT_STATUS_RX_0 */
 	(void)cx_if_rd(0x35, &s1);
 	(void)cx_if_rd((uint16_t)(0x60 + cx_rx_n), &src);   /* PORT_INT_RX_SOURCE of RX n */
-	CX_LOG("codec RX port interrupts: status %02x %02x, RX0 source %02x\n", s0, s1, src);
-	static const uint16_t ear[] = { 0x0d01, 0x0b41, 0x0b42, 0x0b45, 0x0b49, 0x0b53, 0x0608, 0x060a, 0x06c7, 0x073a, 0x0c01 };
-	cx_dump("earpiece", ear, sizeof(ear) / sizeof(ear[0]));
+	(void)cx_if_rd((uint16_t)(0x80 + CX_RX_PORT), &ps);
+	CX_LOG("codec RX port: interrupt status %02x %02x, RX%u source %02x, port %u status %02x (Linux, playing: all 0)\n",
+	    s0, s1, cx_rx_n, src, CX_RX_PORT, ps);
+	static const uint16_t ear[] = { 0x0d01, 0x0b41, 0x0b42, 0x0b45, 0x0b49, 0x0b53, 0x0606, 0x0608, 0x060a, 0x06c7, 0x06e7,
+		                        0x073a, 0x0c01 };
+	cx_dump("earpiece (Linux playing: 0606 07, 0608 c1, 060a 80, 06e7 88, 0b41 24, 0b42 48)", ear,
+	    sizeof(ear) / sizeof(ear[0]));
 	return true;
 }
 
-/* stage 11: the earpiece's analog side off (PA, class-H, bias, interpolator); the SLIMbus channel and AFE port stay */
+/*
+ * stage 11: the earpiece off in Linux's stop order (3067h): the channel first (DISCONNECT_PORT, interface interrupt
+ * clear, REMOVE_CHAN, RECONFIG_NOW), PA off, class-H, buck and flyback off, the RX0 clock off with a reset pulse,
+ * ANA_BUCK_CTL off, RX bias off, and the DSP's port last. Bias, RCO and MCLK stay for the mic. Stage 10 can run again.
+ */
 static bool
 cx_stage_ear_off(void)
 {
-	CX_LOG("stage 11: earpiece off\n");
+	int r;
+	CX_LOG("stage 11: earpiece off (Linux order)\n");
 	cx.ear_up = false;
-	CX_U(0x0b41, 0x10, 0x10);               /* PGA muted */
+	uint8_t dis[3] = { cx.la, CX_RX_PORT, 0 };
+	r = cx_mgr_acked(0x2e, dis, sizeof(dis), 2);   /* SLIM_USR_MC_DISCONNECT_PORT: la, port, tid */
+	CX_LOG("DISCONNECT_PORT -> %d\n", r);
+	cx.if_page = -1;
+	(void)cx_if_wr(0x038, (uint8_t)(1u << cx_rx_n));       /* RX port interrupt clear */
+	uint8_t rm[3] = { (uint8_t)(0x80 | (cx.la & 0x1f)), 0, (uint8_t)CX_RX_CHAN };
+	r = cx_mgr_acked(0x23, rm, sizeof(rm), 1);     /* SLIM_USR_MC_CHAN_CTRL remove: 0x80 | la, tid, channel */
+	CX_LOG("REMOVE_CHAN -> %d\n", r);
+	uint8_t rec[2] = { 0, cx.la };
+	r = cx_mgr_acked(0x24, rec, sizeof(rec), 0);
+	CX_LOG("RECONFIG_NOW -> %d\n", r);
 	CX_U(0x060a, 0x80, 0x00);               /* EAR PA off */
 	au_sleep(6);
 	CX_U(0x0b42, 0x40, 0x00);               /* class-H off */
@@ -3875,11 +3898,17 @@ cx_stage_ear_off(void)
 	CX_U(0x0608, 0x80, 0x00);               /* buck off */
 	au_sleep(1);
 	CX_U(0x0608, 0x40, 0x00);               /* flyback off */
-	CX_U(0x0608, 0x01, 0x00);               /* RX bias off */
-	CX_U(0x0b41, 0x20, 0x00);               /* interpolator clock off, reset, 48 kHz */
+	CX_U(0x0b41, 0x30, 0x00);               /* interpolator clock off (Linux: 04, 44, 04) */
 	CX_U(0x0b41, 0x40, 0x40);
 	CX_U(0x0b41, 0x40, 0x00);
-	static const uint16_t ear[] = { 0x0b41, 0x0b42, 0x0608, 0x060a, 0x0c01 };
+	CX_W(0x0606, 0x03);                     /* ANA_BUCK_CTL off */
+	CX_W(0x0606, 0x00);
+	CX_U(0x0608, 0x01, 0x00);               /* RX bias off */
+	lck_mtx_lock(&au_mtx);
+	int st = afe_port_cmd(AFE_PORT_SLIMBUS_0_RX, AFE_PORT_CMD_DEVICE_STOP);
+	lck_mtx_unlock(&au_mtx);
+	CX_LOG("AFE SLIMBUS_0_RX stop -> %d\n", st);
+	static const uint16_t ear[] = { 0x0b41, 0x0b42, 0x0606, 0x0608, 0x060a, 0x0c01 };
 	cx_dump("earpiece off", ear, sizeof(ear) / sizeof(ear[0]));
 	return true;
 }
