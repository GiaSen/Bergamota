+/*
+ * 3108: did the panel really wake? From the vsync tick, display on. A panel that has woken gives its tearing signal,
+ * which sets the display engine's line counter back every frame; one that has not (seen after most wakes that followed
+ * a write of the vendor's d5 setting, the bootloader's at power on included: the panel dark, 2 frames a second "shown",
+ * and the same commands sent once more by hand brought it back) lets the counter run on to 0xfff0. Four ticks are
+ * looked at, from the third after "display on": about 2250 lines apart, so with the signal missing one of them is
+ * above any limit of 6000. Then the wake sequence goes out again.
+ */
+void
+AppleCLCD::teWatch(void)
+{
+	if (fMdp == 0 || fDsi == 0 || fHeight != 2248) {
+		return;
+	}
+	uint32_t line = mdp_rd(fMdp + SWEET_MDP_PP0, 0x14) & 0xffffu;
+	sweet_fb_te_line = (int)line;
+	if ((int)line > sweet_fb_te_max) {
+		sweet_fb_te_max = (int)line;
+	}
+	if (fPanelState != 0 || fPanelCheck == 0) {
+		return;
+	}
+	fPanelCheck--;
+	int limit = sweet_fb_te_limit;
+	if (fPanelCheck >= 4 || limit <= 0 || line <= (uint32_t)limit) {
+		return;
+	}
+	fPanelCheck = 0;
+	sweet_fb_te_lost++;
+	if (sweet_fb_panel_redo && fPanelRedo < 2) {
+		fPanelRedo++;
+		fPanelState = 3;
+		fPanelIdx = fPanelWait = 0;
+		sweet_fb_panel_state = 3;
+		if (sweet_fb_panel_redone++ < 8) {
+			IOLog("SWEET FB: no tearing signal after the wake (line counter %u): the wake sequence again\n", line);
+		}
+	}
+}
