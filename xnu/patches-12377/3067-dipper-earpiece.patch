 }
 
+/*
+ * ---- 3067: the earpiece. Xiaomi's mixer_paths_overlay_static.xml (vendor /etc) redefines `handset` for the Mi 8:
+ * SLIM RX0 (AIF1_PB) -> CDC_IF RX0 -> RX INT0_1 MIX1 INP0 = RX0 -> RX INT0 DEM MUX = CLSH_DSM_OUT -> EAR PA; the HAL
+ * plays `handset` on SLIMBUS_0_RX (no backend entry). So the earpiece hangs on the WCD9340's EAR output.
+ * Stage 10 (thread context, cx.busy held, codec up through stage 5):
+ *   Android's defaults for this path (tavil_codec_reg_defaults / reg_init_common_val): RX0 DSMDEM_CTL bit 0, RX0 SEC0
+ *   bit 3 clear, CLSH_DECAY_CTRL 0, CLSH_K2 0x060;
+ *   SLIMbus: codec RX port 16 (RX0 = WCD934X_RX_START + 0: RX_PORT_MULTI_CHNL_0 0x180 = bit 0, RX_PORT_CFG 0x40 = 12-byte
+ *   water mark + enable), AFE SLIMBUS_0_RX (0x4000) on shared channel 144 (= 144 + RX n, the machine driver's rx_ch),
+ *   DEVICE_START, then the manager: CONNECT_SINK (0x2d: codec PGD, port 16, channel 144), DEF_ACT_CHAN, RECONFIG_NOW;
+ *   RX INT0 (wcd934x.c / tavil): input RX0, 48 kHz, PGA muted, clock on, DEM = class-H DSM out (+ look-ahead delay),
+ *   digital volume; RX bias; the EAR DAC's class-H (wcd-clsh-v2 state EAR, CLS_H_NORMAL): autochop timer off, CLSH
+ *   CRC clock, RX0 class-H enable, VPOS/VNEG power level default, flyback on, flyback current 0xaa, buck on; EAR PA gain
+ *   and enable, 5 ms, PGA unmuted, volume re-latched.
+ * Gains: kern.sweet_ear_gain = (PA index << 8) | (uint8_t)RX0 dB; PA index 0 = +6 dB ... 4 = 0 dB, 5 = -2.5, 7 = -12;
+ * RX0 volume signed dB (-84..+40). Default 0 dB / 0 dB.
+ */
+#define CX_RX_PORT              16u
+#define CX_RX_CHAN              144u
+static int8_t cx_ear_db;
+static uint8_t cx_ear_pa = 4;
+
+static bool
+cx_codec_chain(void)
+{
+	return (cx.powered || cx_stage_qmi()) && (cx.regs_ok || cx_stage_regs()) && (cx.ngd_up || cx_stage_ngd()) &&
+	       (cx.la != 0xff && cx.la != 0 ? true : cx_stage_codec()) && (cx.mic_up || cx_stage_mic());
+}
+
+static bool
+cx_stage_ear(void)
+{
+	int r;
+	if (!cx.mic_up) {
+		CX_LOG("stage 10 needs stage 5 first\n");
+		return false;
+	}
+	CX_LOG("stage 10: earpiece: AFE SLIMBUS_0_RX -> channel %u -> codec RX0 (port %u) -> RX INT0 -> class-H -> EAR PA\n",
+	    CX_RX_CHAN, CX_RX_PORT);
+	CX_U(0x0b53, 0x01, 0x01);               /* CDC_RX0_RX_PATH_DSMDEM_CTL */
+	CX_U(0x0b49, 0x08, 0x00);               /* CDC_RX0_RX_PATH_SEC0 bit 3 */
+	CX_U(0x0c03, 0x03, 0x00);               /* CDC_CLSH_DECAY_CTRL */
+	CX_U(0x0c0a, 0x0f, 0x00);               /* CDC_CLSH_K2_MSB */
+	CX_W(0x0c0b, 0x60);                     /* CDC_CLSH_K2_LSB */
+	if (cx.la_if == 0xff) {
+		cx.la_if = cx_addr(cx_ifd_ea);
+		CX_LOG("codec interface device logical address %#x\n", cx.la_if);
+		if (cx.la_if == 0xff) {
+			return false;
+		}
+	}
+	if (!cx.ear_up) {
+		cx.if_page = -1;
+		if (cx_if_wr((uint16_t)(0x140 + 4 * CX_RX_PORT), 0x01) ||        /* RX_PORT_MULTI_CHNL_0: RX0 */
+		    cx_if_wr((uint16_t)(0x30 + CX_RX_PORT), (2u << 1) | 1u)) {   /* RX_PORT_CFG: water mark, enable */
+			CX_LOG("interface RX port registers not written\n");
+			return false;
+		}
+		uint8_t a = 0, c = 0;
+		(void)cx_if_rd((uint16_t)(0x140 + 4 * CX_RX_PORT), &a);
+		(void)cx_if_rd((uint16_t)(0x30 + CX_RX_PORT), &c);
+		CX_LOG("interface: RX port %u multi-channel %02x, port cfg %02x\n", CX_RX_PORT, a, c);
+		struct {
+			uint32_t minor;
+			uint16_t dev, bits, fmt, chans;
+			uint8_t map[8];
+			uint32_t rate;
+		} __attribute__((packed)) sb = { 1, 0, 16, 0, 1, { CX_RX_CHAN }, AU_RATE };
+		lck_mtx_lock(&au_mtx);
+		r = afe_port_param(AFE_PORT_SLIMBUS_0_RX, AFE_MODULE_AUDIO_DEV_INTERFACE, AFE_PARAM_ID_SLIMBUS_CONFIG, &sb,
+		    sizeof(sb));
+		int st = r ? -1 : afe_port_cmd(AFE_PORT_SLIMBUS_0_RX, AFE_PORT_CMD_DEVICE_START);
+		lck_mtx_unlock(&au_mtx);
+		CX_LOG("AFE SLIMBUS_0_RX config -> %d, start -> %d\n", r, st);
+		if (r || st) {
+			return false;
+		}
+		uint8_t con[4] = { cx.la, CX_RX_PORT, CX_RX_CHAN, 0 };
+		r = cx_mgr_acked(0x2d, con, sizeof(con), 3);   /* SLIM_USR_MC_CONNECT_SINK: la, port, channel, tid */
+		CX_LOG("CONNECT_SINK -> %d\n", r);
+		if (r) {
+			return false;
+		}
+		uint8_t def[6] = { (uint8_t)(cx.la & 0x1f), (16 >> 2) | (1 << 5), (2 << 4) | 0, 0x83, 0, CX_RX_CHAN };
+		r = cx_mgr_acked(0x21, def, sizeof(def), 4);   /* SLIM_USR_MC_DEF_ACT_CHAN */
+		CX_LOG("DEF_ACT_CHAN -> %d\n", r);
+		if (r) {
+			return false;
+		}
+		uint8_t rec[2] = { 0, cx.la };
+		r = cx_mgr_acked(0x24, rec, sizeof(rec), 0);   /* SLIM_USR_MC_RECONFIG_NOW */
+		CX_LOG("RECONFIG_NOW -> %d\n", r);
+		if (r) {
+			return false;
+		}
+	}
+	/* RX INT0 */
+	CX_U(0x0d01, 0x0f, 0x05);               /* CDC_RX_INP_MUX_RX_INT0_CFG0: INP0 = RX0 */
+	CX_U(0x0b41, 0x0f, 0x04);               /* CDC_RX0_RX_PATH_CTL: 48 kHz */
+	CX_U(0x0b41, 0x10, 0x10);               /* PGA muted while it starts */
+	CX_U(0x0b41, 0x20, 0x20);               /* interpolator clock */
+	CX_U(0x0b42, 0x08, 0x08);               /* CDC_RX0_RX_PATH_CFG0: look-ahead delay (DEM = class-H) */
+	CX_U(0x0b49, 0x01, 0x01);               /* CDC_RX0_RX_PATH_SEC0: DEM = CLSH_DSM_OUT */
+	CX_W(0x0b45, (uint8_t)cx_ear_db);       /* CDC_RX0_RX_VOL_CTL */
+	CX_U(0x0608, 0x01, 0x01);               /* ANA_RX_SUPPLIES: RX bias */
+	/* EAR DAC: class-H for the EAR */
+	CX_U(0x073a, 0x02, 0x00);               /* HPH_NEW_INT_HPH_TIMER1: autochop timer off */
+	CX_U(0x0c01, 0x01, 0x01);               /* CDC_CLSH_CRC: clock */
+	CX_U(0x0b42, 0x40, 0x40);               /* RX0 class-H enable */
+	CX_U(0x0608, 0x0c, 0x00);               /* VPOS / VNEG power level default (not HIFI) */
+	CX_U(0x0608, 0x40, 0x40);               /* flyback (VNEG) on */
+	au_sleep(1);
+	CX_U(0x06c7, 0xff, 0xaa);               /* RX_BIAS_FLYB_BUFF: 0xa / 0xa */
+	CX_U(0x0608, 0x80, 0x80);               /* buck (VPOS) on */
+	au_sleep(1);
+	/* EAR PA */
+	CX_U(0x060a, 0x70, (uint8_t)((cx_ear_pa & 7) << 4));
+	CX_U(0x060a, 0x80, 0x80);               /* ANA_EAR: PA on */
+	au_sleep(6);
+	CX_U(0x0b41, 0x10, 0x00);               /* PGA unmuted */
+	CX_W(0x0b45, (uint8_t)cx_ear_db);       /* volume applied after the clock */
+	cx.ear_up = true;
+	au_sleep(50);
+	uint8_t s0 = 0, s1 = 0, src = 0;
+	(void)cx_if_rd(0x34, &s0);              /* PORT_INT_STATUS_RX_0 */
+	(void)cx_if_rd(0x35, &s1);
+	(void)cx_if_rd(0x60, &src);             /* PORT_INT_RX_SOURCE of RX0 */
+	CX_LOG("codec RX port interrupts: status %02x %02x, RX0 source %02x\n", s0, s1, src);
+	static const uint16_t ear[] = { 0x0d01, 0x0b41, 0x0b42, 0x0b45, 0x0b49, 0x0b53, 0x0608, 0x060a, 0x06c7, 0x073a, 0x0c01 };
+	cx_dump("earpiece", ear, sizeof(ear) / sizeof(ear[0]));
+	return true;
+}
+
+/* stage 11: the earpiece's analog side off (PA, class-H, bias, interpolator); the SLIMbus channel and AFE port stay */
+static bool
+cx_stage_ear_off(void)
+{
+	CX_LOG("stage 11: earpiece off\n");
+	cx.ear_up = false;
+	CX_U(0x0b41, 0x10, 0x10);               /* PGA muted */
+	CX_U(0x060a, 0x80, 0x00);               /* EAR PA off */
+	au_sleep(6);
+	CX_U(0x0b42, 0x40, 0x00);               /* class-H off */
+	CX_U(0x0c01, 0x01, 0x00);
+	CX_U(0x0608, 0x80, 0x00);               /* buck off */
+	au_sleep(1);
+	CX_U(0x0608, 0x40, 0x00);               /* flyback off */
+	CX_U(0x0608, 0x01, 0x00);               /* RX bias off */
+	CX_U(0x0b41, 0x20, 0x00);               /* interpolator clock off, reset, 48 kHz */
+	CX_U(0x0b41, 0x40, 0x40);
+	CX_U(0x0b41, 0x40, 0x00);
+	static const uint16_t ear[] = { 0x0b41, 0x0b42, 0x0608, 0x060a, 0x0c01 };
+	cx_dump("earpiece off", ear, sizeof(ear) / sizeof(ear[0]));
+	return true;
+}
+
+/* kern.sweet_audio_out: 0 the speaker, 1 the earpiece (brings its path up); the player's next start uses it */
+static int
+au_out_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2)
+	int v = (int)au_out, err = sysctl_handle_int(oidp, &v, 0, req);
+	if (err || !req->newptr) {
+		return err;
+	}
+	if (v != 0 && v != 1) {
+		return EINVAL;
+	}
+	if (v == 1 && !cx.ear_up) {
+		if (!au_live) {
+			return ENXIO;
+		}
+		if (__atomic_exchange_n(&cx.busy, true, __ATOMIC_ACQUIRE)) {
+			return EBUSY;
+		}
+		cx.off = 0;
+		cx.log[0] = 0;
+		cx.runs++;
+		CX_LOG("run %u: earpiece on\n", cx.runs);
+		bool ok = cx_codec_chain() && cx_stage_ear();
+		__atomic_store_n(&cx.busy, false, __ATOMIC_RELEASE);
+		sweet_log_sync();
+		if (!ok) {
+			return EIO;
+		}
+	}
+	au_out = (uint32_t)v;
+	printf("SWEET AUDIO: output %s from the next player start\n", v ? "earpiece" : "speaker");
+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_audio_out, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0, au_out_sysctl, "I",
+    "Mi 8 player output: 0 speaker, 1 earpiece (WCD9340 EAR; brings the path up) (3067)");
+
+/* kern.sweet_ear_gain: (EAR PA index << 8) | (uint8_t)RX0 digital dB, applied at once when the earpiece is up */
+static int
+ear_gain_sysctl SYSCTL_HANDLER_ARGS
