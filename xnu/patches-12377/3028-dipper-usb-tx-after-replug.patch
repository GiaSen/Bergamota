+	/*
+	 * 3028: what was queued is for a link that is gone. An unplug gives no disconnect event, so the queue fills up behind the stuck transfer, and
+	 * ud_if_output drops a frame on a full queue without kicking: after the replug nothing ever started the queue again. The phone took frames
+	 * and answered none until a reboot (rx 380 -> 671, tx 1733, txq 32 for the rest of the boot, 2026-11-01; the same as 2026-10-28).
+	 */
+	while (ud.txq_count > 0) {
+		mbuf_freem(ud.txq[ud.txq_head]);
+		ud.txq_head = (ud.txq_head + 1) % UD_TXQ;
+		ud.txq_count--;
+	}
