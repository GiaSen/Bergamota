diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index f89fe4f..78f1ba1 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -1262,6 +1262,80 @@ struct sweet_log_header {
 	uint64_t total, seq;
 };
 
+/*
+ * 3058d: the previous boot's log, read back before this boot overwrites it, so a reset can be
+ * diagnosed from iOS (kern.sweet_log_prev: its last SWEET_LOG_PREV_KEEP bytes, oldest first) instead
+ * of booting a recovery. Read once at the log thread's start; nothing is kept without a valid header.
+ */
+#define SWEET_LOG_PREV_KEEP     (256u << 10)
+static char *sweet_log_prev;
+static uint32_t sweet_log_prev_len;
+static uint64_t sweet_log_prev_total, sweet_log_prev_seq;
+
+static void
+sweet_log_keep_prev(uint64_t base)
+{
+	struct sweet_log_header h;
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	int error;
+
+	lck_mtx_lock(&sweet_ufs_lock);
+	error = ufs_read_blocks(base, 1);
+	if (!error) {
+		memcpy(&h, bounce, sizeof(h));
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	if (error || memcmp(h.magic, "SWEETLOG", 8) || h.version != 1 || h.size != SWEET_LOG_SIZE || !h.total) {
+		printf("SWEET LOG: no previous boot's log (read %d)\\n", error);
+		return;
+	}
+	uint32_t keep = (uint32_t)MIN((uint64_t)SWEET_LOG_PREV_KEEP, MIN(h.total, (uint64_t)SWEET_LOG_SIZE));
+	char *buf = kalloc_data(keep, Z_WAITOK | Z_ZERO);
+	if (!buf) {
+		return;
+	}
+	/* bytes [total - keep, total) of the ring, block by block through the bounce buffer */
+	uint64_t pos = h.total - keep;
+	uint32_t got = 0;
+	while (got < keep && !error) {
+		uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE), blk = off / UFS_BLOCK, in = off % UFS_BLOCK;
+		uint32_t n = MIN((keep - got + in + UFS_BLOCK - 1) / UFS_BLOCK, (uint32_t)(BOUNCE_SIZE / UFS_BLOCK));
+		n = MIN(n, SWEET_LOG_SIZE / UFS_BLOCK - blk);
+		lck_mtx_lock(&sweet_ufs_lock);
+		error = ufs_read_blocks(base + 1 + blk, n);
+		if (!error) {
+			uint32_t take = MIN(n * UFS_BLOCK - in, keep - got);
+			memcpy(buf + got, (char *)bounce + in, take);
+			got += take;
+			pos += take;
+		}
+		lck_mtx_unlock(&sweet_ufs_lock);
+	}
+	if (error) {
+		kfree_data(buf, keep);
+		printf("SWEET LOG: previous boot's log not read (%d)\\n", error);
+		return;
+	}
+	sweet_log_prev_total = h.total;
+	sweet_log_prev_seq = h.seq;
+	sweet_log_prev_len = keep;
+	sweet_log_prev = buf;
+	printf("SWEET LOG: previous boot's log kept: last %u of %llu bytes, flush #%llu (kern.sweet_log_prev)\\n", keep,
+	    h.total, h.seq);
+}
+
+static int
+sweet_log_prev_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	if (!sweet_log_prev) {
+		return SYSCTL_OUT(req, "", 1);
+	}
+	return SYSCTL_OUT(req, sweet_log_prev, sweet_log_prev_len);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_log_prev, CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0,
+    sweet_log_prev_sysctl, "S", "the last 256 KiB of the previous boot's console log (3058d)");
+
 static void
