From f6c02dcb25c61416610292c226609dd07938a6af Mon Sep 17 00:00:00 2001
From: Giammarco Senatore <giamma@Giammarcos-Air.home>
Date: Fri, 6 Nov 2026 02:20:39 +0100
Subject: [PATCH] 3065: continuous mic capture for user space
 (kern.sweet_audio_rec: start brings the codec chain up, 2 s ring, 4 x 20 ms
 reads in flight, read from a sample position, idle stop after 5 s)

---
 bsd/dev/dipper_audio.c | 234 ++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 230 insertions(+), 4 deletions(-)

diff --git a/bsd/dev/dipper_audio.c b/bsd/dev/dipper_audio.c
index 80422d4..52f2599 100644
--- a/bsd/dev/dipper_audio.c
+++ b/bsd/dev/dipper_audio.c
@@ -1035,7 +1035,7 @@ static struct {
 	vm_offset_t slim, rst;
 	uint8_t tid, la, la_if;
 	int page, if_page;
-	bool codec_up, mic_up, port_up;
+	bool codec_up, mic_up, port_up, amic;
 	uint32_t runs;
 	bool busy, powered, regs_ok, ngd_up;
 	char log[4096];
@@ -1056,9 +1056,16 @@ static struct {
 	bool mapped, stream, copp_open, done;
 } cap;
 
+static void rec_done_hook(const uint8_t *pl11);    /* 3065 continuous capture, defined with it */
+static bool rec_running(void);
+
 static void
 cx_cap_done(const uint8_t *pl11)
 {
+	if (rec_running()) {
+		rec_done_hook(pl11);
+		return;
+	}
 	memcpy(&cap.status, pl11, 4);
 	memcpy(&cap.size, pl11 + 16, 4);
 	memcpy(&cap.offset, pl11 + 20, 4);
@@ -3607,7 +3614,7 @@ cx_stage_capture(unsigned seconds)
  * 300 ms the hold released, the HPF re-latched, the decimator unmuted. Then a 2 s capture (stage 7).
  */
 static bool
-cx_stage_amic(void)
+cx_amic_switch(void)
 {
 	if (!cx.port_up) {
 		CX_LOG("stage 8 needs stage 6 first\n");
@@ -3631,8 +3638,226 @@ cx_stage_amic(void)
 	CX_U(0x0aa1, 0x10, 0x00);               /* unmute */
 	static const uint16_t am[] = { 0x0622, 0x0610, 0x0611, 0x0d29, 0x0d25, 0x0aa1, 0x0aa2 };
 	cx_dump("analog mic", am, sizeof(am) / sizeof(am[0]));
-	return cx_stage_capture(2);
+	cx.amic = true;
+	return true;
+}
+
+static bool
+cx_stage_amic(void)
+{
+	return cx_amic_switch() && cx_stage_capture(2);
+}
+
+/*
+ * ---- 3065: continuous capture for user space (kern.sweet_audio_rec): the handset mic as 16-bit mono at 48 kHz.
+ * Start brings the codec chain up if needed (stages 1-6 + the analog mic of stage 8), opens the record stream
+ * (stage 7's cx_cap_open) and keeps REC_NQ reads of 20 ms in flight from the audio thread; each READ_DONE is
+ * copied into a 2 s ring. A reader asks for the samples from its own position on; with nobody reading for
+ * REC_IDLE_S the capture stops by itself (the codec stays up).
+ *   in  {u32 op, u32 max_samples, u64 pos}: op 1 start, 2 stop, 3 read
+ *   out {u64 wpos (samples captured so far), u64 from (the first sample returned), u32 n, u32 state} + n samples
+ */
+#define REC_NQ                  4u
+#define REC_BUF                 1920u           /* 20 ms of 16-bit mono */
+#define REC_RING                96000u          /* samples: 2 s */
+#define REC_IDLE_S              5u
+enum { REC_OFF, REC_RUNNING };
+static struct {
+	int state;
+	int16_t *ring;
+	uint64_t wpos, reads, done, errors, last_read;
+	uint32_t busy_mask, seq;
+} rec;
+
+/* audio thread or a GLINK poller, au_mtx held: one READ_DONE of the continuous capture */
+static void
+rec_done(uint32_t buf_lsw, uint32_t status, uint32_t size, uint32_t offset)
+{
+	uint32_t base = (uint32_t)AU_POOL_PA + CX_CAP_OFF;
+	unsigned k = (buf_lsw - base) / REC_BUF;
+	if (buf_lsw < base || k >= REC_NQ) {
+		rec.errors++;
+		return;
+	}
+	rec.busy_mask &= ~(1u << k);
+	rec.done++;
+	if (status != 0 || offset > REC_BUF || size > REC_BUF - offset) {
+		rec.errors++;
+		return;
+	}
+	const volatile int16_t *smp = (const volatile int16_t *)(au_pool + CX_CAP_OFF + k * REC_BUF + offset);
+	for (unsigned j = 0; j < size / 2; j++) {
+		rec.ring[(rec.wpos + j) % REC_RING] = smp[j];
+	}
+	rec.wpos += size / 2;
+}
+
+static bool
+rec_running(void)
+{
+	return rec.state == REC_RUNNING;
+}
+
+static void
+rec_done_hook(const uint8_t *pl11)
+{
+	uint32_t status, lsw, size, offset;
+	memcpy(&status, pl11, 4);
+	memcpy(&lsw, pl11 + 4, 4);
+	memcpy(&size, pl11 + 16, 4);
+	memcpy(&offset, pl11 + 20, 4);
+	rec_done(lsw, status, size, offset);
+}
+
+/* audio thread, au_mtx held: keep the reads in flight, stop when nobody reads */
+static void
+rec_step(void)
+{
+	if (rec.state != REC_RUNNING) {
+		return;
+	}
+	uint64_t now = mach_absolute_time(), idle;
+	nanoseconds_to_absolutetime((uint64_t)REC_IDLE_S * NSEC_PER_SEC, &idle);
+	if (now - rec.last_read > idle) {
+		rec.state = REC_OFF;
+		cx_cap_close();
+		printf("SWEET AUDIO: capture stopped: nobody read for %u s (%llu samples, %llu reads, %llu errors)\n", REC_IDLE_S,
+		    rec.wpos, rec.reads, rec.errors);
+		return;
+	}
+	for (unsigned k = 0; k < REC_NQ; k++) {
+		if (rec.busy_mask & (1u << k)) {
+			continue;
+		}
+		struct {
+			uint32_t lsw, msw, handle, size, seq;
+		} __attribute__((packed)) rd = { (uint32_t)AU_POOL_PA + CX_CAP_OFF + k * REC_BUF, AU_POOL_MSW, cap.handle,
+			                         REC_BUF, ++rec.seq };
+		uint8_t pkt[APR_HDR_SIZE + 32];
+		struct au_apr_hdr h = { APR_HDR_FIELD_SEQ_CMD, (uint16_t)(APR_HDR_SIZE + sizeof(rd)), APR_SVC_ASM, APR_DOMAIN_APPS,
+			                CX_CAP_PORT, APR_SVC_ASM, APR_DOMAIN_ADSP, CX_CAP_PORT, rec.seq, ASM_DATA_CMD_READ_V2 };
+		memcpy(pkt, &h, APR_HDR_SIZE);
+		memcpy(pkt + APR_HDR_SIZE, &rd, sizeof(rd));
+		if (!gl_send(CH_APR, pkt, APR_HDR_SIZE + sizeof(rd))) {
+			break;                          /* no free intent from the DSP yet: next loop */
+		}
+		rec.busy_mask |= 1u << k;
+		rec.reads++;
+	}
+}
+
+/* thread context, no locks held: the codec chain up (if needed) and the stream running */
+static int
+rec_start(void)
+{
+	if (rec.state == REC_RUNNING) {
+		return 0;
+	}
+	if (!rec.ring && !(rec.ring = kalloc_data(REC_RING * sizeof(int16_t), Z_WAITOK | Z_ZERO))) {
+		return ENOMEM;
+	}
+	if (__atomic_exchange_n(&cx.busy, true, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	bool ok = true;
+	if (!cx.amic) {
+		cx.off = 0;
+		cx.log[0] = 0;
+		cx.runs++;
+		CX_LOG("run %u: capture start brings the codec up\n", cx.runs);
+		ok = (cx.powered || cx_stage_qmi()) && (cx.regs_ok || cx_stage_regs()) && (cx.ngd_up || cx_stage_ngd()) &&
+		    (cx.la != 0xff && cx.la != 0 ? true : cx_stage_codec()) && (cx.mic_up || cx_stage_mic()) &&
+		    (cx.port_up || cx_stage_port()) && cx_amic_switch();
+	}
+	__atomic_store_n(&cx.busy, false, __ATOMIC_RELEASE);
+	if (!ok) {
+		return EIO;
+	}
+	lck_mtx_lock(&au_mtx);
+	ok = cx_cap_open();
+	if (ok) {
+		rec.busy_mask = 0;
+		rec.last_read = mach_absolute_time();
+		rec.state = REC_RUNNING;
+	} else {
+		cx_cap_close();
+	}
+	lck_mtx_unlock(&au_mtx);
+	printf("SWEET AUDIO: capture %s\n", ok ? "running" : "did not start");
+	return ok ? 0 : EIO;
+}
+
+static int
+rec_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	struct {
+		uint32_t op, max;
+		uint64_t pos;
+	} in = { 3, 0, 0 };
+	struct {
+		uint64_t wpos, from;
+		uint32_t n, state;
+	} hdr;
+	int err;
+	if (!au_live) {
+		return ENXIO;
+	}
+	if (req->newptr) {
+		if (req->newlen < sizeof(in)) {
+			return EINVAL;
+		}
+		if ((err = SYSCTL_IN(req, &in, sizeof(in)))) {
+			return err;
+		}
+	}
+	if (in.op == 1) {
+		if ((err = rec_start())) {
+			return err;
+		}
+	} else if (in.op == 2) {
+		lck_mtx_lock(&au_mtx);
+		if (rec.state == REC_RUNNING) {
+			rec.state = REC_OFF;
+			cx_cap_close();
+		}
+		lck_mtx_unlock(&au_mtx);
+	}
+	uint32_t max = MIN(in.max, 9600u);              /* 200 ms per call */
+	int16_t *out = max ? kalloc_data(max * sizeof(int16_t), Z_WAITOK) : NULL;
+	if (max && !out) {
+		return ENOMEM;
+	}
+	lck_mtx_lock(&au_mtx);
+	rec.last_read = mach_absolute_time();
+	uint64_t w = rec.wpos, from = in.pos;
+	if (w > REC_RING && from < w - REC_RING) {
+		from = w - REC_RING;                    /* the reader fell more than the ring behind */
+	}
+	if (from > w) {
+		from = w;
+	}
+	uint32_t n = (uint32_t)MIN((uint64_t)max, w - from);
+	for (uint32_t j = 0; j < n; j++) {
+		out[j] = rec.ring ? rec.ring[(from + j) % REC_RING] : 0;
+	}
+	hdr.wpos = w;
+	hdr.from = from;
+	hdr.n = n;
+	hdr.state = (uint32_t)rec.state;
+	lck_mtx_unlock(&au_mtx);
+	err = SYSCTL_OUT(req, &hdr, sizeof(hdr));
+	if (!err && n) {
+		err = SYSCTL_OUT(req, out, n * sizeof(int16_t));
+	}
+	if (out) {
+		kfree_data(out, max * sizeof(int16_t));
+	}
+	return err;
 }
+SYSCTL_PROC(_kern, OID_AUTO, sweet_audio_rec, CTLTYPE_OPAQUE | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED, 0, 0,
+    rec_sysctl, "S", "Mi 8 handset mic: in {u32 op 1 start/2 stop/3 read, u32 max, u64 pos}, out {u64 wpos, u64 from, "
+    "u32 n, u32 state} + 16-bit mono 48 kHz samples (3065)");
 
 /*
  * kern.sweet_codec: 1 = stage 1 (QMI), 2 = stage 2 (register reads), 3 = stage 3 (NGD), 4 = stage 4 (codec id),
@@ -3715,7 +3940,8 @@ au_thread(void *arg, wait_result_t w)
 			lck_mtx_lock(&au_mtx);
 			gl_poll();
 			pl_step();
-			bool playing = pl.state != PL_OFF || pl.req;
+			rec_step();
+			bool playing = pl.state != PL_OFF || pl.req || rec.state == REC_RUNNING;
 			lck_mtx_unlock(&au_mtx);
 			au_sleep(playing ? 2 : 20);
 		}
-- 
