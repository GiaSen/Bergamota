diff --git a/iokit/Kernel/arm/SweetBattery.cpp b/iokit/Kernel/arm/SweetBattery.cpp
index 56b6f9c..12b8f30 100644
--- a/iokit/Kernel/arm/SweetBattery.cpp
+++ b/iokit/Kernel/arm/SweetBattery.cpp
@@ -298,6 +298,38 @@ SweetBattery::estimatePercent(unsigned mv)
 	return 100;
 }
 
+/*
+ * 3013: FG voltage and current move between two reads while charging (0.12 mV and 0.49 mA per bit), so equal
+ * words are rare: words within 64 counts are one sample. Only a torn read (a high byte from the next value) is
+ * further apart than that.
+ */
+static bool
+fg_read_word(unsigned sid, unsigned address, uint16_t *value)
+{
+	uint16_t previous = 0;
+	for (unsigned attempt = 0; attempt < 6; ++attempt) {
+		uint8_t lo, hi;
+		if (sweet_spmi_read(sid, address, &lo) || sweet_spmi_read(sid, address + 1, &hi)) {
+			return false;
+		}
+		uint16_t next = (uint16_t)((unsigned)lo | ((unsigned)hi << 8));
+		int diff = (int16_t)(uint16_t)(next - previous);
+		if (attempt && diff >= -64 && diff <= 64) {
+			*value = next;
+			return true;
+		}
+		previous = next;
+	}
+	return false;
+}
+
+/* 3013: the last good measurement. A failed poll keeps it: 100% and full is for a boot with no measurement at all. */
+static struct {
+	bool have, external, charging, full, currentValid;
+	unsigned percent, mv;
+	int ma;
+} fg_last;
+
 /*
  * Poco F1: PMI8998 (SID 2) FG gen3 + SMB2 charger, read-only, as Linux
  * qpnp-fg-gen3.c / smb-reg.h. The FG keeps its own calibrated monotonic
@@ -318,12 +350,17 @@ SweetBattery::pollBeryllium(void)
 		}
 	}
 	valid = valid && msoc == msoc2 &&
-	    readWord(0x41a0, &rawVoltage, sid) &&
+	    fg_read_word(sid, 0x41a0, &rawVoltage) &&
 	    !sweet_spmi_read(sid, 0x1310, &usb) &&
 	    !sweet_spmi_read(sid, 0x1006, &charger);
 	unsigned mv = valid ? (unsigned)(((uint64_t)rawVoltage * 122070u) / 1000000u) : 0;
 	valid = valid && mv >= 2800 && mv <= 4600;
 	if (!valid) {
+		if (fg_last.have) {
+			publish(fg_last.percent, fg_last.mv, fg_last.ma, fg_last.external, fg_last.external, fg_last.charging,
+			    fg_last.full, true, fg_last.currentValid);
+			return;
+		}
 		publish(100, 4200, 0, true, true, false, true, false, false);
 		return;
 	}
@@ -335,12 +372,20 @@ SweetBattery::pollBeryllium(void)
 	bool charging = external && state >= 1 && state <= 4;
 	bool full = external && state == 5;          /* TERMINATE_CHARGE */
 	int ma = 0;
-	bool currentValid = readWord(0x41a2, &rawCurrent, sid);
+	bool currentValid = fg_read_word(sid, 0x41a2, &rawCurrent);
 	if (currentValid) {
 		int signedRaw = (rawCurrent & 0x8000u) ? (int)rawCurrent - 65536 : (int)rawCurrent;
 		/* FG: positive = discharging, 488.281 uA/bit; IOPMPowerSource: positive = charging, mA */
 		ma = (int)(-((int64_t)signedRaw * 488281) / 1000000);
 	}
+	fg_last.have = true;
+	fg_last.percent = full ? 100 : percent;
+	fg_last.mv = mv;
+	fg_last.ma = ma;
+	fg_last.external = external;
+	fg_last.charging = charging;
+	fg_last.full = full;
+	fg_last.currentValid = currentValid;
 	publish(full ? 100 : percent, mv, ma, external, external, charging, full, true, currentValid);
 }
 
