+	}
+	case 12: {                              /* START_SCAN, passive, ath10k defaults */
 		uint32_t s[25];
 		memset(s, 0, sizeof(s));
 		s[0] = 0xa000 | (scan.count & 0xfff);   /* scan_id (ATH10K_SCAN_ID 0 for the first) */
@@ -4619,7 +4638,7 @@ scan_step(void)
