 static void
 au_thread(void *arg, wait_result_t w)
 {
diff --git a/bsd/dev/sweet_rpmh.c b/bsd/dev/sweet_rpmh.c
index 26734d0..0e2958c 100644
--- a/bsd/dev/sweet_rpmh.c
+++ b/bsd/dev/sweet_rpmh.c
@@ -449,6 +449,44 @@ out:
 	return error;
 }
 
+/*
+ * Mi 8 (dipper) WCD9340 MCLK, 3058: live DT audio_ext_clk_lnbb (qcom,audio-ref-clk) clocks = <&clock_rpmh 2> =
+ * RPMH_LN_BB_CLK2; clk-rpmh.c DEFINE_CLK_RPMH_VRM(sdm845, ln_bb_clk2, ..., "lnbclka2") votes 1 at the cmd-db address
+ * + CLK_RPMH_VRM_EN_OFFSET (4), like rfclka2 above. Active-set vote only, never voted off. Dipper only.
+ */
+int sweet_rpmh_lnbclk2_enable(void);
+int
+sweet_rpmh_lnbclk2_enable(void)
+{
+	if (!sweet_board_is("xiaomi,dipper")) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup("lnbclka2", &address);
+	}
+	if (!error) {
+		const uint32_t a[1] = { address + 4 }, v[1] = { 1 };
+		printf("SWEET RPMH: clock lnbclka2 enable at %#x\n", address + 4);
+		error = rh_cmds(a, v, 1);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: clock lnbclka2 enable failed errno=%d\n", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
 /* Read-only: RSC geometry check, cmd-db lookup, no TCS access. */
 int
 sweet_rpmh_lookup(const char *res, uint32_t *address)
