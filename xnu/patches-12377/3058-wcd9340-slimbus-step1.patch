+/*
+ * ---- 3058: the WCD9340 (Tavil) codec over SLIMbus, step 1: bring the bus up and read the codec's chip id
+ * (kern.sweet_codec; nothing runs unless it is written). Facts: live DT slim@171c0000 (qcom,slim-ngd, cell-index 1,
+ * so NGD_BASE_V2 = +0x1000 and QMI instance 1 >> 1 = 0), tavil_codec PGD elemental address 00 01 50 02 17 02,
+ * reset TLMM 64 (NORTH), MCLK = RPMh lnbclka2, supply pm8998 s4 (stub, always on). Sequence and message formats
+ * from Qualcomm's slim-msm-ngd.c / slim-msm.c (register facts only): the DSP is the bus manager; we are a satellite
+ * NGD that uses the register FIFOs (no BAM). QMI to the DSP's SLIMbus service 0x301: SELECT_INSTANCE 0x20 {0x01 u32
+ * instance, 0x10 u32 mode 1 = satellite}, POWER 0x21 {0x01 u32 2 = active}; then NGD CFG = enable, the manager sends
+ * MASTER_CAPABILITY, we answer REPORT_SATELLITE; ADDR_QUERY gives the codec's logical address; REQUEST_VALUE reads
+ * its registers (element address 0x800 + register, page 0 after reset).
+ */
+#define QR_SLIM_SERVICE         0x301u
+#define QR_SLIM_PORT            0x4011u
+#define CX_SLIM_PA              0x171c0000u
+#define CX_SLIM_SIZE            0x2c000u
+#define CX_NGD                  0x1000u
+#define NGD_CFG                 0x0u
+#define NGD_STATUS              0x4u
+#define NGD_RX_MSGQ_CFG         0x8u
+#define NGD_INT_EN              0x10u
+#define NGD_INT_STAT            0x14u
+#define NGD_INT_CLR             0x18u
+#define NGD_TX_MSG              0x30u
+#define NGD_RX_MSG              0x70u
+#define NGD_INT_TX_SENT         (1u << 31)
+#define NGD_INT_RX_RCVD         (1u << 30)
+#define NGD_INT_ERRORS          ((1u << 25) | (1u << 26) | (1u << 27) | (1u << 29))
+#define CX_TLMM_NORTH_PA        0x03900000u
+#define CX_RESET_GPIO           64u
+static const uint8_t cx_pgd_ea[6] = { 0x00, 0x01, 0x50, 0x02, 0x17, 0x02 };
+static struct {
+	uint32_t node, port;            /* the DSP's SLIMbus QMI service */
+	bool have_srv, rsp;
+	uint16_t txn;
+	uint8_t rsp_buf[64];
+	uint32_t rsp_len;
+	vm_offset_t slim, rst;
+	uint8_t tid, la;
+	uint32_t runs;
+	char log[4096];
+	size_t off;
+} cx;
+
+#define CX_LOG(...) do { \
+	int _n = snprintf(cx.log + cx.off, sizeof(cx.log) - cx.off, __VA_ARGS__); \
+	if (_n > 0) { \
+	        printf("SWEET CODEC: %s", cx.log + cx.off); \
+	        cx.off = MIN(sizeof(cx.log) - 1, cx.off + (size_t)_n); \
+	} \
+} while (0)
+
+static void
+cx_qmi_rx(const uint8_t *p, uint32_t len)
+{
+	uint16_t txn;
+	if (len < 7 || p[0] != 2) {
+		return;
+	}
+	memcpy(&txn, p + 1, 2);
+	if (txn != cx.txn) {
+		return;
+	}
+	cx.rsp_len = MIN(len, (uint32_t)sizeof(cx.rsp_buf));
+	memcpy(cx.rsp_buf, p, cx.rsp_len);
+	cx.rsp = true;
+}
+
 static bool
 qr_send(uint32_t type, uint32_t src_port, uint32_t dst_node, uint32_t dst_port, const void *pl, uint32_t size)
 {
@@ -1034,6 +1101,11 @@ qr_rx(const uint8_t *p, uint32_t len)
 			gl.servers++;
 			printf("SWEET AUDIO: qrtr: the DSP %s service %u (%#x) version %u instance %u at %u:%#x\n",
 			    type == Q_NEW_SERVER ? "offers" : "removes", v[1], v[1], v[2] & 0xff, v[2] >> 8, v[3], v[4]);
+			if (v[1] == QR_SLIM_SERVICE) {
+				cx.have_srv = type == Q_NEW_SERVER;
+				cx.node = v[3];
+				cx.port = v[4];
+			}
 			if (type == Q_NEW_SERVER && v[1] == QR_NOTIF_SERVICE && (v[2] >> 8) == 74 && !nf.asked) {
 				nf.node = v[3];
 				nf.port = v[4];
