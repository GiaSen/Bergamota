+
+/*
+ * Patch 3005 (boot-arg sweetamp_yield=1). The steering above picks an A75 when a thread wakes, but all eight cores share one
+ * run queue: the waker, often a kernel thread on an A55, blocks right after the wakeup and its A55 takes the thread from the
+ * queue while the chosen A75 is still leaving WFI. CoreAnimation's display thread ran on the A55s that way, every frame.
+ * So an A55 about to pick up work first looks at the thread on top of the queue: if it should run on an A75 and one is
+ * awake or waking for it, the A55 waits a moment (with the pset unlocked) for it to go. After sweet_amp_wait_abs it takes the
+ * thread as before, so no work can be left stranded (processor_idle() does not look at the queue again).
+ */
+int sweet_amp_yield;
+uint64_t sweet_amp_wait_abs;
+uint32_t sweet_amp_yield_waits, sweet_amp_yield_ok, sweet_amp_yield_timeouts;
+extern thread_t sweet_clutch_peek(processor_t processor);
+
+static bool
+sweet_amp_big_is_coming(processor_set_t pset, processor_t processor)
+{
+	uint64_t big = os_atomic_load(&sweet_amp_big_mask, acquire);
+	if (big == 0 || bit_test(big, processor->cpu_id)) {
+		return false;
+	}
+	thread_t top = sweet_clutch_peek(processor);
+	if (top == THREAD_NULL || top->bound_processor != PROCESSOR_NULL || sweet_amp_wanted_map(top) != big) {
+		return false;
+	}
+	uint64_t usable = big & pset->recommended_bitmask;
+	if (pset->cpu_state_map[PROCESSOR_DISPATCHING] & usable) {
+		return true;
+	}
+	uint64_t idle = pset->cpu_state_map[PROCESSOR_IDLE] & usable;
+	if (idle == 0) {
+		return false;
+	}
+	/* an A75 sits idle and nothing has called it (the one chosen at wakeup went to other work): as processor_setrun() does */
+	processor_t b = processor_array[lsb_first(idle)];
+	pset_update_processor_state(pset, b, PROCESSOR_DISPATCHING);
+	sched_ipi_type_t ipi = sched_ipi_action(b, top, SCHED_IPI_EVENT_PREEMPT);
+	sched_ipi_perform(b, ipi);
+	return true;
+}
+
+/* Called and returns with the pset locked; drops it while waiting. */
+static void
+sweet_amp_wait_for_big(processor_set_t pset, processor_t processor)
+{
+	uint64_t deadline = mach_absolute_time() + sweet_amp_wait_abs;
+	bool gone;
+	sweet_amp_yield_waits++;
+	do {
+		pset_unlock(pset);
+		delay(5);
+		pset_lock(pset);
+		gone = !sweet_amp_big_is_coming(pset, processor);
+	} while (!gone && mach_absolute_time() < deadline);
+	if (gone) {
+		sweet_amp_yield_ok++;
+	} else {
+		sweet_amp_yield_timeouts++;
+	}
+}
