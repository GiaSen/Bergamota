+/* 3024: the keys' polling (sweet_keys.c, its own mappings) under the same lock as every other SPMI access from this EE, as Linux does */
+bool
+sweet_spmi_keys_take(void)
+{
+	if (!sp_ready || sp_atomic) {
+		return false;
+	}
+	IOLockLock(sp_lock);
+	return true;
+}
+
+void
+sweet_spmi_keys_put(bool got)
+{
+	if (got) {
+		IOLockUnlock(sp_lock);
+	}
+}
