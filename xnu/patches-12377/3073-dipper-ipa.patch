diff --git a/bsd/dev/sweet_smmu.c b/bsd/dev/sweet_smmu.c
index 2467862..af72191 100644
--- a/bsd/dev/sweet_smmu.c
+++ b/bsd/dev/sweet_smmu.c
@@ -44,6 +44,7 @@ int sweet_smmu_probe_sid(unsigned sid, unsigned level);
 #define L1_SIZE         0x1000u         /* one 512-entry level-1 table */
 
 static vm_offset_t smmu_base;
+static vm_offset_t smmu_l1v, smmu_l2v;  /* 3073: the bank's level-1 table, and a level-2 one for GiB 0 (sweet_smmu_map_block) */
 static int smmu_cb = -1;                /* shared translating context bank */
 static unsigned smmu_nsmr;
 static int smmu_next_smr;               /* first free SMR to try next */
@@ -118,6 +119,7 @@ smmu_bank_create(void)
 	}
 	uint64_t l1_pa = ptoa_64(pn);
 	volatile uint64_t *l1 = (volatile uint64_t *)l1v;
+	smmu_l1v = l1v;
 	for (unsigned i = 2; i < 10; i++) {
 		l1[i] = (uint64_t)i << 30 | 1u << 10 | 2u << 8 | 1u << 6 | 1;
 	}
@@ -156,6 +158,65 @@ smmu_bank_create(void)
 	return 0;
 }
 
+/*
+ * 3073: one 2 MiB block of the first GiB (below DRAM) identity-mapped into the shared bank, Normal NC, RW: the IPA's
+ * IMEM (Linux ipa_imem_init(): sdm845 0x146bd000 + 0x2000, mapped 1:1 into the IPA's domain; the downstream DT's
+ * ipa_smmu_ap qcom,additional-mapping). Needs the bank (a sweet_smmu_map_sid() first). Idempotent.
+ */
+int sweet_smmu_map_block(uint64_t pa);
+int
+sweet_smmu_map_block(uint64_t pa)
+{
+	int error = 0;
+
+	if (pa >= (1ull << 30)) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&smmu_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	if (smmu_cb < 0 || smmu_base == 0 || smmu_l1v == 0) {
+		error = ENODEV;
+		goto out;
+	}
+	volatile uint64_t *l1 = (volatile uint64_t *)smmu_l1v;
+	if (smmu_l2v == 0) {
+		vm_offset_t l2v = 0;
+		if (kmem_alloc_contig(kernel_map, &l2v, L1_SIZE, PAGE_MASK, 0, 0, KMA_DATA | KMA_ZERO | KMA_PERMANENT,
+		    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			error = ENOMEM;
+			goto out;
+		}
+		ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)l2v);
+		if (!pn) {
+			error = ENOMEM;
+			goto out;
+		}
+		sweet_dma_sync_va((const void *)l2v, L1_SIZE);
+		smmu_l2v = l2v;
+		l1[0] = ptoa_64(pn) | 3;                                /* table */
+		sweet_dma_sync_va((const void *)smmu_l1v, L1_SIZE);
+	}
+	volatile uint64_t *l2 = (volatile uint64_t *)smmu_l2v;
+	uint64_t block = pa & ~0x1fffffull;
+	l2[(pa >> 21) & 0x1ff] = block | 1u << 10 | 2u << 8 | 1u << 6 | 1;     /* block, AF, OSH, RW, attr 0 (Normal NC) */
+	sweet_dma_sync_va((const void *)smmu_l2v, L1_SIZE);
+	{
+		uint32_t id1 = smmu_rd(0x24);
+		unsigned pgshift = (id1 >> 31) ? 16 : 12;
+		uint32_t cb = ((1u << (((id1 >> 28) & 7) + 1)) << pgshift) + ((uint32_t)smmu_cb << pgshift);
+		smmu_wr(cb + 0x618, 0);                         /* TLBIALL */
+		smmu_wr(cb + 0x7f0, 0);                         /* TLBSYNC */
+		for (int t = 0; t < 100000 && (smmu_rd(cb + 0x7f4) & 1); t++) {
+			delay(1);
+		}
+	}
+	printf("SWEET SMMU: bank %d: 2 MiB block %#llx mapped 1:1\n", smmu_cb, block);
+out:
+	__atomic_store_n(&smmu_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
