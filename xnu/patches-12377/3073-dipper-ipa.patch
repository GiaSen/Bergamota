+/*
+ * 3073: one BCM vote by name: commit, valid while vote != 0, y = vote (14 bits). For the IPA's clock, the BCM "IP0"
+ * (Linux clk-rpmh.c: sdm845 RPMH_IPA_CLK; HakiOS's OnePlus 6T port votes it at 0x3fff). Only the names below.
+ */
+int sweet_rpmh_bcm_vote(const char *res, uint32_t vote);
+int
+sweet_rpmh_bcm_vote(const char *res, uint32_t vote)
+{
+	static const char *const allowed[] = { "IP0" };
+	unsigned i;
+	if (!sweet_board_beryllium() || !res) {
+		return EINVAL;
+	}
+	for (i = 0; i < sizeof(allowed) / sizeof(allowed[0]); ++i) {
+		if (!strcmp(res, allowed[i])) {
+			break;
+		}
+	}
+	if (i == sizeof(allowed) / sizeof(allowed[0])) {
+		printf("SWEET RPMH: %s is not an allowed BCM\n", res);
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0, aux = 0, aux_len = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup_slave(res, RH_BCM, &address, &aux, &aux_len);
+	}
+	if (!error) {
+		uint32_t unit = aux_len >= 4 ? (rh_db16(aux) | ((uint32_t)rh_db16(aux + 2) << 16)) : 0;
+		uint32_t width = aux_len >= 6 ? rh_db16(aux + 4) : 0;
+		uint32_t value = (1u << 30) | (vote ? (1u << 29) : 0) | (vote & 0x3fffu);
+		printf("SWEET RPMH: %s BCM %#x (unit %u, width %u): vote %#x -> cmd %#x\n", res, address, unit, width, vote, value);
+		error = rh_cmds(&address, &value, 1);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: %s BCM vote failed errno=%d\n", res, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
