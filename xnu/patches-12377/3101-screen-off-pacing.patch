diff --git a/bsd/dev/sweet_board.h b/bsd/dev/sweet_board.h
index 3d9c06a..76c8c28 100644
--- a/bsd/dev/sweet_board.h
+++ b/bsd/dev/sweet_board.h
@@ -76,4 +76,42 @@ sweet_board_beryllium(void)
 	return cached == 1;
 }
 
+/*
+ * 3101: screen-off pacing. Nothing in this kernel has a device interrupt (but the wake timer of 3100): every driver
+ * looks at its hardware on a timer, and with the display off those timers were all the phone did: 2700 idle exits a
+ * second, never all eight cores idle for more than 2 ms (kern.sweet_wake, 2026-11-20). With the display off each
+ * driver now uses a longer period of its own, and its deadline is moved up to the next tick of one common grid
+ * (kern.sweet_poll_grid_ms), so that the polls of all drivers fall on the same instants and the time between them is
+ * one long stretch in which the cores, and with 3100 the cluster, can stay powered down. kern.sweet_pace=0 switches
+ * all of it off (every period as with the display on).
+ */
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern int sweet_fb_display_off;        /* bsd/dev/sweet_fb.c */
+extern unsigned sweet_pace;             /* bsd/dev/sweet_cpufreq.c */
+extern uint64_t sweet_poll_grid_abs;    /* the grid in timebase ticks; 0: none */
+extern void clock_interval_to_deadline(uint32_t interval, uint32_t scale_factor, uint64_t *result);
+#ifdef __cplusplus
+}
+#endif
+
+static inline bool
+sweet_paced(void)
+{
+	return sweet_pace != 0 && __atomic_load_n(&sweet_fb_display_off, __ATOMIC_RELAXED) != 0;
+}
+
+/* The deadline of a poll `us` from now; `grid`: on the common grid's next tick at or after it */
+static inline uint64_t
+sweet_poll_deadline_us(uint64_t us, bool grid)
+{
+	uint64_t deadline, g = sweet_poll_grid_abs;
+	clock_interval_to_deadline((uint32_t)us, 1000 /* NSEC_PER_USEC */, &deadline);
+	if (grid && g != 0) {
+		deadline = (deadline + g - 1) / g * g;
+	}
+	return deadline;
+}
+
 #endif /* _SWEET_BOARD_H_ */
