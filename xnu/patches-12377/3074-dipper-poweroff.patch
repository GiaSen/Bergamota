 	}
 	if (sid == 0) {
-		/* PON spare (reboot reason); RTC alarm data 0x6140-0x6143 (the RTC offset, sweet_rtc_set) */
-		return (addr == 0x088fu && len == 1) || (addr >= 0x6140u && addr + len <= 0x6144u);
+		/* PON spare (reboot reason); 3074: PON PS_HOLD_RST_CTL/CTL2 (the power-off type, sweet_reboot_poweroff);
+		 * RTC alarm data 0x6140-0x6143 (the RTC offset, sweet_rtc_set) */
+		return ((addr == 0x088fu || addr == 0x085au || addr == 0x085bu) && len == 1) ||
+		       (addr >= 0x6140u && addr + len <= 0x6144u);
 	}
 	if (sid != 3) {
 		return false;
