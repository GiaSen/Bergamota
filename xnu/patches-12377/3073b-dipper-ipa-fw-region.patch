 static int ipa_rx_chan;
+/* 3073b: where stage 3 asks TrustZone to put ipa_fws, and how much (0: the image's extent rounded up to 4 KB) */
+static uint32_t ipa_fw_pa = IPA_FW_PA, ipa_fw_size;
 
 static inline uint32_t
 ipa_rd(uint32_t off)
