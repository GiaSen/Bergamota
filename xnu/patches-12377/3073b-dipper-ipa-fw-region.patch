+	/* the downstream DT's two regions: ips_fw_region 0x8c400000 (64 KB, qcom,ipa_fws's memory-region), ipa_gsi_region
+	 * 0x8c410000 (20 KB, where HakiOS's OnePlus 6T port had TrustZone take it) */
+	uint32_t room = ipa_fw_pa == 0x8c400000u ? 0x10000u : ipa_fw_pa == 0x8c410000u ? 0x5000u : 0;
+	uint32_t size = ipa_fw_size ? ipa_fw_size : ((hi - lo + 0xfffu) & ~0xfffu);
+	if (lo == ~0u || hi - lo > size || size > room) {
+		ipa_fail("ipa_fws: segments %#x..%#x, size %#x, region %#x with %#x bytes: no", lo, hi, size, ipa_fw_pa, room);
 		goto out;
