+/*
+ * 3040: one PAS call for another peripheral (the audio DSP is pas id 1; bsd/dev/dipper_audio.c). cmd 1 INIT_IMAGE,
+ * 2 MEM_SETUP, 5 AUTH_AND_RESET, 6 SHUTDOWN; arginfo as SCM_ARGS. 0 = done with status and result 0, 1 = an error
+ * from TrustZone, -1 = the call did not complete (interrupted or busy for good: make no further calls).
+ */
+int
+sweet_scm_pas(uint32_t pas_id, uint32_t cmd, uint32_t arginfo, uint64_t arg1, uint64_t arg2)
+{
+	struct scm_regs r;
+	const struct scm_regs initial = {
+		{ SCM_64 | SCM_SIP | 0x0200u | cmd, arginfo, pas_id, arg1, arg2, 0, 0 }
+	};
+	__asm__ volatile ("dsb sy" ::: "memory");
+	bool done = scm_invoke(&initial, false, &r);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("SWEET PAS: id %u cmd %u args %#llx/%#llx: completed=%u status=%d result=%d\n", pas_id, cmd, arg1, arg2, done,
+	    (int32_t)r.a[0], (int32_t)r.a[1]);
+	sweet_log_sync();
+	if (!done) {
+		return -1;
+	}
+	return (int32_t)r.a[0] == 0 && (int32_t)r.a[1] == 0 ? 0 : 1;
+}
