+/*
+ * 3006: the previous frame has not latched, so the back buffer may still be on the panel. Only with the gate poll on, and
+ * only for a while: present()'s bounded waitLatch takes over if the latch never comes. Called with fLock held.
+ */
+bool
+AppleCLCD::latchBlocks(uint64_t now)
+{
+	if (fGateTimer == NULL || !sweet_fb_gatepoll || !fFlip || fLastFlush == 0 || latchedNow()) {
+		return false;
+	}
+	uint64_t cap;
+	nanoseconds_to_absolutetime(34 * NSEC_PER_MSEC, &cap);
+	return now - fPendAbs <= cap;
+}
+
+/* 3006: see fGateTimer. Same work loop as the vsync timer, so the two never run at once. */
+void
+AppleCLCD::gateFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	AppleCLCD *fb = (AppleCLCD *)owner;
+	SweetSurface *taken[4] = {};
+
+	if (fb->fPowerOff || !sweet_fb_gatepoll) {
+		return;         /* the vsync tick takes it */
+	}
+	uint64_t now = mach_absolute_time();
+	IOLockLock(fb->fLock);
+	if (!fb->fDirty) {
+		IOLockUnlock(fb->fLock);
+		return;
+	}
+	if (fb->latchBlocks(now) || !fb->gpuGateOpen(now)) {
+		IOLockUnlock(fb->fLock);
+		sender->setTimeoutUS(1000);
+		return;
+	}
+	uint8_t *rec = (uint8_t *)IOMallocData(SWEET_FB_SWAP_REC_SIZE);
+	if (rec == NULL) {
+		IOLockUnlock(fb->fLock);
+		return;         /* the vsync tick takes it */
+	}
+	memcpy(rec, fb->fPending, SWEET_FB_SWAP_REC_SIZE);
+	fb->fDirty = false;
+	memcpy(taken, fb->fPendHold, sizeof(taken));
+	bzero(fb->fPendHold, sizeof(fb->fPendHold));
+	IOLockUnlock(fb->fLock);
+	fb->present(rec);
+	IOFreeData(rec, SWEET_FB_SWAP_REC_SIZE);
+	sweet_hold_release(taken);      /* copied: CA may render into them again */
+}
