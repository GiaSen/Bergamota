-		FR_LOG("apps_std stat \"%s\" -> %s%d, %llu bytes\n", name, r < 0 ? "errno " : "", r < 0 ? -r : 0, r < 0 ? 0 : sz);
+		if (r < 0 || !fs_quiet(name)) {
