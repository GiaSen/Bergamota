+/* 3071: the PD's registry reads and socinfo reads are counted, not logged one by one */
+static bool
+fs_quiet(const char *name)
+{
+	return fs_soc_leaf(name) != NULL || strncmp(name, "/mnt/vendor/persist/sensors/registry/registry/", 46) == 0;
+}
+
+/* 3071: writes go to the iOS copy, and only under persist/sensors (the PD's registry); the file is created or truncated */
+static bool
+fs_writable(const char *name, char *path, size_t cap)
+{
+	static const char pfx[] = SS_FILES "/mnt/vendor/persist/sensors/";
+	return fs_path(name, path, cap) && strncmp(path, pfx, sizeof(pfx) - 1) == 0;
+}
+
+static int
+fs_open_write(const char *name)
+{
+	char path[256];
+	if (!fs_writable(name, path, sizeof(path))) {
+		return -EPERM;
+	}
+	int i = fs_alloc(name);
+	if (i < 0) {
+		return -EMFILE;
+	}
+	fs[i].write = true;
+	fs[i].cap = 4096;
+	fs[i].data = kalloc_data(fs[i].cap, Z_WAITOK | Z_ZERO);
+	if (!fs[i].data) {
+		fs_free((unsigned)i);
+		return -ENOMEM;
+	}
+	return i + 3;
+}
+
+static int
+fs_append(struct fs_file *f, const uint8_t *d, uint32_t n)
+{
+	if (f->size + n > FS_FILE_MAX) {
+		return EFBIG;
+	}
+	if (f->size + n > f->cap) {
+		uint32_t cap = f->cap;
+		while (cap < f->size + n) {
+			cap *= 2;
+		}
+		uint8_t *nd = kalloc_data(cap, Z_WAITOK | Z_ZERO);
+		if (!nd) {
+			return ENOMEM;
+		}
+		memcpy(nd, f->data, f->size);
+		kfree_data(f->data, f->cap);
+		f->data = nd;
+		f->cap = cap;
+	}
+	memcpy(f->data + f->size, d, n);
+	f->size += n;
+	return 0;
+}
+
+static int
+fs_commit(struct fs_file *f)
+{
+	char path[256];
+	if (!fs_writable(f->name, path, sizeof(path))) {
+		return EPERM;
+	}
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int err = vnode_open(path, O_CREAT | O_TRUNC | FWRITE | O_NOFOLLOW, S_IRUSR | S_IWUSR, VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+	if (err) {
+		return err;
+	}
+	int resid = 0;
+	if (f->size) {
+		err = vn_rdwr(UIO_WRITE, vp, (caddr_t)f->data, (int)f->size, 0, UIO_SYSSPACE, IO_NODELOCKED | IO_UNIT,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	}
+	int err2 = vnode_close(vp, FWRITE, ctx);
+	return err ? err : resid ? EIO : err2;
+}
