+/*
+ * ---- 3071: QMI pass-through to the SLPI's services (S3), for tools/sweetnet/sweetssc: the sensors' QMI front end is
+ * SNS client service 400 (requests 0x20 carry a protobuf sns_client_request; reports come back as indications 0x21 /
+ * 0x22). Same shape as the modem's kern.sweet_qmi (3057): one request per sysctl call (kern.sweet_ssc_qmi, root): in
+ * {u32 service, u32 instance or ~0, QMI message: u8 type, u16 txn, u16 msg, u16 len, TLVs}; the thread sends it from
+ * client port QR_SSQ_PORT with its own transaction id and fixes the length; out = the response (type 2). One request
+ * at a time (EBUSY), 5 s timeout. Indications to the port go to a ring (kern.sweet_ssc_ind); the SLPI's announced
+ * services are in kern.sweet_ssc_services. Over QRTR the port is one QMI client: the SNS service gives it one client id.
+ */
+#define QR_SSQ_PORT             0x4020u
+#define SSQ_SVC_MAX             24u
+#define SSQ_REQ_MAX             1024u
+#define SSQ_RSP_MAX             4096u
+#define SSQ_IND_RING            64u
+#define SSQ_IND_MAX             2048u
+static LCK_GRP_DECLARE(ssq_grp, "sweet_ssc_qmi");
+static LCK_MTX_DECLARE(ssq_lock, &ssq_grp);
+static struct {
+	struct {
+		uint32_t svc, vi, node, port;
+	} srv[SSQ_SVC_MAX];
+	unsigned nsrv;
+	bool busy, queued, sent, done;
+	uint32_t svc, inst, node, port, req_len, rsp_len;
+	uint16_t txn;
+	int err;
+	unsigned sent_ms;
+	uint64_t requests, responses, timeouts, indications;
+	uint8_t req[SSQ_REQ_MAX], rsp[SSQ_RSP_MAX];
+	struct {
+		uint32_t seq, ms, len;
+		uint8_t b[SSQ_IND_MAX];
+	} ind[SSQ_IND_RING];
+	uint32_t ind_head;
+} ssq;
+
+static void
+ssq_note(const uint32_t v[5], bool add)
+{
+	unsigned i;
+	lck_mtx_lock(&ssq_lock);
+	for (i = 0; i < ssq.nsrv; i++) {
+		if (ssq.srv[i].node == v[3] && ssq.srv[i].port == v[4]) {
+			break;
+		}
+	}
+	if (add && (i < ssq.nsrv || ssq.nsrv < SSQ_SVC_MAX)) {
+		if (i == ssq.nsrv) {
+			ssq.nsrv++;
+		}
+		ssq.srv[i].svc = v[1];
+		ssq.srv[i].vi = v[2];
+		ssq.srv[i].node = v[3];
+		ssq.srv[i].port = v[4];
+	} else if (!add && i < ssq.nsrv) {
+		ssq.srv[i] = ssq.srv[--ssq.nsrv];
+	}
+	lck_mtx_unlock(&ssq_lock);
+}
+
+/* the thread: send a queued request, or give up on one that was not answered */
+static void
+ssq_pump(void)
+{
+	if (!ssq.queued && !(ssq.sent && !ssq.done)) {
+		return;
+	}
+	lck_mtx_lock(&ssq_lock);
+	if (ssq.queued) {
+		unsigned i;
+		ssq.queued = false;
+		for (i = 0; i < ssq.nsrv; i++) {
+			if (ssq.srv[i].svc == ssq.svc && (ssq.inst == 0xffffffffu || (ssq.srv[i].vi >> 8) == ssq.inst)) {
+				break;
+			}
+		}
+		if (i == ssq.nsrv) {
+			ssq.err = ENOENT;
+			ssq.done = true;
+			thread_wakeup(&ssq);
+		} else {
+			ssq.node = ssq.srv[i].node;
+			ssq.port = ssq.srv[i].port;
+			ssq.txn = (uint16_t)(ssq.txn + 1 ? ssq.txn + 1 : 1);
+			memcpy(ssq.req + 1, &ssq.txn, 2);
+			ssq.sent = true;
+			ssq.sent_ms = sg_ms();
+			ssq.requests++;
+			if (!qs_send(Q_DATA, QR_SSQ_PORT, ssq.node, ssq.port, ssq.req, ssq.req_len)) {
+				ssq.err = EIO;
+				ssq.done = true;
+				thread_wakeup(&ssq);
+			}
+		}
+	} else if (ssq.sent && !ssq.done && sg_ms() > ssq.sent_ms + 5000) {
+		ssq.timeouts++;
+		ssq.err = ETIMEDOUT;
+		ssq.done = true;
+		thread_wakeup(&ssq);
+	}
+	lck_mtx_unlock(&ssq_lock);
+}
+
+static void
+ssq_rx(uint32_t node, uint32_t port, const uint8_t *p, uint32_t len)
+{
+	uint16_t txn;
+	if (len < 7) {
+		return;
+	}
+	memcpy(&txn, p + 1, 2);
+	lck_mtx_lock(&ssq_lock);
+	if (p[0] == 2 && ssq.sent && !ssq.done && txn == ssq.txn && node == ssq.node && port == ssq.port) {
+		ssq.rsp_len = MIN(len, SSQ_RSP_MAX);
+		memcpy(ssq.rsp, p, ssq.rsp_len);
+		ssq.err = 0;
+		ssq.done = true;
+		ssq.responses++;
+		thread_wakeup(&ssq);
+	} else if (p[0] == 4) {
+		__typeof__(ssq.ind[0]) *e = &ssq.ind[ssq.ind_head % SSQ_IND_RING];
+		e->seq = ssq.ind_head;
+		e->ms = sg_ms();
+		e->len = MIN(len, SSQ_IND_MAX);
+		memcpy(e->b, p, e->len);
+		ssq.ind_head++;
+		ssq.indications++;
+	} else {
+		SG_LOG("qmi: %u-byte message type %u txn %u from %u:%#x not expected\n", len, p[0], txn, node, port);
+	}
+	lck_mtx_unlock(&ssq_lock);
+}
+
+static int
+ssq_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	uint8_t in[8 + SSQ_REQ_MAX], *out = NULL;
+	uint32_t n, out_len = 0;
+	uint64_t deadline;
+	int err;
+	if (!req->newptr || req->newlen < 8 + 7 || req->newlen > sizeof(in)) {
+		return EINVAL;
+	}
+	if (!sg.up || sg.fatal) {
+		return ENXIO;
+	}
+	n = (uint32_t)req->newlen;
+	if ((err = SYSCTL_IN(req, in, n))) {
+		return err;
+	}
+	lck_mtx_lock(&ssq_lock);
+	if (ssq.busy) {
+		lck_mtx_unlock(&ssq_lock);
+		return EBUSY;
+	}
+	ssq.busy = true;
+	memcpy(&ssq.svc, in, 4);
+	memcpy(&ssq.inst, in + 4, 4);
+	ssq.req_len = n - 8;
+	memcpy(ssq.req, in + 8, ssq.req_len);
+	ssq.req[0] = 0;                         /* QMI_REQUEST */
+	uint16_t body = (uint16_t)(ssq.req_len - 7);
+	memcpy(ssq.req + 5, &body, 2);
+	ssq.sent = false;
+	ssq.done = false;
+	ssq.err = 0;
+	ssq.queued = true;
+	clock_interval_to_deadline(6000, NSEC_PER_MSEC, &deadline);
+	while (!ssq.done) {
+		if (lck_mtx_sleep_deadline(&ssq_lock, LCK_SLEEP_DEFAULT, (event_t)&ssq, THREAD_UNINT, deadline) == THREAD_TIMED_OUT) {
+			break;
+		}
+	}
+	err = ssq.done ? ssq.err : ETIMEDOUT;
+	if (!err) {
+		out_len = ssq.rsp_len;
+		out = kalloc_data(out_len, Z_WAITOK);
+		if (out) {
+			memcpy(out, ssq.rsp, out_len);
+		} else {
+			err = ENOMEM;
+		}
+	}
+	ssq.queued = false;
+	ssq.done = true;                        /* a late answer is dropped */
+	ssq.busy = false;
+	lck_mtx_unlock(&ssq_lock);
+	if (err) {
+		return err;
+	}
+	err = SYSCTL_OUT(req, out, out_len);
+	kfree_data(out, out_len);
+	return err;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_ssc_qmi, CTLTYPE_OPAQUE | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0, ssq_sysctl, "S",
+    "QMI request to an SLPI service: in u32 service, u32 instance (~0 any), QMI message; out the response (3071)");
+
+static int
+ssq_services_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	char *buf = kalloc_data(2048, Z_WAITOK | Z_ZERO);
+	size_t off;
+	int err;
+	if (!buf) {
+		return ENOMEM;
+	}
+	lck_mtx_lock(&ssq_lock);
+	off = (size_t)snprintf(buf, 2048, "requests %llu responses %llu timeouts %llu indications %llu\n", ssq.requests,
+	    ssq.responses, ssq.timeouts, ssq.indications);
+	for (unsigned i = 0; i < ssq.nsrv && off < 1900; i++) {
+		off += (size_t)snprintf(buf + off, 2048 - off, "%#x v%u i%u %u:%#x\n", ssq.srv[i].svc, ssq.srv[i].vi & 0xff,
+		    ssq.srv[i].vi >> 8, ssq.srv[i].node, ssq.srv[i].port);
+	}
+	lck_mtx_unlock(&ssq_lock);
+	err = SYSCTL_OUT(req, buf, strnlen(buf, 2048) + 1);
+	kfree_data(buf, 2048);
+	return err;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_ssc_services, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0, ssq_services_sysctl,
+    "A", "SLPI QMI services: service version instance node:port (3071)");
+
+/* out: u32 next sequence number, u32 count, then oldest first {u32 seq, u32 ms since the SLPI started, u32 len, bytes} */
+static int
