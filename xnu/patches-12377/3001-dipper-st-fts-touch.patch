+static int
+stfts_write(const uint8_t *cmd, unsigned n)
+{
+	if (st.bitbang) {
+		return bb_xfer(STFTS_ADDR, cmd, n, NULL, 0);
+	}
+	return touch_msg(STFTS_ADDR, cmd, n, NULL, 0, false);
+}
+
+/* One FIFO event; ev[0] == STFTS_EVT_NONE when the FIFO is empty. */
+static int
+stfts_event(uint8_t *ev)
+{
+	memset(ev, 0, STFTS_EVENT);
+	return touch_read(STFTS_ADDR, STFTS_FIFO_READ, false, ev, STFTS_EVENT);
+}
+
+/*
+ * ST FTS events (fts_521 fts_*_pointer_event_handler): [0] event id, [1] touch id (7:4) | touch type (3:0),
+ * X = [3](3:0) << 8 | [2], Y = [4] << 4 | [3](7:4), panel pixels. The FIFO is drained (at most its depth) and
+ * the contacts that changed are reported; the IC sends LEAVE for every lift, so nothing is held or guessed.
+ * Hover and palm contacts count as lifted. Events other than touches are logged (the first 32).
+ */
+static int
+touch_stfts(void)
+{
+	static unsigned logged;
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+	uint32_t mask = st.active;
+	bool changed = false, bad = false;
+	int err = 0;
+	for (unsigned id = 0; id < TOUCH_MAX; ++id) {
+		x[id] = st.x[id];
+		y[id] = st.y[id];
+	}
+	for (unsigned n = 0; n < STFTS_FIFO_DEPTH; ++n) {
+		uint8_t ev[STFTS_EVENT];
+		err = stfts_event(ev);
+		if (err || ev[0] == STFTS_EVT_NONE) {
+			break;
+		}
+		if (touch_trace) {
+			uint64_t ns;
+			absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+			printf("FTS %llu %c %02x %02x %02x %02x %02x %02x %02x %02x\n", ns / 1000000ull, touch_trace_why,
+			    ev[0], ev[1], ev[2], ev[3], ev[4], ev[5], ev[6], ev[7]);
+		}
+		unsigned id = ev[1] >> 4, type = ev[1] & 15u;
+		if (ev[0] == STFTS_EVT_ENTER || ev[0] == STFTS_EVT_MOTION || ev[0] == STFTS_EVT_LEAVE) {
+			if (id >= TOUCH_MAX) {
+				bad = true;
+				continue;
+			}
+			uint32_t bit = 1u << id;
+			if (ev[0] == STFTS_EVT_LEAVE || type == STFTS_TYPE_HOVER || type == STFTS_TYPE_PALM) {
+				changed |= (mask & bit) != 0;
+				mask &= ~bit;
+				continue;
+			}
+			unsigned px = ((unsigned)(ev[3] & 15u) << 8) | ev[2];
+			unsigned py = ((unsigned)ev[4] << 4) | (ev[3] >> 4);
+			if (px >= tb->w || py >= tb->h) {
+				bad = true;
+				continue;
+			}
+			mask |= bit;
+			x[id] = (int)px;
+			y[id] = (int)py;
+			changed = true;
+		} else if (logged < 32) {
+			logged++;
+			printf("SWEET TOUCH: FTS event %02x %02x %02x %02x %02x %02x %02x %02x\n",
+			    ev[0], ev[1], ev[2], ev[3], ev[4], ev[5], ev[6], ev[7]);
+		}
+	}
+	if (changed) {
+		touch_report(mask, x, y);
+	}
+	return err ? err : (bad ? EIO : 0);
+}
