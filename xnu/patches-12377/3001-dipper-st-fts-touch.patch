+/*
+ * Mi 8: ST FTS. Power as fts_521 fts_enable_reg (vdd, then avdd) with the IC held in reset, then reset (its own pin),
+ * CONTROLLER_READY, the IC's interrupts and active multi-touch scanning.
+ */
+static bool
+touch_dipper_start(void)
+{
+	static const uint8_t ier[] = { 0xfa, 0x20, 0x00, 0x00, 0x29, 0x41 }; /* FTS_CMD_HW_REG_W ADDR_IER IER_ENABLE */
+	static const uint8_t scan[] = { 0xa0, 0x00, 0x01 };                  /* FTS_CMD_SCAN_MODE ACTIVE, MULTI_TOUCH */
+	uint8_t ev[STFTS_EVENT];
+	printf("SWEET TOUCH: TLMM rst%u=%#x/%#x irq%u=%#x/%#x sda=%#x scl=%#x\n",
+	    tb->rst, touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->rst)), touch_rd(st.gpio, TOUCH_GPIO_IO(tb->rst)),
+	    tb->irq, touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->irq)), touch_rd(st.gpio, TOUCH_GPIO_IO(tb->irq)),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->sda)), touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->scl)));
+	touch_gpio(tb->rst, 0, 0, 0, true, false);        /* hold the IC in reset while it is powered */
+	touch_gpio(tb->irq, 0, 3, 0, false, false);       /* input, pull-up: active low */
+	if (st.bitbang) {
+		/* GPIO function, inputs (released) until a bit is driven low */
+		touch_gpio(tb->sda, 0, 0, 0, false, false);
+		touch_gpio(tb->scl, 0, 0, 0, false, false);
+	} else {
+		touch_gpio(tb->sda, tb->mux, 0, 0, false, false);
+		touch_gpio(tb->scl, tb->mux, 0, 0, false, false);
+	}
+	dipper_bus_log("unpowered");
+	dipper_l28_log("before");
+	touch_gpio(DIPPER_TS_VDD, 0, 0, 0, true, true);   /* vdd: disp_vddio_vreg on */
+	touch_wait(5);                                    /* its startup-delay-us 4000 */
+	int pe = sweet_rpmh_vreg_set("ldoa28", 3300, true);
+	touch_wait(10);
+	printf("SWEET TOUCH: vdd (GPIO %u) on, avdd L28 3300 mV RPMh vote err=%d\n", DIPPER_TS_VDD, pe);
+	dipper_l28_log("after");
+	dipper_bus_log("powered");
+	if (st.bitbang && (!bb_get(tb->sda) || !bb_get(tb->scl))) {
+		/* no external pull-up on a line: use the TLMM's own (bb_line only toggles output enable) */
+		touch_gpio(tb->sda, 0, 3, 0, false, false);
+		touch_gpio(tb->scl, 0, 3, 0, false, false);
+		touch_wait(1);
+		dipper_bus_log("internal pull-ups");
+	}
+	/* fts_system_reset with a reset GPIO: low 10 ms, high, then the IC announces CONTROLLER_READY */
+	touch_wait(10);
+	touch_gpio(tb->rst, 0, 0, 0, true, true);
+	int err = ENXIO;
+	bool ready = false;
+	unsigned t;
+	for (t = 0; t < 50 && !ready; ++t) {               /* up to ~1 s */
+		touch_wait(20);
+		err = stfts_event(ev);
+		ready = !err && ev[0] == STFTS_EVT_READY;
+	}
+	printf("SWEET TOUCH: ST FTS at %#x after reset (%u ms): err=%d event %02x %02x %02x %02x %02x %02x %02x %02x%s\n",
+	    STFTS_ADDR, t * 20u, err, ev[0], ev[1], ev[2], ev[3], ev[4], ev[5], ev[6], ev[7],
+	    ready ? " = controller ready" : "");
+	if (err) {
+		printf("SWEET TOUCH: no ST FTS at %#x (err=%d dead=%d); stopping\n", STFTS_ADDR, err, st.dead);
+		return false;
+	}
+	int e1 = stfts_write(ier, sizeof(ier));
+	int e2 = stfts_write(scan, sizeof(scan));
+	printf("SWEET TOUCH: ST FTS interrupts on err=%d, active multi-touch scan err=%d\n", e1, e2);
+	if (e1 || e2 || st.dead) {
+		return false;
+	}
+	/* the echo/status events of those commands */
+	for (unsigned n = 0; n < STFTS_FIFO_DEPTH; ++n) {
+		if (stfts_event(ev) || ev[0] == STFTS_EVT_NONE) {
+			break;
+		}
+		printf("SWEET TOUCH: FTS start event %02x %02x %02x %02x %02x %02x %02x %02x\n",
+		    ev[0], ev[1], ev[2], ev[3], ev[4], ev[5], ev[6], ev[7]);
+	}
+	st.kind = TOUCH_STFTS;
+	return true;
+}
