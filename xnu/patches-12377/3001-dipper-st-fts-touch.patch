+/* PM8998 LDO28 as the PMIC sees it (read only): STATUS1 bit 7 = ready, EN_CTL bit 7 = enabled. */
+static void
+dipper_l28_log(const char *when)
+{
+	uint8_t st1 = 0xff, vlo = 0xff, vhi = 0xff, en = 0xff;
+	bool ok = sweet_spmi_init() == 0 && sweet_spmi_read(1, DIPPER_L28 + 0x08, &st1) == 0 &&
+	    sweet_spmi_read(1, DIPPER_L28 + 0x40, &vlo) == 0 && sweet_spmi_read(1, DIPPER_L28 + 0x41, &vhi) == 0 &&
+	    sweet_spmi_read(1, DIPPER_L28 + 0x46, &en) == 0;
+	printf("SWEET TOUCH: L28 %s: %s status1=%#x vset=%#x/%#x en_ctl=%#x\n", when, ok ? "read" : "unreadable",
+	    st1, vlo, vhi, en);
+}
+
+static void
+dipper_bus_log(const char *when)
+{
+	printf("SWEET TOUCH: bus %s: sda=%u scl=%u irq=%u (cfg %#x %#x %#x) vdd%u=%#x/%#x\n", when,
+	    bb_get(tb->sda), bb_get(tb->scl), touch_rd(st.gpio, TOUCH_GPIO_IO(tb->irq)) & 1u,
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->sda)), touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->scl)),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->irq)), DIPPER_TS_VDD,
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(DIPPER_TS_VDD)), touch_rd(st.gpio, TOUCH_GPIO_IO(DIPPER_TS_VDD)));
+}
