 /* ---------------------------------------------------------------- thread */
 
+static void
+wl_bt_thread(void *arg, wait_result_t wr)
+{
+	(void)arg;
+	(void)wr;
+	wl.bt_thread = current_thread();
+	wl_bt();
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/*
+ * 3011: sweetwlan=5 sweetbt=1, Bluetooth next to the WLAN service. The two share the chip's rails and nothing else: the BT
+ * stage has its UART (SE6, its clocks and pins) and fields of wl, the service has the modem and the copy engines.
+ * The service waits for the BT rail votes: RPMh answers EBUSY to a second caller, and its own rails would then fail.
+ */
+static void
+wl_bt_start(void)
+{
+	thread_t thread;
+	unsigned ms = 0;
+
+	if (kernel_thread_start(wl_bt_thread, NULL, &thread) != KERN_SUCCESS) {
+		printf("SWEET BT: kernel_thread_start failed: Wi-Fi only\n");
+		return;
+	}
+	thread_deallocate(thread);
+	while (!wl.bt_rails_done && ms < 5000) {
+		wl_sleep(10);
+		ms += 10;
+	}
+	printf("SWEET BT: running next to the WLAN service, rail votes over after %u ms\n", ms);
+}
+
 static void
 wl_thread(void *arg, wait_result_t wr)
 {
