@@ -148,8 +148,13 @@ bt_hci_connected(void)
  * parameters, which bcm_vsc.c's sub-opcode checker accepts (it returns true on an empty reply);
  * a read that needs its parameters still fails in bluetoothd and shows up in the log. Every rewrite and every other non-zero status is logged (own budget), so the
  * next missing command shows up even after the packet trace budget is spent.
+ *
+ * iOS 26 reads longer replies: AssertFail "ByteStream_NumReadBytesAvail(*pBs) >= 4" at bcm_vsc.c:1021 (0xfe3b, one second
+ * after each start) and :196 (0xfdf0 sub-opcode 0x11, BD_VSC_OLYMPIC_READ_ENHANCED_PROFILING_STATS, about 30 s after it)
+ * with 16 bytes, an abort each time (Mi 8, boot 24). The largest Command Complete passes every length check; the
+ * zeros read as empty counts.
  */
-#define BT_COMPAT_PAD   16u             /* parameter bytes in a rewritten Command Complete */
+#define BT_COMPAT_PAD   251u            /* parameter bytes in a rewritten Command Complete: 255 with the 4 of the header */
 
 /* First parameter byte of the last few commands sent, by opcode (for rewritten replies). */
 static struct { uint16_t op; uint8_t p0; } bt_last_cmd[8];
@@ -239,7 +244,7 @@ static void
 bt_pend_check(void)
 {
 	uint64_t ns;
-	uint8_t ev[7 + 16];
+	uint8_t ev[7 + BT_COMPAT_PAD];
 	unsigned i;
 
 	if (!bt.compat || !os_atomic_load(&bt_pend.on, acquire)) {
@@ -252,7 +257,7 @@ bt_pend_check(void)
 	os_atomic_store(&bt_pend.on, false, relaxed);
 	ev[0] = 4;
 	ev[1] = 0x0e;
-	ev[2] = 4 + 16;
+	ev[2] = 4 + BT_COMPAT_PAD;
 	ev[3] = 1;
 	ev[4] = (uint8_t)bt_pend.op;
 	ev[5] = (uint8_t)(bt_pend.op >> 8);
