 	uint32_t req = __atomic_load_n(&fb->fBlReq, __ATOMIC_ACQUIRE);
 	if (fb->fBlOK && req != fb->fBlReqApplied && fb->fBlPos == SWEET_FB_BL_STEPS) {
 		/* 0243: iOS's brightness, on both WLED strings (the floor keeps the panel readable: 0 is iOS's "off", which is
@@ -2633,6 +2642,103 @@ AppleCLCD::blInit(void)
  * (fBlOK cleared, the original value written back as well as possible) when
  * a write fails or does not read back: the caller blacks the screen out instead.
  */
+/*
+ * 3016 Mi 8: the panel sets its own brightness (EA8074, DCS 0x51, 10 bits, most significant byte first: Linux
+ * mipi_dsi_dcs_set_display_brightness_ss; WLED MOD_EN reads 0). The command goes through the DSI host's FIFO, as
+ * dsi_ctrl_hw_cmn_kickoff_fifo_command does: no DMA buffer, nothing for the SMMU. The host sends it between two frames of
+ * the command-mode stream, so the vsync timer starts it and looks for "done" on a later tick and never spins here.
+ */
+#define SWEET_DSI0_PA           0x0ae94000u
+#define SWEET_DSI_SIZE          0x400u
+#define DSI_R_CTRL              0x004u
+#define DSI_R_STATUS            0x008u
+#define DSI_R_FIFO_STATUS       0x00cu
+#define DSI_R_DMA_CTRL          0x03cu
+#define DSI_R_DMA_LENGTH        0x04cu
+#define DSI_R_TRIG_CTRL         0x084u
+#define DSI_R_DMA_SW_TRIGGER    0x090u
+#define DSI_R_INT_CTRL          0x110u
+#define DSI_R_TPG_CTRL          0x15cu
+#define DSI_R_TPG_DMA_INIT      0x17cu
+#define DSI_R_TPG_FIFO_RESET    0x1ecu
+#define DSI_DMA_DONE            (1u << 0)
+#define DSI_INT_ERROR           (1u << 24)
+#define DSI_DMA_EMBEDDED        (1u << 28)
+#define DSI_DMA_LPM             (1u << 26)
+#define DSI_TPG_CUSTOM_FIFO     ((1u << 1) | (1u << 2) | (3u << 16))
+#define DSI_TRIG_SW             4u
+#define SWEET_DSI_BL_MIN        2u      /* qcom,mdss-dsi-bl-min-level */
+#define SWEET_DSI_BL_MAX        1023u
+#define SWEET_DSI_WAIT_TICKS    12u
+
+void
+AppleCLCD::dsiInit(void)
+{
+	if (!sweet_board_is("xiaomi,dipper") || (fDsi = ml_io_map(SWEET_DSI0_PA, SWEET_DSI_SIZE)) == 0) {
+		return;
+	}
+	IOLog("SWEET DSI: ctrl 0x%08x status 0x%08x fifo 0x%08x dma_ctrl 0x%08x trig 0x%08x int 0x%08x tpg 0x%08x\n",
+	    mdp_rd(fDsi, DSI_R_CTRL), mdp_rd(fDsi, DSI_R_STATUS), mdp_rd(fDsi, DSI_R_FIFO_STATUS), mdp_rd(fDsi, DSI_R_DMA_CTRL),
+	    mdp_rd(fDsi, DSI_R_TRIG_CTRL), mdp_rd(fDsi, DSI_R_INT_CTRL), mdp_rd(fDsi, DSI_R_TPG_CTRL));
+}
+
+void
+AppleCLCD::dsiTick(void)
+{
+	if (fDsi == 0) {
+		return;
+	}
+	if (fDsiBusy) {
+		uint32_t in = mdp_rd(fDsi, DSI_R_INT_CTRL);
+		if (!(in & DSI_DMA_DONE) && ++fDsiWait < SWEET_DSI_WAIT_TICKS) {
+			return;
+		}
+		if (in & DSI_DMA_DONE) {
+			mdp_wr(fDsi, DSI_R_INT_CTRL, (in | DSI_DMA_DONE) & ~DSI_INT_ERROR);
+		} else if (fDsiFailed++ < 8) {
+			IOLog("SWEET DSI: brightness %u not sent: ctrl 0x%08x status 0x%08x fifo 0x%08x dma_ctrl 0x%08x trig 0x%08x int 0x%08x tpg 0x%08x\n",
+			    fDsiLevel, mdp_rd(fDsi, DSI_R_CTRL), mdp_rd(fDsi, DSI_R_STATUS), mdp_rd(fDsi, DSI_R_FIFO_STATUS),
+			    mdp_rd(fDsi, DSI_R_DMA_CTRL), mdp_rd(fDsi, DSI_R_TRIG_CTRL), in, mdp_rd(fDsi, DSI_R_TPG_CTRL));
+		}
+		mdp_wr(fDsi, DSI_R_TPG_CTRL, 0);
+		mdp_wr(fDsi, DSI_R_TPG_FIFO_RESET, 1);
+		__asm__ volatile ("dsb osh" ::: "memory");
+		IODelay(1);
+		mdp_wr(fDsi, DSI_R_TPG_FIFO_RESET, 0);
+		fDsiBusy = false;
+	}
+	uint32_t want = (uint32_t)__atomic_load_n(&sweet_fb_bl, __ATOMIC_RELAXED);
+	if (want == 0) {
+		uint32_t req = __atomic_load_n(&fBlReq, __ATOMIC_ACQUIRE);
+		if (req == 0) {
+			return;         /* nobody asked yet: the level ABL left stays */
+		}
+		want = (req & 0xfffu) >> 2;
+	}
+	want = want < SWEET_DSI_BL_MIN ? SWEET_DSI_BL_MIN : (want > SWEET_DSI_BL_MAX ? SWEET_DSI_BL_MAX : want);
+	if (want == fDsiLevel) {
+		return;
+	}
+	uint32_t trig = mdp_rd(fDsi, DSI_R_TRIG_CTRL);
+	if ((trig & 7u) != DSI_TRIG_SW) {
+		mdp_wr(fDsi, DSI_R_TRIG_CTRL, (trig & ~7u) | DSI_TRIG_SW);
+	}
+	mdp_wr(fDsi, DSI_R_TPG_CTRL, DSI_TPG_CUSTOM_FIFO);
+	/* long DCS write 0x39, 3 bytes, last command: { WC low, WC high, DI, BIT(7) | BIT(6) }, then 0x51 hi lo and padding */
+	mdp_wr(fDsi, DSI_R_TPG_DMA_INIT, 0xc0390003u);
+	mdp_wr(fDsi, DSI_R_TPG_DMA_INIT, 0xff000051u | ((want >> 8) << 8) | ((want & 0xffu) << 16));
+	mdp_wr(fDsi, DSI_R_DMA_CTRL, (mdp_rd(fDsi, DSI_R_DMA_CTRL) & ~((1u << 31) | (1u << 30))) | DSI_DMA_LPM | DSI_DMA_EMBEDDED);
+	mdp_wr(fDsi, DSI_R_DMA_LENGTH, 8);
+	__asm__ volatile ("dsb osh" ::: "memory");
+	mdp_wr(fDsi, DSI_R_DMA_SW_TRIGGER, 1);
+	fDsiBusy = true;
+	fDsiWait = 0;
+	fDsiLevel = want;
+	if (fDsiSent++ < 8) {
+		IOLog("SWEET DSI: brightness %u\n", want);
+	}
+}
