@@ -1044,6 +1052,7 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 	if (fb->fBlOK && fb->fBlPos != SWEET_FB_BL_STEPS && !dirty) {
