+/*
+ * 3039: the first refused realtime requests, with the values asked and the limits (how the HAL IO thread's request
+ * below was found).
+ */
+static void
+sweet_rt_refused(thread_t thread, thread_policy_flavor_t flavor, thread_policy_t policy_info, mach_msg_type_number_t count,
+    kern_return_t kr, const char *where)
+{
+	static int sweet_rt_logged;
+
+	if (count < THREAD_TIME_CONSTRAINT_POLICY_COUNT || os_atomic_inc(&sweet_rt_logged, relaxed) > 32) {
+		return;
+	}
+	thread_time_constraint_policy_t info = (thread_time_constraint_policy_t)policy_info;
+	printf("SWEET RT: tid %llu flavor %d refused %d (%s): period %u computation %u constraint %u preemptible %d; "
+	    "min %u max %u; wi flags 0x%x\n", thread_tid(thread), flavor, kr, where, info->period, info->computation,
+	    info->constraint, info->preemptible, min_rt_quantum, max_rt_quantum,
+	    (unsigned)os_atomic_load(&thread->th_work_interval_flags, relaxed));
+}
+
