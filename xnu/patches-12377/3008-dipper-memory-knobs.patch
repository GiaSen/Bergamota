+SYSCTL_INT(_kern, OID_AUTO, sweet_cpu_anim_khz, CTLFLAG_RW | CTLFLAG_LOCKED, &cf_anim_khz, 0, "A75 floor while the GPU sees frames");
+
+/*
+ * 3008: the memory side of the CPU, all off unless asked for, each switchable while the system runs. Android's kernel does
+ * all three (live DT qcom,cpucc@0x17d41000 + qcom,l3-cpu*, qcom,llcc@1100000, qcom,cpubw + qcom,llccbw); this one did none:
+ * DRAM reads take 240-270 ns (110-130 expected), and 4 MB is as slow as 64 MB, so the 2.8 MB system cache does nothing.
+ */
+#define OSM_L3_PA               0x17d41000u
+#define LLCC_PA                 0x1100000u
+#define LLCC_SIZE               0x250000u
+#define LLCC_BCAST              0x200000u       /* qcom,llcc-broadcast-off */
+#define LLCC_COMMON_STATUS0     0x3000cu
+#define LLCC_ACT_CTRL(n)        (LLCC_BCAST + (n) * 0x1000u)
+#define LLCC_STATUS(n)          (LLCC_BCAST + 4u + (n) * 0x1000u)
+#define LLCC_ATTR0(n)           (LLCC_BCAST + 0x21000u + 8u * (n))
+#define LLCC_ATTR1(n)           (LLCC_BCAST + 0x21004u + 8u * (n))
+
+/* llcc-sdm845.c: the slices Android activates at probe */
+static const struct { uint32_t sid, kb, prio, bonus, res; } llcc_slices[] = {
+	{ 1, 2816, 1, 0xffc, 0x2 },     /* cpuss */
+	{ 13, 256, 2, 0x0, 0x1 },       /* mmuhwt */
+};
+static vm_offset_t llcc_base, l3_base;
+static int sweet_llcc_on, sweet_bus_mbps;
+static int sweet_mem_lock;
+
+static uint32_t
+mm_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+mm_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* llcc-slice.c llcc_update_act_ctrl: trigger, clear the trigger, wait for the opposite state to leave */
+static int
+llcc_act(uint32_t sid, uint32_t opcode, uint32_t gone)
+{
+	uint32_t v = (opcode << 1) | 1u;
+	mm_wr(llcc_base, LLCC_ACT_CTRL(sid), v);
+	mm_wr(llcc_base, LLCC_ACT_CTRL(sid), v & ~1u);
+	for (unsigned i = 0; i < 1000; i++) {
+		if (!(mm_rd(llcc_base, LLCC_STATUS(sid)) & gone)) {
+			return 0;
+		}
+		delay(1);
+	}
+	return ETIMEDOUT;
+}
+
+static int
+llcc_set(int on)
+{
+	if (llcc_base == 0) {
+		llcc_base = ml_io_map(LLCC_PA, LLCC_SIZE);
+	}
+	if (llcc_base == 0) {
+		return ENOMEM;
+	}
+	uint32_t banks = mm_rd(llcc_base, LLCC_COMMON_STATUS0) >> 28;
+	if (banks == 0 || banks > 4) {
+		printf("SWEET LLCC: %u banks, not touched\n", banks);
+		return ENODEV;
+	}
+	int error = 0;
+	for (unsigned i = 0; i < sizeof(llcc_slices) / sizeof(llcc_slices[0]); i++) {
+		uint32_t sid = llcc_slices[i].sid;
+		uint32_t a0 = mm_rd(llcc_base, LLCC_ATTR0(sid)), a1 = mm_rd(llcc_base, LLCC_ATTR1(sid)), st0 = mm_rd(llcc_base, LLCC_STATUS(sid));
+		int e;
+		if (on) {
+			/* probe_target_ways 0, fixed_size 0, cache_mode 0 for both */
+			mm_wr(llcc_base, LLCC_ATTR1(sid), (llcc_slices[i].prio << 4) | ((llcc_slices[i].kb * 1024u / banks / 64u) << 16));
+			mm_wr(llcc_base, LLCC_ATTR0(sid), (llcc_slices[i].res & 0xfffu) | (llcc_slices[i].bonus << 16));
+			e = llcc_act(sid, 1u, 2u);
+		} else {
+			e = llcc_act(sid, 2u, 1u);
+		}
+		printf("SWEET LLCC: slice %u %s: banks %u, before attr0 %#x attr1 %#x status %#x, now attr0 %#x attr1 %#x status %#x, err %d\n", sid,
+		    on ? "on" : "off", banks, a0, a1, st0, mm_rd(llcc_base, LLCC_ATTR0(sid)), mm_rd(llcc_base, LLCC_ATTR1(sid)), mm_rd(llcc_base, LLCC_STATUS(sid)), e);
+		if (e) {
+			error = e;
+		}
+	}
+	return error;
+}
+
+static int
+sysctl_sweet_llcc SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2)
+	int v = sweet_llcc_on, error = sysctl_handle_int(oidp, &v, 0, req);
+	if (error || !req->newptr) {
+		return error;
+	}
+	if (__atomic_exchange_n(&sweet_mem_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	error = llcc_set(v != 0);
+	if (!error) {
+		sweet_llcc_on = v != 0;
+	}
+	__atomic_store_n(&sweet_mem_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_llcc, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0, sysctl_sweet_llcc, "I", "CPU slices of the system cache");
+
+static int
+sysctl_sweet_bus SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2)
+	int v = sweet_bus_mbps, error = sysctl_handle_int(oidp, &v, 0, req);
+	if (error || !req->newptr) {
+		return error;
+	}
+	error = sweet_rpmh_bus_vote((unsigned)v);
+	if (!error) {
+		sweet_bus_mbps = v;
+	}
+	return error;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_bus_mbps, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0, sysctl_sweet_bus, "I", "bus vote CPU -> DDR, MB/s (7216 = top)");
+
+/* L3 clock: the OSM's third domain, same layout as the CPU domains. Reads the state; a write selects a LUT row, -1 logs the table. */
+static int
+sysctl_sweet_l3 SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2)
+	if (l3_base == 0) {
+		l3_base = ml_io_map(OSM_L3_PA, CPUFREQ_WINDOW);
+	}
+	if (l3_base == 0) {
+		return ENOMEM;
+	}
+	int v = (int)mm_rd(l3_base, CPUFREQ_PERF_STATE), error = sysctl_handle_int(oidp, &v, 0, req);
+	if (error || !req->newptr) {
+		return error;
+	}
+	if (v < 0) {
+		uint32_t prev = 0;
+		printf("SWEET L3: enable %#x state %u\n", mm_rd(l3_base, CPUFREQ_ENABLE), mm_rd(l3_base, CPUFREQ_PERF_STATE));
+		for (uint32_t i = 0; i < CPUFREQ_LUT_MAX; i++) {
+			uint32_t row = mm_rd(l3_base, CPUFREQ_FREQ_LUT + i * CPUFREQ_LUT_ROW);
+			uint32_t khz = (row >> 30) ? (row & 0xffu) * CPUFREQ_XO_KHZ : CPUFREQ_ALT_KHZ;
+			if (khz == prev) {
+				break;
+			}
+			prev = khz;
+			printf("SWEET L3: row %u %u kHz\n", i, khz);
+		}
+		return 0;
+	}
+	if ((uint32_t)v >= CPUFREQ_LUT_MAX) {
+		return EINVAL;
+	}
+	mm_wr(l3_base, CPUFREQ_PERF_STATE, (uint32_t)v);
+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_l3, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0, sysctl_sweet_l3, "I", "L3 clock LUT row");
+
