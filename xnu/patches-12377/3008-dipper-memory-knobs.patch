  * dev_pm_genpd_set_performance_state(pd, INT_MAX) for proxy votes does; max=false
  * votes hlvl 0 (off). Active set only, like the VRM votes above.
  */
+/*
+ * 3008: bus clock vote, the path CPU -> memory as Linux's interconnect driver computes it (bcm-voter.c: peak * aux width /
+ * node bus width * 1000 / aux unit). Peak only, active set only, one vote standing until the next. Nothing in this kernel
+ * voted before (only the GMU's own table, vote 0), so these buses ran at what the bootloader left. mbps = 7216 is DDR's top.
+ */
+int
+sweet_rpmh_bus_vote(unsigned mbps)
+{
+	static const struct { const char *res; unsigned buswidth; } bcms[] = {
+		{ "MC0", 4 },   /* ebi */
+		{ "SH0", 16 },  /* qns_llcc */
+		{ "SH5", 32 },  /* qnm_apps */
+	};
+	if (!sweet_board_beryllium() || mbps == 0 || mbps > 20000) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t addrs[3], vals[3];
+	unsigned n = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	for (unsigned i = 0; !error && i < 3; i++) {
+		uint32_t address = 0, aux = 0, aux_len = 0;
+		if (rh_lookup_slave(bcms[i].res, RH_BCM, &address, &aux, &aux_len) != 0 || aux_len < 8) {
+			printf("SWEET RPMH: %s not usable (aux %u bytes), not voted\n", bcms[i].res, aux_len);
+			continue;
+		}
+		uint32_t unit = rh_db16(aux) | ((uint32_t)rh_db16(aux + 2) << 16), width = rh_db16(aux + 4);
+		if (unit == 0 || width == 0) {
+			continue;
+		}
+		uint64_t y = (uint64_t)mbps * 1000 * width / bcms[i].buswidth * 1000 / unit;
+		y = y > 0x3fffu ? 0x3fffu : (y == 0 ? 1 : y);
+		addrs[n] = address;
+		vals[n] = (1u << 30) | (1u << 29) | (uint32_t)y;        /* commit, valid, x = 0, y */
+		printf("SWEET RPMH: bus vote %s addr %#x unit %u width %u: %u MB/s -> y %llu\n", bcms[i].res, address, unit, width, mbps, y);
+		n++;
+	}
+	if (!error) {
+		error = n ? rh_cmds(addrs, vals, n) : ENODEV;
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: bus vote %u MB/s failed errno=%d\n", mbps, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
 int
 sweet_rpmh_arc_vote(const char *res, bool max)
 {
