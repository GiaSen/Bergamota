+/*
+ * 3099: who wakes the phone. Counters only, read with kern.sweet_wake (a write clears them).
+ *  - per CPU, how often it left idle;
+ *  - the windows in which every CPU was in idle at once, by length: the cluster and its cache can only power down in
+ *    such a window, and the DT's llcc-off wants about 10 ms of it (latency 6562 us, time overhead 5000 us);
+ *  - every timer that expired, by its function (a thread's wait timer also by the thread, or by the process for a user
+ *    thread; a delayed thread call by the call's function), and how often it ran within SWEET_WAKE_CREDIT_US of its
+ *    CPU leaving idle: that timer woke the CPU.
+ * The notes run with interrupts masked (cpu_idle, the reset path, the timer interrupt). The table is lock-free: a slot
+ * is claimed by its key with one compare-and-swap, its counters are only ever added to.
+ */
+#define SWEET_WAKE_SLOTS        192
+#define SWEET_WAKE_CREDIT_US    500
+#define SWEET_WAKE_PID          (1ULL << 40)
+#define SWEET_ALLIDLE_BUCKETS   9
+
+struct sweet_wake_slot {
+	uint64_t        key;            /* 0: free */
+	uintptr_t       func;
+	uint64_t        who;            /* thread id, or pid | SWEET_WAKE_PID, or 0 */
+	uint64_t        fired;
+	uint64_t        woke;
+	uint32_t        kind;           /* 0 timer call, 1 delayed thread call */
+	char            name[28];       /* a kernel thread's name, taken when the slot was claimed */
+};
+struct sweet_idle_cpu {
+	uint64_t        exit_abs;       /* the last time this CPU left idle; 0 once a timer took the credit */
+	uint64_t        exits;
+	uint64_t        by_timer;       /* exits a timer took the credit for */
+	uint32_t        in;
+} __attribute__((aligned(128)));
+
+static struct sweet_wake_slot sweet_wake_tab[SWEET_WAKE_SLOTS];
+static struct sweet_idle_cpu sweet_idle_cpu[MAX_CPUS];
+static uint64_t sweet_wake_lost, sweet_wake_since, sweet_wake_credit_abs;
+static uint32_t sweet_idle_n, sweet_idle_ncpus;
+static uint64_t sweet_allidle_start;
+static const uint32_t sweet_allidle_us[SWEET_ALLIDLE_BUCKETS - 1] = { 500, 1000, 2000, 5000, 10000, 20000, 50000, 100000 };
+static struct { uint64_t count, abs; } sweet_allidle[SWEET_ALLIDLE_BUCKETS];
+
+void sweet_idle_enter_note(cpu_data_t *cdp);
+void
+sweet_idle_enter_note(cpu_data_t *cdp)
+{
+	unsigned int cpu = (unsigned int)cdp->cpu_number;
+	if (cpu >= MAX_CPUS || sweet_idle_cpu[cpu].in) {
+		return;
+	}
+	if (__improbable(sweet_idle_ncpus == 0)) {
+		uint64_t a;
+		nanoseconds_to_absolutetime((uint64_t)SWEET_WAKE_CREDIT_US * NSEC_PER_USEC, &a);
+		sweet_wake_credit_abs = a;
+		sweet_wake_since = mach_absolute_time();
+		sweet_idle_ncpus = ml_get_topology_info()->num_cpus;
+	}
+	sweet_idle_cpu[cpu].in = 1;
+	if (os_atomic_inc(&sweet_idle_n, relaxed) == sweet_idle_ncpus) {
+		os_atomic_store(&sweet_allidle_start, mach_absolute_time(), relaxed);
+	}
+}
+
+void sweet_idle_exit_note(cpu_data_t *cdp);
+void
+sweet_idle_exit_note(cpu_data_t *cdp)
+{
+	unsigned int cpu = (unsigned int)cdp->cpu_number;
+	if (cpu >= MAX_CPUS || !sweet_idle_cpu[cpu].in) {
+		return;
+	}
+	uint64_t now = mach_absolute_time();
+	sweet_idle_cpu[cpu].in = 0;
+	sweet_idle_cpu[cpu].exits++;
+	sweet_idle_cpu[cpu].exit_abs = now;
+	/* only the CPU that ends a window sees the full count, so it is the window's one writer */
+	if (os_atomic_dec_orig(&sweet_idle_n, relaxed) == sweet_idle_ncpus) {
+		uint64_t start = os_atomic_xchg(&sweet_allidle_start, 0, relaxed), ns;
+		if (start != 0 && now > start) {
+			unsigned b = 0;
+			absolutetime_to_nanoseconds(now - start, &ns);
+			while (b < SWEET_ALLIDLE_BUCKETS - 1 && ns / NSEC_PER_USEC >= sweet_allidle_us[b]) {
+				b++;
+			}
+			sweet_allidle[b].count++;
+			sweet_allidle[b].abs += now - start;
+		}
+	}
+}
+
+/* A timer is about to run (timer_queue_expire, thread_call_delayed_timer): interrupts masked */
