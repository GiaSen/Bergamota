+void
+sweet_wake_note(void *func, void *param0, int kind)
+{
+	uint64_t who = 0;
+	thread_t named = THREAD_NULL;
+
+	if (__improbable(sweet_idle_ncpus == 0)) {
+		return;
+	}
+	if (kind == 0 && func == (void *)thread_timer_expire && param0 != NULL) {
+		thread_t th = (thread_t)param0;
+		named = th;
+		task_t task = get_threadtask(th);
+		int pid = task != TASK_NULL ? task_pid(task) : 0;
+		who = pid > 0 ? ((uint64_t)pid | SWEET_WAKE_PID) : th->thread_id;
+	}
+	uint64_t key = ((uint64_t)(uintptr_t)func * 0x9E3779B97F4A7C15ULL) ^ (who * 0xC2B2AE3D27D4EB4FULL) ^ (uint64_t)kind;
+	if (key == 0) {
+		key = 1;
+	}
+	struct sweet_wake_slot *s = NULL;
+	for (unsigned i = 0, at = (unsigned)(key >> 40); i < SWEET_WAKE_SLOTS; i++, at++) {
+		struct sweet_wake_slot *t = &sweet_wake_tab[at % SWEET_WAKE_SLOTS];
+		uint64_t k = os_atomic_load(&t->key, relaxed);
+		if (k == 0 && os_atomic_cmpxchgv(&t->key, 0, key, &k, relaxed)) {
+			t->func = (uintptr_t)func;
+			t->who = who;
+			t->kind = (uint32_t)kind;
+			if (named != THREAD_NULL && !(who & SWEET_WAKE_PID)) {
+				extern void bsd_getthreadname(void *uth, char *buffer);
+				char full[64];          /* MAXTHREADNAMESIZE */
+				full[0] = 0;
+				bsd_getthreadname(get_bsdthread_info(named), full);
+				strlcpy(t->name, full, sizeof(t->name));
+			}
+			k = key;
+		}
+		if (k == key) {
+			s = t;
+			break;
+		}
+	}
+	if (s == NULL) {
+		os_atomic_inc(&sweet_wake_lost, relaxed);
+		return;
+	}
+	os_atomic_inc(&s->fired, relaxed);
+	unsigned int cpu = (unsigned int)cpu_number();
+	if (cpu < MAX_CPUS) {
+		uint64_t out = sweet_idle_cpu[cpu].exit_abs;
+		if (out != 0) {
+			sweet_idle_cpu[cpu].exit_abs = 0;
+			if (mach_absolute_time() - out < sweet_wake_credit_abs) {
+				sweet_idle_cpu[cpu].by_timer++;
+				os_atomic_inc(&s->woke, relaxed);
+			}
+		}
+	}
+}
+
+/* the report; clear: forget everything counted so far */
+int sweet_wake_stats(char *buf, size_t len, bool clear);
+int
+sweet_wake_stats(char *buf, size_t len, bool clear)
+{
+	size_t off = 0;
+	uint64_t ns, total = 0, total_n = 0;
+	static const char *const edge[SWEET_ALLIDLE_BUCKETS] = { "<0.5", "<1", "<2", "<5", "<10", "<20", "<50", "<100", ">=100" };
+#define SW_CAT(...) do { int n_ = snprintf(buf + off, off < len ? len - off : 0, __VA_ARGS__); if (n_ > 0) { off += (size_t)n_; } if (off >= len) { off = len - 1; } } while (0)
+
+	if (clear) {
+		for (unsigned i = 0; i < SWEET_WAKE_SLOTS; i++) {
+			sweet_wake_tab[i].fired = sweet_wake_tab[i].woke = 0;
+		}
+		for (unsigned c = 0; c < MAX_CPUS; c++) {
+			sweet_idle_cpu[c].exits = sweet_idle_cpu[c].by_timer = 0;
+		}
+		bzero(sweet_allidle, sizeof(sweet_allidle));
+		sweet_wake_lost = 0;
+		sweet_wake_since = mach_absolute_time();
+		buf[0] = 0;
+		return 0;
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - sweet_wake_since, &ns);
+	SW_CAT("sweet_wake v1 ms=%llu cpus=%u lost=%llu slide=0x%lx\nexits", ns / NSEC_PER_MSEC, sweet_idle_ncpus, sweet_wake_lost,
+	    (unsigned long)vm_kernel_slide);
+	for (unsigned c = 0; c < MAX_CPUS; c++) {
+		if (CpuDataEntries[c].cpu_data_vaddr != NULL) {
+			SW_CAT(" cpu%u=%llu/%llu", c, sweet_idle_cpu[c].exits, sweet_idle_cpu[c].by_timer);
+		}
+	}
+	SW_CAT("\nallidle_ms(count:ms)");
+	for (unsigned b = 0; b < SWEET_ALLIDLE_BUCKETS; b++) {
+		absolutetime_to_nanoseconds(sweet_allidle[b].abs, &ns);
+		SW_CAT(" %s=%llu:%llu", edge[b], sweet_allidle[b].count, ns / NSEC_PER_MSEC);
+		total += ns / NSEC_PER_MSEC;
+		total_n += sweet_allidle[b].count;
+	}
+	SW_CAT(" all=%llu:%llu\n", total_n, total);
+	/* the timers, busiest first (by wake-ups, then by expiries): a selection over a copy of the counts */
+	static uint8_t shown[SWEET_WAKE_SLOTS];
+	bzero(shown, sizeof(shown));
+	for (unsigned line = 0; line < 40; line++) {
+		int best = -1;
+		for (unsigned i = 0; i < SWEET_WAKE_SLOTS; i++) {
+			const struct sweet_wake_slot *t = &sweet_wake_tab[i];
+			if (t->key == 0 || shown[i] || t->fired == 0) {
+				continue;
+			}
+			if (best < 0 || t->woke > sweet_wake_tab[best].woke ||
+			    (t->woke == sweet_wake_tab[best].woke && t->fired > sweet_wake_tab[best].fired)) {
+				best = (int)i;
+			}
+		}
+		if (best < 0) {
+			break;
+		}
+		shown[best] = 1;
+		const struct sweet_wake_slot *t = &sweet_wake_tab[best];
+		SW_CAT("%s 0x%lx", t->kind ? "call" : "timer", (unsigned long)VM_KERNEL_UNSLIDE(t->func));
+		if (t->who & SWEET_WAKE_PID) {
+			SW_CAT(" pid=%llu", t->who & ~SWEET_WAKE_PID);
+		} else if (t->who) {
+			SW_CAT(" tid=0x%llx", t->who);
+			if (t->name[0]) {
+				char n2[sizeof(t->name)];
+				strlcpy(n2, t->name, sizeof(n2));
+				for (char *c = n2; *c; c++) {
+					if (*c == ' ') {
+						*c = '_';
+					}
+				}
+				SW_CAT(" name=%s", n2);
+			}
+		}
+		SW_CAT(" fired=%llu woke=%llu\n", t->fired, t->woke);
+	}
+#undef SW_CAT
+	return 0;
+}
+
+/*
+ * 3099: what the firmware's PSCI says of itself, for the cluster work: the version, and PSCI_FEATURES of the calls a
+ * deeper sleep would use. Reads only; called from a sysctl. A negative number is PSCI's "not supported" (-1).
+ */
+static int64_t
+sweet_smc4(uint64_t fid, uint64_t a1, uint64_t a2, uint64_t a3)
+{
+	register uint64_t x0 __asm__("x0") = fid;
+	register uint64_t x1 __asm__("x1") = a1;
+	register uint64_t x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = a3;
+	boolean_t intr = ml_set_interrupts_enabled(FALSE);
+	__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	         "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+	         "x14", "x15", "x16", "x17", "cc", "memory");
+	ml_set_interrupts_enabled(intr);
+	return (int64_t)x0;
+}
+
+int sweet_psci_info(char *buf, size_t len);
+int
+sweet_psci_info(char *buf, size_t len)
+{
+	static const struct { const char *name; uint32_t fid; } calls[] = {
+		{ "cpu_suspend", 0xC4000001u }, { "set_suspend_mode", 0x8400000Fu }, { "system_suspend", 0xC400000Eu },
+		{ "stat_residency", 0xC4000010u }, { "stat_count", 0xC4000011u }, { "cpu_default_suspend", 0xC400000Cu },
+		{ "node_hw_state", 0xC400000Du },
+	};
+	int32_t version = (int32_t)sweet_smc4(0x84000000u, 0, 0, 0);
+	size_t off = 0;
+	int n = snprintf(buf, len, "sweet_psci v1 version=%d.%d", (version >> 16) & 0x7fff, version & 0xffff);
+	off = n > 0 ? (size_t)n : 0;
+	if (version >= 0x10000) {       /* PSCI_FEATURES is from 1.0 on */
+		for (unsigned i = 0; i < sizeof(calls) / sizeof(calls[0]) && off < len; i++) {
+			n = snprintf(buf + off, len - off, " %s=%d", calls[i].name, (int32_t)sweet_smc4(0x8400000Au, calls[i].fid, 0, 0));
+			off += n > 0 ? (size_t)n : 0;
+		}
+	}
+	if (off < len) {
+		(void)snprintf(buf + off, len - off, "\n");
+	}
+	return 0;
+}
 #endif /* SWEET */
 
 
