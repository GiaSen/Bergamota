+/*
+ * 3053: the last 256 touch events as dispatched to backboardd, for finger-to-screen latency (sysctl kern.sweet_touch_trace,
+ * bsd/dev/sweet_fb.c): absolute microseconds (mach_absolute_time, the clock of kern.sweet_fb_trace's base_us), d/m/u, slot.
+ */
+#define SWEET_TOUCH_TRACE_N 256
+static struct { uint64_t abs; uint8_t kind, finger; } sweet_touch_tr[SWEET_TOUCH_TRACE_N];
+static uint32_t sweet_touch_tr_n;
+
+static void
+sweet_touch_trace_note(uint64_t abs, char kind, int finger)
+{
+	uint32_t i = __atomic_fetch_add(&sweet_touch_tr_n, 1, __ATOMIC_RELAXED) % SWEET_TOUCH_TRACE_N;
+	sweet_touch_tr[i].kind = (uint8_t)kind;
+	sweet_touch_tr[i].finger = (uint8_t)finger;
+	__atomic_store_n(&sweet_touch_tr[i].abs, abs, __ATOMIC_RELEASE);
+}
+
+extern "C" size_t sweet_touch_trace_text(char *buf, size_t cap);
+size_t
+sweet_touch_trace_text(char *buf, size_t cap)
+{
+	uint32_t end = __atomic_load_n(&sweet_touch_tr_n, __ATOMIC_ACQUIRE);
+	uint32_t start = end > SWEET_TOUCH_TRACE_N ? end - SWEET_TOUCH_TRACE_N : 0;
+	size_t n = (size_t)snprintf(buf, cap, "abs_us kind finger (d down, m move, u up; oldest first)\n");
+	for (uint32_t k = start; k < end && n < cap; k++) {
+		uint32_t i = k % SWEET_TOUCH_TRACE_N;
+		uint64_t ns;
+		absolutetime_to_nanoseconds(__atomic_load_n(&sweet_touch_tr[i].abs, __ATOMIC_ACQUIRE), &ns);
+		n += (size_t)snprintf(buf + n, cap - n, "%llu %c %u\n", ns / 1000ull, sweet_touch_tr[i].kind, sweet_touch_tr[i].finger);
+	}
+	return n < cap ? n : cap;
+}
+
