+size_t sweet_touch_trace_text(char *buf, size_t cap);
+
+static int sweet_touch_trace_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	const size_t cap = 12288;
+	if (req->oldptr == USER_ADDR_NULL) {
+		return SYSCTL_OUT(req, NULL, cap);
+	}
+	char *buf = kalloc_data(cap, Z_WAITOK | Z_ZERO);
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	size_t n = sweet_touch_trace_text(buf, cap - 1);
+	int err = SYSCTL_OUT(req, buf, n + 1);
+	kfree_data(buf, cap);
+	return err;
+}
+
