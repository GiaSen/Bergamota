 #define CE_CURRENT_SRRI         0x44u
 #define CE_CURRENT_DRRI         0x48u
 #define CE_HOST_IE              0x2cu           /* wcn3990_host_ie_cc: bit 0 copy complete */
+#define CE_MISC_IE              0x34u           /* wcn3990_misc_reg: error interrupt enables, 0x3e0 */
+#define CE_MISC_IS              0x38u
+#define CE_MISC_ERR             0x3e0u
 #define CE_HOST_IS              0x30u           /* wcn3990_wm_reg: bit 0 copy complete, bits 1-4 watermarks */
 #define CE_HOST_IS_ALL          0x1fu
 #define CE_SRC_WM               0x4cu
@@ -4059,16 +4062,29 @@ wce_desc(unsigned r, uint32_t i)
  */
 static int wce_sleep;
 static uint32_t wce_is_clears, wce_irqs, wce_irq_pending, wce_irq_waits;
+static uint32_t wce_irq_run[12], wce_irq_storms, wce_irq_errs, wce_irq_err_last, wce_irq_noerr;
 SYSCTL_INT(_kern, OID_AUTO, sweet_wlan_ce_sleep, CTLFLAG_RW | CTLFLAG_LOCKED, &wce_sleep, 0,
     "1: enable and service the Wi-Fi copy engines' interrupts, so the hardware and the modem can sleep; stays until a reboot (3117, 3120)");
 SYSCTL_UINT(_kern, OID_AUTO, sweet_wlan_ce_clears, CTLFLAG_RD | CTLFLAG_LOCKED, &wce_is_clears, 0, "copy engine status clears so far (3117)");
 SYSCTL_UINT(_kern, OID_AUTO, sweet_wlan_ce_irqs, CTLFLAG_RD | CTLFLAG_LOCKED, &wce_irqs, 0, "copy engine interrupts taken (3120)");
 SYSCTL_UINT(_kern, OID_AUTO, sweet_wlan_ce_waits, CTLFLAG_RD | CTLFLAG_LOCKED, &wce_irq_waits, 0,
