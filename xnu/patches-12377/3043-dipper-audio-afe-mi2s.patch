+/* ---- stage 4: AFE */
+
+/*
+ * One APR command (header + payload) to svc on the DSP, then wait up to ms for its answer: the packet with opcode want
+ * (status 0; payload in gl.apr_pl), or APR_BASIC_RSP_RESULT for this command (its status). -1: nothing came.
+ */
+static int
+apr_request(unsigned svc, uint32_t token, uint32_t opcode, const void *pl, uint32_t len, uint32_t want, unsigned ms)
+{
+	uint8_t pkt[APR_HDR_SIZE + 128];
+	if (len > sizeof(pkt) - APR_HDR_SIZE) {
+		return -1;
+	}
+	struct au_apr_hdr h = { APR_HDR_FIELD_SEQ_CMD, (uint16_t)(APR_HDR_SIZE + len), (uint8_t)svc, APR_DOMAIN_APPS, 0,
+	    (uint8_t)svc, APR_DOMAIN_ADSP, 0, token, opcode };
+	memcpy(pkt, &h, APR_HDR_SIZE);
+	if (len) {
+		memcpy(pkt + APR_HDR_SIZE, pl, len);
+	}
+	gl.apr_answered = false;
+	gl.apr_rsp_of = 0;
+	if (!gl_send(CH_APR, pkt, APR_HDR_SIZE + len)) {
+		printf("SWEET AUDIO: APR %#x not sent (no free intent from the DSP)\n", opcode);
+		return -1;
+	}
+	for (unsigned w = 0; w < ms && !gl.bad; w += 2) {
+		au_sleep(2);
+		gl_poll();
+		if (gl.apr_answered && gl.apr_opcode == APR_BASIC_RSP_RESULT && gl.apr_rsp_of == opcode) {
+			return (int)gl.apr_status;
+		}
+		if (gl.apr_answered && want != APR_BASIC_RSP_RESULT && gl.apr_opcode == want) {
+			return 0;
+		}
+	}
+	printf("SWEET AUDIO: APR %#x to svc %u: no answer in %u ms (the DSP %s the packet's intent %u)\n", opcode, svc, ms,
+	    gl.last_ri_done ? "handed back" : "never handed back", gl.last_riid);
+	return -1;
+}
+
+static int
+apr_cmd(unsigned svc, uint32_t token, uint32_t opcode, const void *pl, uint32_t len)
+{
+	return apr_request(svc, token, opcode, pl, len, APR_BASIC_RSP_RESULT, 3000);
+}
+
+/* AVCS_CMD_GET_FWK_VERSION (q6core.c): the AVS build and the static services it runs, with their API versions */
+static void
+au_fwk_version(void)
+{
+	if (apr_request(APR_SVC_ADSP_CORE, 2, AVCS_GET_FWK_VERSION, NULL, 0, AVCS_GET_FWK_VERSION_RSP, 2000) != 0 ||
+	    gl.apr_opcode != AVCS_GET_FWK_VERSION_RSP || gl.apr_pl_len < 20) {
+		printf("SWEET AUDIO: AVCS framework version: no answer (last opcode %#x status %#x)\n", gl.apr_opcode, gl.apr_status);
+		return;
+	}
+	uint32_t v[5];
+	memcpy(v, gl.apr_pl, sizeof(v));
+	char out[200];
+	uint32_t o = 0;
+	for (uint32_t i = 0; i < v[4] && 20 + 8 * i + 8 <= gl.apr_pl_len && o < sizeof(out) - 24; i++) {
+		uint32_t s[2];
+		memcpy(s, gl.apr_pl + 20 + 8 * i, 8);
+		o += (uint32_t)snprintf(out + o, sizeof(out) - o, " %#x:v%u", s[0], s[1]);
+	}
+	printf("SWEET AUDIO: AVS build %u.%u.%u.%u, %u services (id:api):%s\n", v[0], v[1], v[2], v[3], v[4], out);
+}
+
+/* AFE_SVC_CMD_SET_PARAM (q6afe_set_param): one in-band parameter for the AFE service, e.g. a clock */
+static int
+afe_svc_param(uint32_t module, uint32_t param, const void *data, uint16_t size)
+{
+	struct {
+		uint32_t payload_size, addr_lsw, addr_msw, mem_map_handle;
+		uint32_t module_id, param_id;
+		uint16_t param_size, reserved;
+		uint8_t data[64];
+	} __attribute__((packed)) p = { 12u + size, 0, 0, 0, module, param, size, 0, { 0 } };
+	if (size > sizeof(p.data)) {
+		return -1;
+	}
+	memcpy(p.data, data, size);
+	return apr_cmd(APR_SVC_AFE, AFE_CLK_TOKEN, AFE_SVC_CMD_SET_PARAM, &p, 28u + size);
+}
+
+/* AFE_PORT_CMD_SET_PARAM_V2 (q6afe_port_set_param_v2): one in-band parameter for a port */
+static int
+afe_port_param(uint16_t port, uint32_t module, uint32_t param, const void *data, uint16_t size)
+{
+	struct {
+		uint16_t port_id, payload_size;
+		uint32_t addr_lsw, addr_msw, mem_map_handle;
+		uint32_t module_id, param_id;
+		uint16_t param_size, reserved;
+		uint8_t data[64];
+	} __attribute__((packed)) p = { port, (uint16_t)(12u + size), 0, 0, 0, module, param, size, 0, { 0 } };
+	if (size > sizeof(p.data)) {
+		return -1;
+	}
+	memcpy(p.data, data, size);
+	return apr_cmd(APR_SVC_AFE, port, AFE_PORT_CMD_SET_PARAM_V2, &p, 28u + size);
+}
+
+static int
+afe_port_cmd(uint16_t port, uint32_t opcode)
+{
+	struct { uint16_t port_id, reserved; } __attribute__((packed)) p = { port, 0 };
+	return apr_cmd(APR_SVC_AFE, port, opcode, &p, sizeof(p));
+}
+
+/* struct afe_clk_set: the bit clock of QUAT MI2S from LPASS, COUPLE_NO, root default; freq 0 = off */
+static int
+afe_mi2s_clock(uint32_t hz)
+{
+	struct {
+		uint32_t minor, clk_id, freq;
+		uint16_t attri, root;
+		uint32_t enable;
+	} c = { 1, AFE_CLK_QUAD_MI2S_IBIT, hz, 1, 0, hz != 0 };
+	_Static_assert(sizeof(c) == 20, "afe_clk_set is 20 bytes");
+	return afe_svc_param(AFE_MODULE_CLOCK_SET, AFE_PARAM_ID_CLOCK_SET, &c, sizeof(c));
+}
+
+static struct {
+	vm_offset_t tlmm;               /* gpio58..61 */
+	uint32_t orig[4];
+	bool saved;
+} ap;
+
+static uint32_t
+ap_rd(unsigned i, uint32_t reg)
+{
+	return *(volatile uint32_t *)(ap.tlmm + i * 0x1000u + reg);
+}
+
+/* sdm845-pinctrl.dtsi quat_mi2s_active + sd0/sd1: qua_mi2s, 8 mA, no pull (SCK, WS, SD0 to the amp, SD1 from it) */
+static bool
+ap_pins(bool on)
+{
+	if (!ap.tlmm && !(ap.tlmm = ml_io_map(AU_TLMM_NORTH_PA + AU_MI2S_PIN0 * 0x1000u, 4 * 0x1000u))) {
+		return false;
+	}
+	for (unsigned i = 0; i < 4; i++) {
+		if (!ap.saved) {
+			ap.orig[i] = ap_rd(i, 0);
+		}
+		uint32_t cfg = on ? (ap.orig[i] & ~TLMM_FUNC_PULL_DRV_MASK) | (AU_MI2S_FUNC << 2) | (3u << 6) : ap.orig[i];
+		*(volatile uint32_t *)(ap.tlmm + i * 0x1000u) = cfg;
+	}
+	ap.saved = true;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("SWEET AUDIO: QUAT MI2S pins gpio58-61 %s: %#x %#x %#x %#x\n", on ? "to qua_mi2s" : "restored", ap_rd(0, 0),
+	    ap_rd(1, 0), ap_rd(2, 0), ap_rd(3, 0));
+	return true;
+}
+
+/* the pads' input levels (GPIO_IN, bit 0 of the io register) sampled back to back: does the bus move */
+static void
+ap_sample_to(const char *when, char *text, size_t cap)
+{
+	static const char *const role[4] = { "SCK", "WS", "SD0", "SD1" };
+	if (!ap.tlmm && !(ap.tlmm = ml_io_map(AU_TLMM_NORTH_PA + AU_MI2S_PIN0 * 0x1000u, 4 * 0x1000u))) {
+		return;
+	}
+	unsigned ones[4] = { 0 }, edges[4] = { 0 }, last[4] = { 0 }, n = 20000;
+	uint64_t t0 = mach_absolute_time();
+	for (unsigned k = 0; k < n; k++) {
+		for (unsigned i = 0; i < 4; i++) {
+			unsigned v = ap_rd(i, 4) & 1u;
+			ones[i] += v;
+			edges[i] += k && v != last[i];
+			last[i] = v;
+		}
+	}
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	char out[160];
+	uint32_t o = 0;
+	for (unsigned i = 0; i < 4; i++) {
+		o += (uint32_t)snprintf(out + o, sizeof(out) - o, " %s %u%% high %u edges;", role[i], ones[i] * 100u / n, edges[i]);
+	}
+	if (text) {
+		snprintf(text, cap, "pins %s (%u samples in %llu us):%s cfg %#x %#x %#x %#x\n", when, n, ns / 1000, out,
+		    ap_rd(0, 0), ap_rd(1, 0), ap_rd(2, 0), ap_rd(3, 0));
+	} else {
+		printf("SWEET AUDIO: pins %s (%u samples in %llu us):%s\n", when, n, ns / 1000, out);
+	}
+}
+
+static void
+ap_sample(const char *when)
+{
+	ap_sample_to(when, NULL, 0);
+}
+
+/* the speaker's I2S port with nothing routed to it: LPASS bit clock, I2S config, DEVICE_START; the DSP sends zeros */
+static bool
+au_afe(void)
+{
+	au_fwk_version();
+	if (!ap_pins(true)) {
+		return false;
+	}
+	ap_sample("before the port");
+	int st = -1;
+	for (unsigned tries = 0; tries < 3 && st == -1; tries++) {
+		st = afe_mi2s_clock(AU_BCLK);
+		printf("SWEET AUDIO: AFE clock QUAD_MI2S_IBIT %u Hz: status %d (try %u)\n", AU_BCLK, st, tries);
+	}
+	if (st != 0) {
+		/* anything the DSP still says, for 5 s */
+		for (unsigned w = 0; w < 5000 && !gl.bad; w += 5) {
+			au_sleep(5);
+			gl_poll();
+		}
+		(void)ap_pins(false);
+		sweet_log_sync();
+		return false;
+	}
+	struct {
+		uint32_t minor;
+		uint16_t bit_width, channel_mode, mono_stereo, ws_src;
+		uint32_t sample_rate;
