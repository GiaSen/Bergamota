+		    APR_DOMAIN_ADSP, 0, r.token, r.opcode };
+		memcpy(pkt, &h, APR_HDR_SIZE);
+		memcpy(pkt + APR_HDR_SIZE, in + sizeof(r), len);
+		lck_mtx_lock(&au_mtx);
+		gl.apr_answered = false;
+		gl.apr_rsp_of = 0;
+		bool sent = gl_send(r.chan ? CH_APR2 : CH_APR, pkt, APR_HDR_SIZE + len);
