+/* Why the last sr_raw() failed and the RTC_CTRL it read, for sr_explain() (the Mi 8 never logged a SWEET RTC line). */
+static const char *sr_why = "not read yet";
+static int sr_ctrl = -1;
+
 /* Raw RTC seconds, read twice over a byte-0 rollover. */
 static int
 sr_raw(uint32_t *raw)
 {
 	uint8_t ctrl = 0, b0 = 0;
-	if (!sweet_board_beryllium() || sweet_spmi_init() != 0 || sweet_spmi_read(0, SR_RTC_CTRL, &ctrl) != 0 ||
-	    !(ctrl & SR_EN)) {
+	if (!sweet_board_beryllium() || sweet_spmi_init() != 0) {
+		sr_why = "SPMI not ready";
+		return -1;
+	}
+	if (sweet_spmi_read(0, SR_RTC_CTRL, &ctrl) != 0) {
+		sr_why = "RTC_CTRL read failed";
+		return -1;
+	}
+	sr_ctrl = ctrl;
+	if (!(ctrl & SR_EN)) {
+		sr_why = "RTC not enabled (RTC_CTRL bit 7 clear)";
 		return -1;
 	}
 	for (int t = 0; t < 2; t++) {
 		if (sr_read32(SR_RTC_READ, raw) != 0 || sweet_spmi_read(0, SR_RTC_READ, &b0) != 0) {
+			sr_why = "RTC_READ read failed";
 			return -1;
 		}
 		if (b0 == (uint8_t)*raw) {
 			return 0;
 		}
 	}
+	sr_why = "RTC_READ rolled over on both reads";
 	return -1;
 }
 
+/* One line on why the RTC path gave up: the step, the RTC peripheral's APID and owner, RTC_CTRL. */
+static void
+sr_explain(const char *what)
+{
+	int apid = -1, owner = -1;
+	if (sp_ready) {
+		uint16_t a = sp_find_apid(SR_RTC_CTRL >> 8);
+		if (a != SP_NO_APID) {
+			apid = a;
+			owner = (int)(sp_rd(sp_cfg, 0x700u + 4u * a) & 7u);
+		}
+	}
+	printf("SWEET RTC: %s: %s (sid 0 peripheral 0x%x APID %d owner EE %d, RTC_CTRL %#x)\n", what, sr_why,
+	    SR_RTC_CTRL >> 8, apid, owner, sr_ctrl);
+}
