+static struct cam_seq_rec *cam_seq;
+static unsigned cam_seq_n;
+
+static vm_offset_t csiphy0, refgen;
+static vm_offset_t c4_buf;
+static uint64_t c4_buf_pa;
+static uint32_t c4_buf_iova;
