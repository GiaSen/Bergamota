+
+extern int sweet_rpmh_arc_vote(const char *res, bool max);                     /* sweet_rpmh.c */
+
+#define CAM_CSIPHY0_PA  0x0ac65000u
+#define CAM_REFGEN_PA   0x00ff1000u     /* qcom,refgen-regulator: the CSIPHYs' reference (only they name it in the live DT) */
+#define CC_PLL2         0x2000u
+#define CC_PLL3         0x3000u
+#define CC_CSIPHY0_CBCR 0x5020u
+#define CC_PHYTIMER0_CMD 0x5004u
+#define CC_PHYTIMER0_CBCR 0x501cu
+#define CC_MCLK0_M      0x400cu
+#define CC_MCLK0_N      0x4010u
+#define CC_MCLK0_D      0x4014u
+#define C4_W            1920u
+#define C4_H            1080u
+#define C4_STRIDE       (C4_W * 10u / 8u)       /* MIPI RAW10: 2400 bytes a line */
+#define C4_FRAME        (C4_STRIDE * C4_H)
+#define C4_GUARD        0x100000u               /* after the frame: must stay 0xa5 */
+#define C4_BUF          (C4_FRAME + C4_GUARD)
+#define C4_FRAMES       4u                      /* frames written before stopping (the last one is kept) */
+#define C4_SEQ_MAX      2048u
+#define C4_SETTLE       17u     /* Linux's csiphy_settle_cnt_calc: 534 Mb/s a lane (DDR 267 MHz), PHY timer 240 MHz */
+
+/* Fabia PLL registers (Linux clk-alpha-pll.c, msm-4.9 and mainline) */
+#define PLL_MODE        0x00u
+#define PLL_L           0x04u
+#define PLL_USER        0x0cu
+#define PLL_OPMODE      0x2cu
+#define PLL_FRAC        0x38u
+#define PLL_OUTCTRL     0x1u
+#define PLL_RESET_N     0x4u
+#define PLL_BYPASS_UPD  (1u << 23)
+#define PLL_LOCK_DET    (1u << 31)
+
+/* the sensor's register sequence (init + one mode) from tools/camera/camx_v1.py --seq, written by kern.sweet_cam_seq */
