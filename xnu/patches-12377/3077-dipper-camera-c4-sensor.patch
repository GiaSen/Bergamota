+	{ 0x043c, 0xb8, 0 }, { 0x0400, 0x91, 0 }, { 0x0408, 0x00, 1 }, { 0x0410, 0x52, 0 }, { 0x0438, 0xfe, 0 },
+	{ 0x0460, 0x00, 0 }, { 0x0464, 0x7f, 0 },
+	{ 0x0604, 0x0c, 0 }, { 0x062c, 0x01, 0 }, { 0x0634, 0x0f, 0 }, { 0x061c, 0x0a, 0 }, { 0x0614, 0x60, 0 },
+	{ 0x063c, 0xb8, 0 }, { 0x0600, 0x91, 0 }, { 0x0608, 0x00, 1 }, { 0x0610, 0x52, 0 }, { 0x0638, 0xfe, 0 },
