+	{ 0x023c, 0xb8, 0 }, { 0x0200, 0x91, 0 }, { 0x0208, 0x00, 1 }, { 0x0210, 0x52, 0 }, { 0x0238, 0xfe, 0 },
+	{ 0x0260, 0x00, 0 }, { 0x0264, 0x7f, 0 },
