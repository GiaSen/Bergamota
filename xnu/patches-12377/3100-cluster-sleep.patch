 		os_atomic_store(&s->deadline, 0, relaxed);
 		s->resumes++;
 		s->deep_abs += now - s->enter_abs;
@@ -1208,6 +1229,9 @@ sweet_deep_idle_resume(cpu_data_t *cdp)
 	}
 	cdp->cpu_idle_pop = 0x0ULL;
 	setPop(cdp->rtcPop);    /* the timer lost its compare value; a past pop fires at once */
+	if (cpu == 0) {
+		sweet_deep_idle_resync(cdp);    /* 3100: and no later than the earliest sleeper */
+	}
 }
 
 /* CPU 0, timer_intr: wake the sleepers whose time has come */
@@ -1519,6 +1543,368 @@ sweet_wake_stats(char *buf, size_t len, bool clear)
 	return 0;
 }
 
+
+/*
+ * 3100: CPU 0 powers down too, and then the cluster with its cache.
+ *
+ * Until now CPU 0 stayed in WFI as the sleepers' timer, so the cluster (one L3 for all eight cores) could never go.
+ * A powered-down core loses its own timer, so CPU 0 needs another one to come back: frame 0 of the memory-mapped
+ * timer (DT arm,armv7-timer-mem at 0x17c90000, frame@17ca0000; Linux's broadcast timer on this chip), which keeps
+ * counting the same 19.2 MHz and raises SPI 6 (INTID 38), routed to CPU 0 here: the first device interrupt this
+ * kernel takes. CPU 0 goes down only when every other core is down, as the last one, for at least min_us, with the
+ * frame timer set lead_us before the earliest thing anyone waits for (its own pop or a sleeper's deadline); back up, it
+ * serves the sleepers as before.
+ *
+ * kern.sweet_cluster: 0 off (boot default);
+ *   1  CPU 0 powers down as a core (the same PSCI state as the others) while CPU 1 stays in WFI as its guard: if CPU 0
+ *      is not back 20 ms after its time, CPU 1 sends it an IPI and counts it (guard_kicks): a wake timer that does
+ *      not work shows as a number, not as a dead phone;
+ *   2  the same without a guard: all eight cores down, the cluster still on;
+ *   3  the last core asks for the cluster too: power_state 0x4100C244 = rail-pc + the DT's llcc-off (0xC24 << 4,
+ *      affinity level 1), as Linux's lpm-levels builds it for the last core in (platform-coordinated PSCI, the
+ *      default: PSCI_FEATURES says the firmware could do OS-initiated too). llcc-off is "notify-rpm": the wake time
+ *      also goes to the RSC (sweet_rpmh_sleep_enter), because in that state the power controller, not the GIC, is
+ *      what brings the cluster back. min_us / lead_us are raised to 15000 / 8000 for it (DT: latency 6562 us, time
+ *      overhead 5000 us).
+ * All of it only where the cores' deep idle runs (kern.sweet_deep_idle on, display off unless _screen is 0).
+ * kern.sweet_cluster_stats: one line of counters and the wake timer's self-test.
+ */
+#define SWEET_QT_CTRL_PA        0x17c90000ULL
+#define SWEET_QT_FRAME_PA       0x17ca0000ULL
+#define SWEET_QT_INTID          38u             /* SPI 6: frame 0's virtual timer */
+#define QT_CNTTIDR              0x08u           /* control frame */
+#define QT_CNTACR0              0x40u
+#define QT_CNTFRQ               0x10u           /* frame 0 */
+#define QT_CNTV_CVAL_LO         0x30u
+#define QT_CNTV_CVAL_HI         0x34u
+#define QT_CNTV_TVAL            0x38u
+#define QT_CNTV_CTL             0x3cu
+#define QT_CTL_ENABLE           1u
+#define QT_CTL_IMASK            2u
+#define QT_CTL_ISTATUS          4u
+#define SWEET_CL_STATE          0x4100C244ULL
+#define SWEET_CL_GUARD_MS       20
+#define SWEET_CL3_MIN_US        15000
+#define SWEET_CL3_LEAD_US       8000
+
+uint32_t sweet_cluster;
+uint32_t sweet_cluster_min_us = 6000, sweet_cluster_lead_us = 2000;
+/* for finding out how this firmware wants to be asked (kern.sweet_cluster_state, _all, kern.sweet_psci_osi) */
+uint32_t sweet_cluster_state = (uint32_t)0x4100C244u;   /* mode 3's power_state for the last core */
+uint32_t sweet_cluster_all;                             /* 1: in mode 3 every core asks for it, not only the last */
+uint32_t sweet_cluster3_min_us = SWEET_CL3_MIN_US, sweet_cluster3_lead_us = SWEET_CL3_LEAD_US;  /* mode 3's own limits */
+static vm_offset_t sweet_qt_ctrl, sweet_qt_frame;
+static bool sweet_qt_ready;
+static uint64_t sweet_cl_min_abs, sweet_cl_lead_abs, sweet_cl_guard_abs;
+static struct {
+	uint64_t        entries, returns, resumes, errors, too_short, not_all, busy, no_reset, guard_kicks, irqs;
+	uint64_t        deep_abs, late_abs, enter_abs, target_abs;
+	uint64_t        ret_abs, ret_last_abs, ret_planned_abs; /* calls that returned: time inside them, the last one's, and what it was meant to sleep */
+	uint64_t        denied;                                 /* PSCI DENIED: another core was not off yet; tried again later */
+	uint64_t        ent3, res3, deep3_abs, late3_abs;       /* mode 3 alone: asked for the cluster, came back through the reset vector */
+	uint64_t        guard_deadline;         /* CPU 1 kicks CPU 0 when this passes; 0: nothing to guard */
+	int32_t         last_rc;
+	uint32_t        prepared, in, in_mode;
+	char            selftest[176];
+} sweet_cl;
+
+extern uint32_t sweet_gic_spi_setup(uint32_t intid, uint64_t affinity, bool enable);    /* pexpert/arm/pe_fiq.c */
+extern bool sweet_rpmh_sleep_enter(uint32_t cval_lo, uint32_t cval_hi);                 /* bsd/dev/sweet_rpmh.c */
+extern void sweet_rpmh_sleep_exit(void);
+
+static inline uint32_t
+qt_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(sweet_qt_frame + off);
+}
+
+static inline void
+qt_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(sweet_qt_frame + off) = v;
+	__builtin_arm_dsb(DSB_SY);
+}
+
+/* sleh_irq: the frame timer's interrupt. Asleep, CPU 0 switches the timer off before it unmasks, so this is the awake case. */
+bool sweet_qtimer_intr(uint32_t intid);
+bool
+sweet_qtimer_intr(uint32_t intid)
+{
+	if (intid != SWEET_QT_INTID) {
+		return false;
+	}
+	if (sweet_qt_frame) {
+		qt_wr(QT_CNTV_CTL, 0);
+	}
+	sweet_cl.irqs++;
+	return true;
+}
+
+/* CPU 1 in mode 1, from its timer interrupt (resync false) and at the end of timer_resync_deadlines (true) */
+void sweet_cluster_guard(cpu_data_t *cdp, uint64_t now, bool resync);
+void
+sweet_cluster_guard(cpu_data_t *cdp, uint64_t now, bool resync)
+{
+	if (cdp->cpu_number != 1 || os_atomic_load(&sweet_cluster, relaxed) != 1) {
+		return;
+	}
+	uint64_t d = os_atomic_load(&sweet_cl.guard_deadline, relaxed);
+	if (d == 0) {
+		return;
+	}
+	if (resync) {
+		if (d < cdp->rtcPop) {
+			setPop(d);
+		}
+	} else if (d <= now && os_atomic_cmpxchg(&sweet_cl.guard_deadline, d, 0, relaxed)) {
+		cpu_data_t *c0 = CpuDataEntries[0].cpu_data_vaddr;
+		sweet_cl.guard_kicks++;
+		if (c0 != NULL) {
+			cpu_signal(c0, SIGPnop, NULL, NULL);
+		}
+	}
+}
+
+/* CPU 0 is back, powered down or not: the wake timer off, the guard and the RSC released */
+static void
+sweet_cluster_leave(void)
+{
+	qt_wr(QT_CNTV_CTL, 0);
+	os_atomic_store(&sweet_cl.guard_deadline, 0, relaxed);
+	if (sweet_cl.in_mode == 3) {
+		sweet_rpmh_sleep_exit();
+	}
+	os_atomic_store(&sweet_cl.in, 0, relaxed);
+}
+
+/* cpu_idle on CPU 0, interrupts masked: true if the WFI is done */
+static bool
+sweet_cluster_enter(cpu_data_t *cdp, uint32_t mode)
+{
+	uint32_t cl = os_atomic_load(&sweet_cluster, acquire);
+
+	if (cl == 0 || mode == 0 || !sweet_qt_ready) {
+		return false;
+	}
+	if (sweet_deep_idle_screen && !sweet_fb_display_off) {
+		return false;
+	}
+	uint64_t first = cdp->cpu_idle_pop ? cdp->cpu_idle_pop : cdp->rtcPop;
+	for (unsigned int cpu = 1; cpu < MAX_CPUS; cpu++) {
+		if (CpuDataEntries[cpu].cpu_data_vaddr == NULL || (cl == 1 && cpu == 1)) {
+			continue;
+		}
+		/*
+		 * Down, and staying down: a core CPU 0 has just kicked (its deadline is cleared by the kick) or one with any
+		 * other IPI pending is on its way up, which takes it half a millisecond; the firmware gives up a cluster
+		 * power-down that a core walks into (observed: the call back after 0.5-0.7 ms, nothing powered down).
+		 */
+		cpu_data_t *other = CpuDataEntries[cpu].cpu_data_vaddr;
+		uint64_t d = os_atomic_load(&sweet_di[cpu].deadline, relaxed);
+		if (!os_atomic_load(&sweet_di[cpu].down, relaxed) || d == 0 ||
+		    (os_atomic_load(&other->cpu_signal, relaxed) & ~SIGPdisabled) != 0) {
+			sweet_cl.not_all++;
+			return false;
+		}
+		if (d < first) {
+			first = d;
+		}
+	}
+	uint64_t now = mach_absolute_time(), min_abs = sweet_cl_min_abs, lead_abs = sweet_cl_lead_abs, a;
+	if (cl == 3) {
+		nanoseconds_to_absolutetime((uint64_t)sweet_cluster3_min_us * NSEC_PER_USEC, &a);
+		min_abs = MAX(min_abs, a);
+		nanoseconds_to_absolutetime((uint64_t)sweet_cluster3_lead_us * NSEC_PER_USEC, &a);
+		lead_abs = MAX(lead_abs, a);
+	}
+	if (first <= now || first - now < min_abs) {
+		sweet_cl.too_short++;
+		return false;
+	}
+	if (cdp->cpu_reset_handler != sweet_di_resume_pa) {
+		sweet_cl.no_reset++;
+		return false;
+	}
+	if (!sweet_cl.prepared) {
+		extern uint8_t bootstrap_pagetables[BOOTSTRAP_TABLE_SIZE];
+		CleanPoC_DcacheRegion_Force((vm_offset_t)CpuDataEntries, sizeof(CpuDataEntries));
+		CleanPoC_DcacheRegion_Force((vm_offset_t)cdp, sizeof(cpu_data_t));
+		CleanPoC_DcacheRegion_Force((vm_offset_t)&ResetHandlerData, sizeof(ResetHandlerData));
+		CleanPoC_DcacheRegion_Force((vm_offset_t)BootArgs, sizeof(*BootArgs));
+		CleanPoC_DcacheRegion_Force((vm_offset_t)&cpu_ttep, sizeof(cpu_ttep));
+		CleanPoC_DcacheRegion_Force((vm_offset_t)bootstrap_pagetables, BOOTSTRAP_TABLE_SIZE);
+		__builtin_arm_dsb(DSB_SY);
+		sweet_cl.prepared = 1;
+	}
+	uint64_t wake = first - lead_abs, delta = wake - now;
+	if (delta > 0x7fffffffULL) {
+		delta = 0x7fffffffULL;
+		wake = now + delta;
+	}
+	qt_wr(QT_CNTV_CTL, 0);
+	qt_wr(QT_CNTV_TVAL, (uint32_t)delta);
+	qt_wr(QT_CNTV_CTL, QT_CTL_ENABLE);
+	sweet_cl.in_mode = cl;
+	if (cl == 3 && !sweet_rpmh_sleep_enter(qt_rd(QT_CNTV_CVAL_LO), qt_rd(QT_CNTV_CVAL_HI))) {
+		qt_wr(QT_CNTV_CTL, 0);
+		sweet_cl.busy++;
+		return false;
+	}
+	if (cl == 1) {
+		cpu_data_t *guard = CpuDataEntries[1].cpu_data_vaddr;
+		os_atomic_store(&sweet_cl.guard_deadline, wake + sweet_cl_guard_abs, relaxed);
+		os_atomic_thread_fence(seq_cst);
+		if (guard != NULL) {
+			cpu_signal(guard, SIGPTimerLocal, NULL, NULL);
+		}
+	}
+	sweet_cl.entries++;
+	if (cl == 3) {
+		sweet_cl.ent3++;
+	}
+	sweet_cl.enter_abs = now;
+	sweet_cl.target_abs = wake;
+	os_atomic_store(&sweet_cl.in, 1, relaxed);
+	__builtin_arm_dsb(DSB_SY);
+
+	int32_t rc = sweet_psci_cpu_suspend(cl == 3 ? (uint64_t)sweet_cluster_state : (mode == 2 ? SWEET_DI_PC : SWEET_DI_RAIL_PC), sweet_di_entry_pa, 0);
+
+	/* Only if CPU 0 did not power down: a wake-up was pending, PSCI refused, or the state kept the core's context */
+	uint64_t back = mach_absolute_time();
+	sweet_cluster_leave();
+	sweet_cl.last_rc = rc;
+	sweet_cl.ret_last_abs = back - now;
+	sweet_cl.ret_abs += back - now;
+	sweet_cl.ret_planned_abs = delta;
+	if (rc == -3) {
+		sweet_cl.denied++;      /* PSCI DENIED: a core the firmware does not yet count as off (it was still going down) */
+	} else if (rc < 0) {
+		sweet_cl.errors++;
+		os_atomic_store(&sweet_cluster, 0, relaxed);
+	} else {
+		sweet_cl.returns++;
+	}
+	return true;
+}
+
+/* sweet_deep_idle_resume on CPU 0: it was powered down */
+static void
+sweet_cluster_resume(cpu_data_t *cdp)
+{
+	if (!os_atomic_load(&sweet_cl.in, relaxed)) {
+		return;
+	}
+	uint64_t now = mach_absolute_time();
+	bool cluster = sweet_cl.in_mode == 3;
+	sweet_cluster_leave();
+	if (cluster) {
+		(void)sweet_gic_spi_setup(SWEET_QT_INTID, 0, true);     /* the distributor may have been off with the cluster */
+	}
+	sweet_cl.resumes++;
+	sweet_cl.deep_abs += now - sweet_cl.enter_abs;
+	if (now > sweet_cl.target_abs && now - sweet_cl.target_abs > sweet_cl.late_abs) {
+		sweet_cl.late_abs = now - sweet_cl.target_abs;
+	}
+	if (cluster) {
+		sweet_cl.res3++;
+		sweet_cl.deep3_abs += now - sweet_cl.enter_abs;
+		if (now > sweet_cl.target_abs && now - sweet_cl.target_abs > sweet_cl.late3_abs) {
+			sweet_cl.late3_abs = now - sweet_cl.target_abs;
+		}
+	}
+	(void)cdp;
+}
+
+/* Thread context (the sysctl): map and try the wake timer once, then set the mode. <0: not possible */
+int sweet_cluster_configure(uint32_t mode);
+int
+sweet_cluster_configure(uint32_t mode)
+{
+	uint64_t a;
+
+	if (mode > 3) {
+		return -1;
+	}
+	if (mode != 0 && sweet_qt_frame == 0) {
+		vm_offset_t ctrl = ml_io_map(SWEET_QT_CTRL_PA, 0x1000), frame = ml_io_map(SWEET_QT_FRAME_PA, 0x1000);
+		if (ctrl == 0 || frame == 0) {
+			return -2;
+		}
+		uint32_t tidr = *(volatile uint32_t *)(ctrl + QT_CNTTIDR);
+		*(volatile uint32_t *)(ctrl + QT_CNTACR0) = 0x3f;       /* every access to frame 0, as Linux asks */
+		__builtin_arm_dsb(DSB_SY);
+		uint32_t acr = *(volatile uint32_t *)(ctrl + QT_CNTACR0);
+		sweet_qt_ctrl = ctrl;
+		sweet_qt_frame = frame;
+		uint32_t frq = qt_rd(QT_CNTFRQ);
+		/* 1: the timer counts down and says so, masked */
+		unsigned us1 = 0, us2 = 0;
+		qt_wr(QT_CNTV_CTL, 0);
+		qt_wr(QT_CNTV_TVAL, 19200);     /* 1 ms */
+		qt_wr(QT_CNTV_CTL, QT_CTL_ENABLE | QT_CTL_IMASK);
+		while (us1 < 5000 && !(qt_rd(QT_CNTV_CTL) & QT_CTL_ISTATUS)) {
+			delay(50);
+			us1 += 50;
+		}
+		bool status = (qt_rd(QT_CNTV_CTL) & QT_CTL_ISTATUS) != 0;
+		qt_wr(QT_CNTV_CTL, 0);
+		/* 2: its interrupt arrives at CPU 0 */
+		uint32_t gic = sweet_gic_spi_setup(SWEET_QT_INTID, 0, true);
+		uint64_t irqs = sweet_cl.irqs;
+		qt_wr(QT_CNTV_TVAL, 19200);
+		qt_wr(QT_CNTV_CTL, QT_CTL_ENABLE);
+		while (us2 < 20000 && sweet_cl.irqs == irqs) {
+			delay(100);
+			us2 += 100;
+		}
+		bool irq = sweet_cl.irqs != irqs;
+		qt_wr(QT_CNTV_CTL, 0);
+		snprintf(sweet_cl.selftest, sizeof(sweet_cl.selftest), "tidr=%#x acr0=%#x frq=%u status=%s/%uus irq=%s/%uus gic=%#x", tidr, acr, frq,
+		    status ? "ok" : "no", us1, irq ? "ok" : "no", us2, gic);
+		printf("SWEET CLUSTER: wake timer (frame 0 at %#llx, INTID %u): %s\n", SWEET_QT_FRAME_PA, SWEET_QT_INTID, sweet_cl.selftest);
+		sweet_qt_ready = status && irq;
+	}
+	if (mode != 0 && !sweet_qt_ready) {
+		return -3;
+	}
+	if (sweet_cluster_min_us < sweet_cluster_lead_us + 1000) {
+		return -4;
+	}
+	sweet_di_setup();
+	nanoseconds_to_absolutetime((uint64_t)sweet_cluster_min_us * NSEC_PER_USEC, &a);
+	sweet_cl_min_abs = a;
+	nanoseconds_to_absolutetime((uint64_t)sweet_cluster_lead_us * NSEC_PER_USEC, &a);
+	sweet_cl_lead_abs = a;
+	nanoseconds_to_absolutetime((uint64_t)SWEET_CL_GUARD_MS * NSEC_PER_MSEC, &a);
+	sweet_cl_guard_abs = a;
+	os_atomic_thread_fence(seq_cst);
+	os_atomic_store(&sweet_cluster, mode, release);
+	return 0;
+}
