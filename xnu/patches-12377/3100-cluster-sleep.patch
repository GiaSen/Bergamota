+/*
+ * 3100: one shared interrupt (an SPI), level-sensitive, Group 1, priority as the others, sent to the CPU with the given
+ * affinity (MPIDR Aff3..Aff0); or switched off. The first device interrupt of this kernel: everything else is polled.
+ * Returns what the distributor kept: bit 0 enabled, bit 1 group 1, bits 15:8 the priority, bits 31:16 the route's low
+ * half. Thread context or interrupts masked; the distributor is always-on and needs no lock for one interrupt's bits
+ * as long as nothing else writes the same words (nothing does).
+ */
+#define GICD_IGROUPR(n)         (0x0080 + 4 * ((n) / 32))
+#define GICD_ISENABLER(n)       (0x0100 + 4 * ((n) / 32))
+#define GICD_ICENABLER(n)       (0x0180 + 4 * ((n) / 32))
+#define GICD_IPRIORITYR(n)      (0x0400 + 4 * ((n) / 4))
+#define GICD_ICFGR(n)           (0x0c00 + 4 * ((n) / 16))
+#define GICD_IROUTER(n)         (0x6000 + 8 * (n))
+
+uint32_t sweet_gic_spi_setup(uint32_t intid, uint64_t affinity, bool enable);
+uint32_t
+sweet_gic_spi_setup(uint32_t intid, uint64_t affinity, bool enable)
+{
+	if (!gicd_base || intid < 32 || intid >= 1020) {
+		return 0;
+	}
+	uint32_t bit = 1u << (intid % 32);
+	if (!enable) {
+		gicd_write32(GICD_ICENABLER(intid), bit);
+	} else {
+		gicd_write32(GICD_ICENABLER(intid), bit);
+		gicd_write32(GICD_IGROUPR(intid), gicd_read32(GICD_IGROUPR(intid)) | bit);
+		uint32_t pri = gicd_read32(GICD_IPRIORITYR(intid));
+		pri = (pri & ~(0xffu << (8 * (intid % 4)))) | (0xa0u << (8 * (intid % 4)));
+		gicd_write32(GICD_IPRIORITYR(intid), pri);
+		gicd_write32(GICD_ICFGR(intid), gicd_read32(GICD_ICFGR(intid)) & ~(3u << (2 * (intid % 16))));
+		*((volatile uint64_t *)(gicd_base + GICD_IROUTER(intid))) = affinity & 0xff00ffffffULL;
+		gicd_write32(GICD_ISENABLER(intid), bit);
+	}
+	while (gicd_read32(GICD_CTLR) & GICD_CTLR_RWP) {
+		;
+	}
+	return ((gicd_read32(GICD_ISENABLER(intid)) & bit) ? 1u : 0u) | ((gicd_read32(GICD_IGROUPR(intid)) & bit) ? 2u : 0u) |
+	       (((gicd_read32(GICD_IPRIORITYR(intid)) >> (8 * (intid % 4))) & 0xffu) << 8) |
+	       ((uint32_t)_gic_read64(gicd_base + GICD_IROUTER(intid)) << 16);
+}
