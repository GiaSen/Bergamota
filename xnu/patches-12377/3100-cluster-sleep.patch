diff --git a/bsd/dev/sweet_rpmh.c b/bsd/dev/sweet_rpmh.c
index b8cf280..9fcc8c7 100644
--- a/bsd/dev/sweet_rpmh.c
+++ b/bsd/dev/sweet_rpmh.c
@@ -966,4 +966,81 @@ out:
 	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
 	return error;
 }
+
+/*
+ * 3100: for the cluster's power-down (osfmk/arm64/cpu.c, kern.sweet_cluster=3). The DT calls the cluster's deepest level
+ * "notify-rpm": before the last core goes, Linux (drivers/soc/qcom/system_pm.c) makes sure no request is in flight and
+ * writes the time of the next wake-up, the memory-mapped timer's compare value, into the RSC's two hidden control
+ * slots: +0x38 the upper 24 bits with bit 31 "valid", +0x40 the lower 32. In that state the power controller brings
+ * the cluster back, not the GIC. No sleep or wake votes are written: what is voted stays voted.
+ * sweet_rpmh_sleep_enter: CPU 0, interrupts masked, every other core down; takes the driver's lock and keeps it until
+ * sweet_rpmh_sleep_exit. false: a request is in flight or the driver is not up, do not sleep that deep now.
+ */
+#define RH_HIDDEN_CMD0  0x38u
+#define RH_HIDDEN_CMD1  0x40u
+bool sweet_rpmh_sleep_enter(uint32_t cval_lo, uint32_t cval_hi);
+void sweet_rpmh_sleep_exit(void);
+
+bool
+sweet_rpmh_sleep_enter(uint32_t cval_lo, uint32_t cval_hi)
+{
+	if (!rh_rsc || !rh_tcs || !rh_be) {
+		return false;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return false;
+	}
+	for (unsigned t = 0; t < RH_ACTIVE_N; t++) {
+		if (!rh_free(t)) {
+			__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+			return false;
+		}
+	}
+	rh_write(rh_rsc, RH_HIDDEN_CMD0, (1u << 31) | (cval_hi & 0xffffffu));
+	rh_write(rh_rsc, RH_HIDDEN_CMD1, cval_lo);
+	return true;
+}
+
+void
+sweet_rpmh_sleep_exit(void)
+{
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+}
+
+/* kern.sweet_rpmh_sets: what the sleep (TCS 2-4) and wake (TCS 5-7) sets and the hidden slots hold; reads only */
+static int
+sysctl_sweet_rpmh_sets SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2)
+	char buf[1536];
+	size_t n = 0;
+	if (!rh_rsc || !rh_tcs) {
+		return ENXIO;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	n += (size_t)snprintf(buf + n, sizeof(buf) - n, "sweet_rpmh_sets v1 hidden0=%#x hidden1=%#x solver=%#x irq_en=%#x irq_status=%#x\n",
+	    rh_read(rh_rsc, RH_HIDDEN_CMD0), rh_read(rh_rsc, RH_HIDDEN_CMD1), rh_read(rh_rsc, 4), rh_read(rh_tcs, RH_IRQ_EN), rh_read(rh_tcs, RH_IRQ_STATUS));
+	for (unsigned t = 0; t < RH_NORMAL_N && n < sizeof(buf); t++) {
+		uint32_t b = t * RH_TCS_STRIDE, en = rh_read(rh_tcs, b + RH_ENABLE);
+		n += (size_t)snprintf(buf + n, sizeof(buf) - n, "tcs%u %s enable=%#x control=%#x status=%#x wait=%#x", t,
+		    t < RH_ACTIVE_N ? "active" : t < RH_ACTIVE_N + 3 ? "sleep" : "wake", en, rh_read(rh_tcs, b + RH_CONTROL), rh_read(rh_tcs, b + RH_STATUS),
+		    rh_read(rh_tcs, b + RH_WAIT));
+		for (unsigned c = 0; c < 16 && n < sizeof(buf); c++) {
+			if (en & (1u << c)) {
+				n += (size_t)snprintf(buf + n, sizeof(buf) - n, " [%u %#x=%#x]", c, rh_read(rh_tcs, b + RH_ADDR + c * RH_CMD_STRIDE),
+				    rh_read(rh_tcs, b + RH_DATA + c * RH_CMD_STRIDE));
+			}
+		}
+		if (n < sizeof(buf)) {
+			n += (size_t)snprintf(buf + n, sizeof(buf) - n, "\n");
+		}
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	buf[sizeof(buf) - 1] = 0;
+	return sysctl_handle_string(oidp, buf, sizeof(buf), req);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_rpmh_sets, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0, sysctl_sweet_rpmh_sets, "A",
+    "the RSC's sleep and wake sets and hidden slots (3100)");
 #endif /* ARM64_BOARD_CONFIG_SWEET */
