+int sweet_cluster_stats(char *buf, size_t len);
+int
+sweet_cluster_stats(char *buf, size_t len)
+{
+	uint64_t deep_ns, late_ns, ret_ns, ret_last_ns, ret_planned_ns, deep3_ns, late3_ns;
+	absolutetime_to_nanoseconds(sweet_cl.deep3_abs, &deep3_ns);
+	absolutetime_to_nanoseconds(sweet_cl.late3_abs, &late3_ns);
+	absolutetime_to_nanoseconds(sweet_cl.deep_abs, &deep_ns);
+	absolutetime_to_nanoseconds(sweet_cl.late_abs, &late_ns);
+	absolutetime_to_nanoseconds(sweet_cl.ret_abs, &ret_ns);
+	absolutetime_to_nanoseconds(sweet_cl.ret_last_abs, &ret_last_ns);
+	absolutetime_to_nanoseconds(sweet_cl.ret_planned_abs, &ret_planned_ns);
+	snprintf(buf, len, "sweet_cluster v1 mode=%u ready=%d min_us=%u lead_us=%u state=%#x all=%u ent=%llu ret=%llu res=%llu err=%llu rc=%d short=%llu notall=%llu "
+	    "busy=%llu norst=%llu guard_kicks=%llu irqs=%llu deep_ms=%llu late_us=%llu ret_us=%llu ret_last_us=%llu ret_last_planned_us=%llu "
+	    "denied=%llu ent3=%llu res3=%llu deep3_ms=%llu late3_us=%llu\nselftest %s\n",
+	    sweet_cluster, sweet_qt_ready, sweet_cluster_min_us, sweet_cluster_lead_us, sweet_cluster_state, sweet_cluster_all,
+	    sweet_cl.entries, sweet_cl.returns, sweet_cl.resumes, sweet_cl.errors, sweet_cl.last_rc, sweet_cl.too_short,
+	    sweet_cl.not_all, sweet_cl.busy, sweet_cl.no_reset, sweet_cl.guard_kicks, sweet_cl.irqs, deep_ns / NSEC_PER_MSEC, late_ns / NSEC_PER_USEC,
+	    ret_ns / NSEC_PER_USEC, ret_last_ns / NSEC_PER_USEC, ret_planned_ns / NSEC_PER_USEC, sweet_cl.denied, sweet_cl.ent3, sweet_cl.res3,
+	    deep3_ns / NSEC_PER_MSEC, late3_ns / NSEC_PER_USEC, sweet_cl.selftest[0] ? sweet_cl.selftest : "not run");
+	return 0;
+}
