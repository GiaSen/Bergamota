 static struct sweet_di_cpu sweet_di[MAX_CPUS];
+static bool sweet_cluster_enter(cpu_data_t *cdp, uint32_t mode);
+static void sweet_cluster_resume(cpu_data_t *cdp);
+extern uint32_t sweet_cluster;
