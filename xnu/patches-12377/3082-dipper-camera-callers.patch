diff --git a/bsd/dev/dipper_camera.c b/bsd/dev/dipper_camera.c
index 52973ee..af27cbe 100644
--- a/bsd/dev/dipper_camera.c
+++ b/bsd/dev/dipper_camera.c
@@ -62,6 +62,8 @@
 #include <sys/systm.h>
 #include <sys/errno.h>
 #include <sys/sysctl.h>
+#include <sys/kauth.h>
+#include <sys/proc.h>
 #include <stdarg.h>
 #include <kern/kalloc.h>
 #include <kern/locks.h>
@@ -2420,6 +2422,23 @@ cam_stream_thread(void *arg __unused, wait_result_t wr __unused)
 	thread_terminate(current_thread());
 }
 
+/*
+ * 3082: the stream, its frames, the focus and the sensor's sequence are for root and cameracaptured only (since 3080 the
+ * first three were anybody's: any process could read the camera's frames past TCC). cameracaptured runs as mobile and loads
+ * the sequence itself (sweetcam.dylib, from a file on the phone) the first time it starts the stream: no root step after a boot.
+ */
+static bool
+cam_caller_ok(void)
+{
+	char name[MAXCOMLEN + 1];
+
+	if (kauth_cred_issuser(kauth_cred_get())) {
+		return true;
+	}
+	proc_selfname(name, sizeof(name));
+	return strcmp(name, "cameracaptured") == 0;
+}
+
 static int
 cam_stream_sysctl SYSCTL_HANDLER_ARGS
 {
@@ -2429,6 +2448,9 @@ cam_stream_sysctl SYSCTL_HANDLER_ARGS
 	if (error || !req->newptr) {
 		return error;
 	}
+	if (!cam_caller_ok()) {
+		return EPERM;
+	}
 	if (!sweet_board_is("xiaomi,dipper")) {
 		return ENODEV;
 	}
@@ -2477,6 +2499,9 @@ cam_focus_sysctl SYSCTL_HANDLER_ARGS
 #pragma unused(oidp, arg1, arg2)
 	int v = 0, error = sysctl_handle_int(oidp, &v, 0, req);
 
+	if (!error && req->newptr && !cam_caller_ok()) {
+		return EPERM;
+	}
 	if (!error && req->newptr && v == 1) {
 		cam_focus_req = true;
 	}
@@ -2493,6 +2518,9 @@ cam_live_sysctl SYSCTL_HANDLER_ARGS
 	bool have_last = false;
 	int error = 0, l;
 
+	if (!cam_caller_ok()) {
+		return EPERM;
+	}
 	if (!req->oldptr) {
 		return SYSCTL_OUT(req, NULL, sizeof(struct cam_live_hdr) + C4_FRAME);
 	}
@@ -2545,6 +2573,9 @@ cam_seq_sysctl SYSCTL_HANDLER_ARGS
 #pragma unused(oidp, arg1, arg2)
 	int error = 0;
 
+	if (!cam_caller_ok()) {
+		return EPERM;
+	}
 	if (!lck_mtx_try_lock(&cam_lock)) {
 		return EBUSY;                   /* 3080: streaming */
 	}
@@ -2578,8 +2609,8 @@ cam_seq_sysctl SYSCTL_HANDLER_ARGS
 	lck_mtx_unlock(&cam_lock);
 	return error;
 }
-SYSCTL_PROC(_kern, OID_AUTO, sweet_cam_seq, CTLTYPE_OPAQUE | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0, cam_seq_sysctl, "S",
-    "3077: the rear main sensor's register sequence for kern.sweet_cam=4 (tools/camera/camx_v1.py --seq)");
+SYSCTL_PROC(_kern, OID_AUTO, sweet_cam_seq, CTLTYPE_OPAQUE | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED, 0, 0, cam_seq_sysctl, "S",
+    "3077: the rear main sensor's register sequence for kern.sweet_cam=4 (tools/camera/camx_v1.py --seq); 3082: root and cameracaptured");
 
 static int
 cam_sysctl SYSCTL_HANDLER_ARGS
