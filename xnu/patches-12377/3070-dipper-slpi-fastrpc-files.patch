From de7d751b575a3933d829f3d0a2b1f01120af2b91 Mon Sep 17 00:00:00 2001
From: Giammarco Senatore <giamma@wlan-114021.nbw.tue.nl>
Date: Fri, 6 Nov 2026 15:31:16 +0100
Subject: [PATCH] 3070: FastRPC to the SLPI's sensors PD in the kernel (attach,
 adsp_default_listener, adsp_listener next2) serving its apps_std file calls
 from /private/var/sweet/qcom and SMEM socinfo; sweet_scm_assign() for the
 shared window

---
 bsd/dev/beryllium_wlan.c |   16 +-
 bsd/dev/dipper_sensors.c | 1013 +++++++++++++++++++++++++++++++++++++-
 2 files changed, 1026 insertions(+), 3 deletions(-)

diff --git a/bsd/dev/beryllium_wlan.c b/bsd/dev/beryllium_wlan.c
index 706de3e..04185d1 100644
--- a/bsd/dev/beryllium_wlan.c
+++ b/bsd/dev/beryllium_wlan.c
@@ -1171,7 +1171,7 @@ ms_assign_list(const char *what, uint64_t pa, uint64_t size, const uint32_t *src
 		printf("SWEET MSS: no SCM buffer\n");
 		return false;
 	}
-	if (nsrc == 0 || nsrc > 3 || ndst == 0 || ndst > 3) {
+	if (nsrc == 0 || nsrc > 3 || ndst == 0 || ndst > 4) {      /* 3070: 4 destinations (the SLPI's FastRPC pool) */
 		return false;
 	}
 	bzero(buf, PAGE_SIZE);
@@ -10103,6 +10103,20 @@ sweet_qmp_send(const char *msg)
 	return ok;
 }
 
+/*
+ * 3070: qcom_scm_assign_mem() for another driver (the SLPI's FastRPC pool in bsd/dev/dipper_sensors.c): one region from the
+ * source VMIDs to up to 4 destinations; true when the hypervisor accepted it.
+ */
+bool
+sweet_scm_assign(const char *what, uint64_t pa, uint64_t size, const uint32_t *src, unsigned nsrc, const uint32_t *dst,
+    const uint32_t *perm, unsigned ndst)
+{
+	lck_mtx_lock(&sweet_share_lock);
+	bool ok = ms_assign_list(what, pa, (size + 0xfffull) & ~0xfffull, src, nsrc, dst, perm, ndst);
+	lck_mtx_unlock(&sweet_share_lock);
+	return ok;
+}
+
 /* the service locator's (pd-mapper's) answer to one QMI request from any remote: length in r[512], 0 = none */
 uint32_t
 sweet_pdm_answer(const uint8_t *req, uint32_t len, uint8_t *r)
