+			return;
+		}
+		fr.state = FR_ATTACH;
+		OS_FALLTHROUGH;
+	case FR_ATTACH: {
+		int32_t tgid = FR_TGID;
+		struct fr_arg a = { &tgid, 4 };
+		ok = fr_send(0, 1, 0, &a, 1, NULL, 0);          /* kernel call: pid 0; handle 1 = process group, method 0 */
+		break;
+	}
+	case FR_OPEN: {
+		static const char nm[] = "adsp_default_listener";
+		uint32_t prim[2] = { sizeof(nm), 256 }, outl[2] = { 8, 256 };
+		struct fr_arg a[2] = { { prim, 8 }, { nm, sizeof(nm) } };
+		ok = fr_send(FR_TGID, 0, 0, a, 2, outl, 2);
+		break;
+	}
+	case FR_REGISTER:
+		ok = fr_send(FR_TGID, fr.lhandle, 0, NULL, 0, NULL, 0);
+		break;
+	case FR_CLOSE: {
+		uint32_t prim[2] = { fr.lhandle, 0 }, outl[2] = { 4, 0 };
+		struct fr_arg a = { prim, 8 };
+		ok = fr_send(FR_TGID, 0, 1, &a, 1, outl, 2);
+		break;
+	}
+	case FR_INIT2:
+		ok = fr_send(FR_TGID, 3, 3, NULL, 0, NULL, 0);
+		break;
+	case FR_NEXT2: {
+		uint32_t prim[4] = { fr.rctx, fr.result, fr.reply_len, FR_REQ_CAP }, outl[2] = { 16, FR_REQ_CAP };
+		struct fr_arg a[2] = { { prim, 16 }, { fr.reply, fr.reply_len } };
+		ok = fr_send(FR_TGID, 3, 4, a, 2, outl, 2);
+		break;
+	}
+	default:
+		return;
+	}
+	if (ok && fr.state != FR_NEXT2) {
+		SG_LOG("fastrpc: %s sent\n", fr_state_name[fr.state]);
+	}
+}
