+			if (fr.retval) {
+				fr_fail("listener init refused");
+				return;
+			}
+			fr.state = FR_NEXT2;
+			fr.rctx = 0;
+			fr.result = 0xffffffffu;
+			fr.reply_len = 0;
+			break;
+		case FR_NEXT2: {
+			uint32_t w[4] = { 0, 0, 0, 0 };
+			if (fr.retval) {
+				fr_fail("adsp_listener next2 failed");
+				return;
+			}
+			o0 = fr_out(2, &l0);
+			memcpy(w, o0, MIN(l0, 16u));
+			uint32_t inlen = MIN(w[3], FR_REQ_CAP);
+			o1 = fr_out(3, &l1);
+			memcpy(fr.req, o1, MIN(inlen, l1));
+			fr.rctx = w[0];
+			if (w[3] > FR_REQ_CAP) {
