+/* the DSP's crash reason in SMEM (item 423), if it wrote one */
+static void
+cx_dsp_crash(void)
+{
+	uint32_t sz = 0, it = sweet_smem_item(0xfffe, AU_CRASH_ITEM, &sz);
+	char msg[129];
+	uint32_t n;
+	if (!it || !sz) {
+		CX_LOG("DSP crash reason: none in SMEM\n");
+		return;
+	}
+	n = MIN(sz, 128u);
+	for (uint32_t k = 0; k < n; k += 4) {
+		uint32_t w = sweet_smem_rd(it + k);
+		memcpy(msg + k, &w, MIN(4u, n - k));
+	}
+	msg[n] = 0;
+	CX_LOG("DSP crash reason: \"%s\"\n", msg[0] ? msg : "(empty)");
+}
