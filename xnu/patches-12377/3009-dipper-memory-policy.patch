+	}
+	if (__atomic_exchange_n(&sweet_mem_lock, 1, __ATOMIC_ACQUIRE) == 0) {
+		sweet_llcc_on = llcc_set(1) == 0;
+		__atomic_store_n(&sweet_mem_lock, 0, __ATOMIC_RELEASE);
+	}
+	l3_base = ml_io_map(OSM_L3_PA, CPUFREQ_WINDOW);
+	printf("SWEET MEM: system cache %s, L3 state %u, votes follow the UI (sweetmemtune)\n", sweet_llcc_on ? "on" : "failed",
+	    l3_base ? mm_rd(l3_base, CPUFREQ_PERF_STATE) : 0);
+	cf_mem_auto = true;
+}
