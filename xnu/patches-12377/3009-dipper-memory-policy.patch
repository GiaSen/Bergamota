+/*
+ * 3009: from the governor thread, every period. The clocks and the system cache follow the frames and the fingers, with a hold, so
+ * an idle phone keeps less than ABL left it (DDR) or the same (L3). A failed vote is tried again at the next period.
+ */
+static void
+cf_mem_step(uint64_t now)
+{
+	uint64_t hold;
+	if (!cf_mem_auto) {
+		return;
+	}
+	if (now < cf_anim_until || now < cf_in_until) {
+		nanoseconds_to_absolutetime((uint64_t)MEM_HOLD_S * NSEC_PER_SEC, &hold);
+		cf_mem_until = now + hold;
+	}
+	bool high = now < cf_mem_until;
+	if (high == cf_mem_high) {
+		return;
+	}
+	if (sweet_bus_mbps == 0 && sweet_rpmh_bus_vote(high ? MEM_DDR_HIGH : MEM_DDR_IDLE) != 0) {
+		return;
+	}
+	if (!cf_l3_manual && l3_base != 0) {
+		mm_wr(l3_base, CPUFREQ_PERF_STATE, high ? MEM_L3_HIGH : MEM_L3_IDLE);
+	}
+	cf_mem_high = high;
+}
