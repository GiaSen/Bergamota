+/* 3073c: a fault of the IPA's SMMU bank, logged (the first ten, then every hundredth) and cleared */
+static void
+ipa_smmu_watch(void)
+{
+	uint32_t fsr = 0, fsynr = 0;
+	uint64_t far = 0;
+	if (sweet_smmu_ipa_fault(&fsr, &far, &fsynr, true) < 0 || !(fsr & 0xc00001feu)) {
+		return;
+	}
+	ipa.smmu_faults++;
+	ipa.last_fsr = fsr;
+	ipa.last_far = far;
+	ipa.last_fsynr = fsynr;
+	if (ipa.smmu_faults <= 10 || ipa.smmu_faults % 100 == 0) {
+		printf("SWEET IPA: SMMU FAULT %u on the IPA's bank: FSR %#x (%s%s%s) FAR %#llx FSYNR0 %#x (%s)\n", ipa.smmu_faults, fsr,
+		    fsr & 2 ? "translation " : "", fsr & 8 ? "permission " : "", fsr & 0x80000000u ? "multi" : "", far, fsynr,
+		    fsynr & 0x10 ? "write" : "read");
+	}
