+/* 3073c: the IPA's bank's fault status (FSR, FAR, FSYNR0), cleared if asked; -1 without that bank */
+int sweet_smmu_ipa_fault(uint32_t *fsr, uint64_t *far, uint32_t *fsynr0, bool clear);
+int
+sweet_smmu_ipa_fault(uint32_t *fsr, uint64_t *far, uint32_t *fsynr0, bool clear)
+{
+	if (smmu_cb2 < 0 || !smmu_base) {
+		return -1;
+	}
+	uint32_t id1 = smmu_rd(0x24);
+	unsigned pgshift = (id1 >> 31) ? 16 : 12;
+	uint32_t cb = ((1u << (((id1 >> 28) & 7) + 1)) << pgshift) + ((uint32_t)smmu_cb2 << pgshift);
+	*fsr = smmu_rd(cb + 0x58);
+	*far = (uint64_t)smmu_rd(cb + 0x60) | (uint64_t)smmu_rd(cb + 0x64) << 32;
+	*fsynr0 = smmu_rd(cb + 0x68);
+	if (clear && (*fsr & 0xc00001feu)) {
+		smmu_wr(cb + 0x58, *fsr);
+	}
+	return smmu_cb2;
+}
