+/*
+ * 3073c: a second translating bank on the same identity tables, for the IPA. Its own fault state: with SCTLR.HUPCF 0 an
+ * outstanding context fault terminates every later transaction of the bank until the FSR is cleared, and the shared bank
+ * also carries USB (0x740) and the Wi-Fi copy engine (0x40/0x41): on 2026-11-07 (boot 119b, sweetcelld) USB receive and
+ * Wi-Fi died together while the IPA ran. Here HUPCF 1 as well (later transactions go on), CFIE/CFRE kept.
+ */
+static int
+smmu_bank2_create(void)
+{
+	uint32_t id1 = smmu_rd(0x24);
+	unsigned pgshift = (id1 >> 31) ? 16 : 12;
+	unsigned ncb = id1 & 0xff, ns2cb = (id1 >> 16) & 0xff;
+	uint32_t gr1 = 1u << pgshift;
+	uint32_t cb0 = (1u << (((id1 >> 28) & 7) + 1)) << pgshift;
+	uint32_t used[8] = { 0 };
+	if (smmu_cb < 0 || smmu_l1_pa == 0) {
+		return ENODEV;
+	}
+	for (unsigned i = 0; i < smmu_nsmr && i < 128; i++) {
+		uint32_t smr = smmu_rd(0x800 + 4 * i), s2cr = smmu_rd(0xc00 + 4 * i);
+		if ((smr & (1u << 31)) && ((s2cr >> 16) & 3) == 0) {
+			used[(s2cr & 0xff) / 32] |= 1u << ((s2cr & 0xff) % 32);
+		}
+	}
+	for (unsigned c = ns2cb; c < ncb && smmu_cb2 < 0; c++) {
+		if ((int)c != smmu_cb && !(used[c / 32] & (1u << (c % 32))) && !(smmu_rd(cb0 + (c << pgshift)) & 1)) {
+			smmu_cb2 = (int)c;
+		}
+	}
+	if (smmu_cb2 < 0) {
+		printf("SWEET SMMU: no second free context bank\n");
+		return ENODEV;
+	}
+	uint32_t cb = cb0 + ((uint32_t)smmu_cb2 << pgshift);
+	unsigned asid = (unsigned)smmu_cb2;
+	smmu_wr(cb + 0x0, 0);
+	smmu_wr(cb + 0x58, 0xffffffffu);
+	smmu_wr(gr1 + 0x800 + 4 * (unsigned)smmu_cb2, 1);
+	smmu_wr(gr1 + 4 * (unsigned)smmu_cb2, 1u << 16 | 0xfu << 12 | 3u << 8);
+	smmu_wr(cb + 0x10, 7u << 15 | 2);
+	smmu_wr(cb + 0x30, 25 | 1u << 23);
+	smmu_wr(cb + 0x34, asid);
+	smmu_wr64(cb + 0x20, smmu_l1_pa | (uint64_t)asid << 48);
+	smmu_wr64(cb + 0x28, 0);
+	smmu_wr(cb + 0x38, 0x44);
+	smmu_wr(cb + 0x618, 0);
+	smmu_wr(cb + 0x7f0, 0);
+	for (int t = 0; t < 100000 && (smmu_rd(cb + 0x7f4) & 1); t++) {
+		delay(1);
+	}
+	smmu_wr(cb + 0x0, 1u << 8 | 1u << 6 | 1u << 5 | 1u << 2 | 1u << 1 | 1);   /* HUPCF CFIE CFRE AFE TRE M */
+	if (!(smmu_rd(cb + 0x0) & 1)) {
+		printf("SWEET SMMU: context bank %d did not enable\n", smmu_cb2);
+		smmu_cb2 = -1;
+		return EIO;
+	}
+	printf("SWEET SMMU: context bank %d (the IPA's), the same identity map, HUPCF\n", smmu_cb2);
+	return 0;
+}
