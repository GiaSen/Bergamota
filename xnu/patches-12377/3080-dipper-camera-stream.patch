+/* the score of the code moved to 3 frames ago; moves to the next code (or to the best when done) */
+static void
+c4_af_step(struct c4_af *a, const uint8_t *frame, bool say)
+{
+	a->score[a->i] = af_sharpness(frame);
+	if (say) {
+		cam_say("lens %4u: contrast %llu", a->code[a->i], a->score[a->i]);
+	}
+	a->i++;
+	if (a->i == a->n) {
+		unsigned b = 0;
+		for (unsigned i = 1; i < a->n; i++) {
+			if (a->score[i] > a->score[b]) {
+				b = i;
+			}
+		}
+		a->best = a->code[b];
+		if (!a->fine) {
+			a->fine = true;
+			a->n = 0;
+			for (int c = (int)a->best - 48; c <= (int)a->best + 48; c += 16) {
+				if (c >= 0 && c <= 1023 && a->n < 16) {
+					a->code[a->n++] = (unsigned)c;
+				}
+			}
+			a->i = 0;
+		} else {
+			a->done = true;
+			(void)af_move(a->best);
+			return;
+		}
+	}
+	(void)af_move(a->code[a->i]);
+}
