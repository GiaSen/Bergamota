+			    cam_rd(csid0, CSID_RDI0_STATUS));
+			reg_dump("CSID0 rx block", csid0, 0x100, 0x170);
+			reg_dump("CSID0 rdi0 block", csid0, CSID_RDI0(0), CSID_RDI0(0x100));
+			reg_dump("CSIPHY0 status", csiphy0, 0x8b0, 0x8e0);
