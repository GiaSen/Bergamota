+/* stop the sensor and the blocks, put back everything c4_up() switched on; report: the status registers first */
+static void
+c4_down(struct c4_run *r, bool report)
+{
+	uint32_t fsr = 0;
+	uint64_t far = 0;
+
+	if (r->blocks) {
+		/* the sensor stops at the end of its frame; then RDI 0 halted and the write master off */
+		if (r->streamed) {
+			uint8_t zero = 0;
