+		cam_wr(gcc, CAM_GCC_XO, cam_rd(gcc, CAM_GCC_XO) & ~CBCR_ENABLE);
+	}
+	if (camcc && gcc && refgen) {
+		cam_say("put back: PLL2 mode %#x, PLL3 mode %#x, refgen %#x/%#x, ife_0 %#x, titan_top %#x, GCC AXI %#x, XO %#x",
