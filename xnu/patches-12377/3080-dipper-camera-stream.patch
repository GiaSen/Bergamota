+/* the auto-exposure step on a metered frame: true when on target (or as bright as it goes); else the next exposure written */
+static bool
+c4_ae_step(struct c4_run *r, unsigned mean, unsigned sat, unsigned min_fll)
+{
+	bool on_target = mean * 100u >= C4_AE_TARGET * 85u && mean * 100u <= C4_AE_TARGET * 118u && sat < 20u;
+	if (!on_target && r->exp.lines == C4_FLL_MAX - C4_MARGIN && r->exp.acode == C4_AGAIN_MAX && r->exp.dgain == C4_DGAIN_MAX &&
+	    mean < C4_AE_TARGET) {
+		on_target = true;                       /* as bright as it goes */
+	}
+	if (on_target) {
+		return true;
+	}
+	uint64_t ratio = mean ? (uint64_t)C4_AE_TARGET * 256u / mean : 8u * 256u;   /* x 256 */
+	if (ratio > 8u * 256u) {
+		ratio = 8u * 256u;
+	}
+	if (ratio < 32u) {
+		ratio = 32u;
+	}
+	if (sat >= 20u && ratio > 180u) {
+		ratio = 180u;                           /* clipped highlights: down by at least 30 % */
+	}
+	uint64_t e = r->exp.e256 * ratio / 256u;
+	c4_exp_split(e < 4u * 256u ? 4u * 256u : e, min_fll > r->fll_mode ? min_fll : r->fll_mode, 0, &r->exp);
+	if (!s0_set_exposure(&r->exp)) {
+		cam_say("exposure write NOT acked");
+	}
+	return false;
+}
