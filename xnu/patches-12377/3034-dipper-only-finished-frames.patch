+static int
+sweet_gpu_by_sysctl(struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2, struct sysctl_req *req)
+{
+	char buf[640];
+	int n = 0;
+
+	buf[0] = 0;
+	for (unsigned i = 0; i < BY_N; i++) {
+		if (a630_by[i].ns != 0) {
+			n += snprintf(buf + n, sizeof(buf) - n, "%s/%d=%llu ", a630_by[i].name, a630_by[i].pid, a630_by[i].ns / NSEC_PER_MSEC);
+		}
+	}
+	return sysctl_handle_string(oidp, buf, sizeof(buf), req);
+}
