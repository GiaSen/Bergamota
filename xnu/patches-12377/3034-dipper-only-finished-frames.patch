+/*
+ * 3034: who keeps the GPU busy: each tick with work queued goes to the process that submitted the oldest unfinished submission.
+ * The ring is first come first served, so these are also the processes the compositor's frames wait behind. kern.sweet_gpu_by.
+ */
+#define BY_N                    16u
+static struct {
+	int pid;
+	char name[20];
+	uint64_t ns;
+} a630_by[BY_N];
+
+static void
+gpu_by_note(uint64_t dt)
+{
+	uint32_t next = *(volatile uint32_t *)(cp_memory + SCRATCH_OFF + SCRATCH_FENCE) + 1;
+	unsigned s = next % SUBS_N, low = 0;
+
+	if (a630_subs[s].seqno != next) {
+		return;
+	}
+	for (unsigned i = 0; i < BY_N; i++) {
+		if (a630_by[i].ns != 0 && a630_by[i].pid == a630_subs[s].pid) {
+			a630_by[i].ns += dt;
+			return;
+		}
+		if (a630_by[i].ns < a630_by[low].ns) {
+			low = i;
+		}
+	}
+	a630_by[low].pid = a630_subs[s].pid;
+	memcpy(a630_by[low].name, a630_subs[s].name, sizeof(a630_by[low].name));
+	a630_by[low].name[sizeof(a630_by[low].name) - 1] = 0;
+	a630_by[low].ns = dt;
+}
