+	    bx.starts, bx.stops, bx.failed, bx.timeouts, bx.core[0].type, bx.core[0].interval, bx.core[0].window,
+	    bx.core[1].type, bx.core[1].interval, bx.core[1].window);
+	BS_CAT("from_controller(key=pkts/bytes)");
+	for (unsigned i = 0; i < sizeof(bt_ev_hist) / sizeof(bt_ev_hist[0]); i++) {
+		if (bt_ev_hist[i].n) {
+			BS_CAT(" %04x=%u/%u", bt_ev_hist[i].key, bt_ev_hist[i].n, bt_ev_hist[i].bytes);
+		}
+	}
+	BS_CAT("\nfrom_bluetoothd(opcode=pkts)");
+	for (unsigned i = 0; i < sizeof(bt_cmd_hist) / sizeof(bt_cmd_hist[0]); i++) {
+		if (bt_cmd_hist[i].n) {
+			BS_CAT(" %04x=%u", bt_cmd_hist[i].key, bt_cmd_hist[i].n);
