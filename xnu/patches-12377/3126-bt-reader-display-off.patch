+/*
+ * 3126: packets by kind for kern.sweet_bt_stats: what the controller sends (events by code, LE Meta by subevent,
+ * vendor events by their first byte; ACL, SCO, ISO as 0x1002, 0x1003, 0x1005) and what bluetoothd sends (commands by
+ * opcode). The last slot of a table takes what did not fit (key 0xffff). The controller's table is written under the
+ * UART lock, the commands' by the socket's writer.
+ */
+struct bt_hist { uint16_t key; uint32_t n, bytes; };
+static struct bt_hist bt_ev_hist[24], bt_cmd_hist[96];
+static uint32_t bt_adv_reports, bt_cmd_here;
+
+static void
+bt_hist_note(struct bt_hist *h, unsigned slots, unsigned key, unsigned bytes)
+{
+	unsigned i;
+
+	for (i = 0; i + 1 < slots; i++) {
+		if (h[i].n == 0) {
+			h[i].key = (uint16_t)key;
+		}
+		if (h[i].key == key) {
+			break;
+		}
+	}
+	if (i + 1 == slots) {
+		h[i].key = 0xffff;
+	}
+	h[i].n++;
+	h[i].bytes += bytes;
+}
+
+/* one whole H4 packet off the UART (under the UART lock) */
+void
+bt_hci_uart_note(const uint8_t *pkt, unsigned len)
+{
+	unsigned key = 0x1000u | pkt[0];
+
+	if (pkt[0] == 4 && len >= 3) {
+		key = pkt[1];
+		if (pkt[1] == 0x3e && len >= 4) {
+			key = 0x3e00u | pkt[3];
+			if ((pkt[3] == 0x0d || pkt[3] == 0x02) && len >= 5) {
+				bt_adv_reports += pkt[4];
+			}
+		} else if (pkt[1] == 0xff && len >= 4) {
+			key = 0xff00u | pkt[3];
+		}
+	}
+	bt_hist_note(bt_ev_hist, sizeof(bt_ev_hist) / sizeof(bt_ev_hist[0]), key, len);
+}
