 	}
 }
+
+/*
+ * 3072: sensors (Mi 8: behind the SLPI, bsd/dev/dipper_sensors.c), with the iPhone's usage pairs: n104 ADT
+ * /arm-io/aop/iop-aop-nub accel 0xff00/3 and prox 0xff00/8; ambient light 0xff00/4 (IOHIDFamily
+ * kHIDUsage_AppleVendor_AmbientLightSensor; the n104 ADT has no als node there). locationd's CLAccelerometer::openHidDevice
+ * matches 0xff00/3 + Built-In (+ LocationID only when its IMULocationID setting exists, not by default) and sets
+ * ReportInterval (us): the SLPI stream follows it (sweet_ssc_sensor_rate, 0 = off). Ambient light streams while a client
+ * has it open (on-change events, cheap); proximity only while a client asked for it through a property. Every property a
+ * client sets is logged (the first 24 per service), to learn what iOS sends. One instance per kind (SweetSensorKind in
+ * the personality), started on the Mi 8 only.
+ */
+enum { kSweetSensorAccel = 0, kSweetSensorGyro = 1, kSweetSensorMag = 2, kSweetSensorALS = 3, kSweetSensorProx = 4,
+       kSweetSensorN = 5 };
+extern "C" void sweet_ssc_sensor_rate(int kind, uint32_t interval_us);
+
+class SweetHIDSensor : public IOHIDEventService {
+	OSDeclareDefaultStructors(SweetHIDSensor);
+public:
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+	void sample(uint64_t ts, const int32_t *v, int n);
+
+protected:
+	virtual UInt32 getPrimaryUsagePage() APPLE_KEXT_OVERRIDE { return 0xff00; }
+	virtual UInt32 getPrimaryUsage() APPLE_KEXT_OVERRIDE;
+	virtual OSString *getProduct() APPLE_KEXT_OVERRIDE;
+	virtual UInt32 getProductID() APPLE_KEXT_OVERRIDE { return 0x5300 + (UInt32)fKind; }
+	virtual bool handleOpen(IOService *client, IOOptionBits options, void *argument) APPLE_KEXT_OVERRIDE;
+	virtual void handleClose(IOService *client, IOOptionBits options) APPLE_KEXT_OVERRIDE;
+
+private:
+	void apply(void);
+	int fKind;
+	UInt32 fSeq;
+	unsigned fPropLogs, fSampleLogs;
+	UInt32 fInterval;               /* ReportInterval from a client, us; 0 = not asked */
+	bool fAsked;                    /* proximity: a client asked for detection */
+	UInt32 fMode;                   /* proximity: backboardd's DetectionMode (IOHIDProximityDetectionMask bits), 3072c */
+	unsigned fOpen;
+};
+
+OSDefineMetaClassAndStructors(SweetHIDSensor, IOHIDEventService);
+
+static SweetHIDSensor *gSweetSensors[kSweetSensorN];
+static const char *const sweet_sensor_names[kSweetSensorN] = { "accelerometer", "gyro", "compass", "ambient light",
+	                                                       "proximity" };
+
+UInt32
+SweetHIDSensor::getPrimaryUsage()
+{
+	static const UInt32 usage[kSweetSensorN] = { 3, 9, 10, 4, 8 };
+	return fKind >= 0 && fKind < kSweetSensorN ? usage[fKind] : 0;
+}
+
+OSString *
+SweetHIDSensor::getProduct()
+{
+	char name[48];
+	snprintf(name, sizeof(name), "Sweet %s", fKind >= 0 && fKind < kSweetSensorN ? sweet_sensor_names[fKind] : "sensor");
+	return OSString::withCString(name);
+}
+
+bool
+SweetHIDSensor::start(IOService *provider)
+{
+	OSNumber *k = OSDynamicCast(OSNumber, getProperty("SweetSensorKind"));
+	DTEntry root;
+	void const *prop;
+	unsigned int size;
+	bool dipper = false;
+
+	fKind = k ? (int)k->unsigned32BitValue() : -1;
+	if (fKind < 0 || fKind >= kSweetSensorN) {
+		return false;
+	}
+	/* Mi 8 only: its compatible list starts with the iPhone identity, then xiaomi,dipper */
+	if (SecureDTLookupEntry(NULL, "/", &root) == kSuccess && SecureDTGetProperty(root, "compatible", &prop, &size) == kSuccess) {
+		const char *c = (const char *)prop;
+		for (unsigned int o = 0; o < size && !dipper;) {
+			dipper = strncmp(c + o, "xiaomi,dipper", size - o) == 0;
+			o += (unsigned int)strnlen(c + o, size - o) + 1;
+		}
+	}
+	if (!dipper) {
+		return false;
+	}
+	if (!IOHIDEventService::start(provider)) {
+		return false;
+	}
+	if (fKind == kSweetSensorProx) {
+		/*
+		 * 3072b: backboardd wraps a proximity service only when its "Placement" is 1 ("discrete prox service %llX top
+		 * placement"); any other value is ignored and leaves an NSNull in its wrapper list, and backboardd then aborts on
+		 * -[NSNull applyUIMode:] (image 115, a crash loop until the phone rebooted). The Mi 8's sensor is at the top.
+		 */
+		setProperty("Placement", 1ULL, 32);
+	}
+	gSweetSensors[fKind] = this;
+	registerService();
+	IOLog("SWEET HID: %s sensor registered (usage 0xff00/%u)\n", sweet_sensor_names[fKind], (unsigned)getPrimaryUsage());
+	return true;
+}
+
+/* what the SLPI should do for this kind now */
+void
+SweetHIDSensor::apply(void)
+{
+	UInt32 us = 0;
+	if (fKind == kSweetSensorALS) {
+		us = fOpen ? 100000 : 0;                /* on change: any non-zero value turns it on */
+	} else if (fKind == kSweetSensorProx) {
+		us = fAsked ? 100000 : 0;
+	} else {
+		us = fInterval;
+	}
+	sweet_ssc_sensor_rate(fKind, us);
+}
+
+bool
+SweetHIDSensor::handleOpen(IOService *client, IOOptionBits options, void *argument)
+{
+	bool ok = IOHIDEventService::handleOpen(client, options, argument);
+	if (ok) {
+		fOpen++;
+		apply();
+	}
+	return ok;
+}
+
+void
+SweetHIDSensor::handleClose(IOService *client, IOOptionBits options)
+{
+	bool was = handleIsOpen(client);
+	IOHIDEventService::handleClose(client, options);
+	if (was && fOpen) {
+		fOpen--;
+		if (!fOpen) {
+			fInterval = 0;
+			fAsked = false;
+		}
+		IOLog("SWEET HID: %s sensor closed by %s (%u open)\n", sweet_sensor_names[fKind], client ? client->getName() : "?", fOpen);
+		apply();
+	}
+}
+
+IOReturn
+SweetHIDSensor::setProperties(OSObject *properties)
+{
+	OSDictionary *d = OSDynamicCast(OSDictionary, properties);
+	if (!d) {
+		return kIOReturnBadArgument;
+	}
+	OSCollectionIterator *it = OSCollectionIterator::withCollection(d);
+	OSSymbol *key;
+	while (it && (key = OSDynamicCast(OSSymbol, it->getNextObject()))) {
+		OSObject *val = d->getObject(key);
+		OSNumber *num = OSDynamicCast(OSNumber, val);
+		OSBoolean *b = OSDynamicCast(OSBoolean, val);
+		if (fPropLogs < 24) {
+			fPropLogs++;
+			if (num) {
+				IOLog("SWEET HID: %s sensor property %s = %llu\n", sweet_sensor_names[fKind], key->getCStringNoCopy(),
+				    num->unsigned64BitValue());
+			} else if (b) {
+				IOLog("SWEET HID: %s sensor property %s = %s\n", sweet_sensor_names[fKind], key->getCStringNoCopy(),
+				    b->getValue() ? "true" : "false");
+			} else {
+				IOLog("SWEET HID: %s sensor property %s (%s)\n", sweet_sensor_names[fKind], key->getCStringNoCopy(),
+				    val ? val->getMetaClass()->getClassName() : "null");
+			}
+		}
+		if (key->isEqualTo(kIOHIDReportIntervalKey) && num) {
+			fInterval = num->unsigned32BitValue();
+			setProperty(kIOHIDReportIntervalKey, fInterval, 32);
+		}
+		bool prox_key = false;
+		for (const char *c = key->getCStringNoCopy(); *c && !prox_key; c++) {      /* the kernel has no strstr */
+			prox_key = strncmp(c, "Proximity", 9) == 0;
+		}
+		if (fKind == kSweetSensorProx && key->isEqualTo("DetectionMode") && num) {
+			/* 3072c: backboardd switches detection with DetectionMode (0 off; image 116 saw 0 and 1) */
+			fMode = num->unsigned32BitValue();
+			fAsked = fMode != 0;
+			IOLog("SWEET HID: proximity detection mode %#x (%s)\n", (unsigned)fMode, fAsked ? "on" : "off");
+		}
+		if (fKind == kSweetSensorProx && prox_key && (num || b)) {
+			fAsked = num ? num->unsigned64BitValue() != 0 : b->getValue();
+		}
+		if (fKind == kSweetSensorProx && key->isEqualTo(kIOHIDReportIntervalKey) && num) {
+			fAsked = fInterval != 0;
+		}
+	}
+	OSSafeReleaseNULL(it);
+	apply();
+	return kIOReturnSuccess;
+}
+
+void
+SweetHIDSensor::sample(uint64_t ts, const int32_t *v, int n)
+{
+	IOHIDEvent *e = NULL;
+	if (fSampleLogs < 3) {
+		fSampleLogs++;
+		IOLog("SWEET HID: %s sample %d %d %d (%d values, %u clients)\n", sweet_sensor_names[fKind], n > 0 ? v[0] : 0,
+		    n > 1 ? v[1] : 0, n > 2 ? v[2] : 0, n, _clients ? _clients->getCount() : 0);
+	}
+	switch (fKind) {
+	case kSweetSensorAccel:
+		e = n >= 3 ? IOHIDEvent::accelerometerEvent(ts, v[0], v[1], v[2], 0, 0, fSeq++) : NULL;
+		break;
+	case kSweetSensorGyro:
+		e = n >= 3 ? IOHIDEvent::gyroEvent(ts, v[0], v[1], v[2], 0, 0, fSeq++) : NULL;
+		break;
+	case kSweetSensorMag:
+		e = n >= 3 ? IOHIDEvent::compassEvent(ts, v[0], v[1], v[2], 0, 0, fSeq++) : NULL;
+		break;
+	case kSweetSensorALS:
+		e = n >= 1 ? IOHIDEvent::ambientLightSensorEvent(ts, (UInt32)(v[0] < 0 ? 0 : v[0])) : NULL;
+		break;
+	case kSweetSensorProx:
+		if (n >= 1 && fAsked) {
+			/* near: the detection kinds backboardd asked for (its DetectionMode), far: none */
+			IOHIDProximityDetectionMask m = v[0] ? (IOHIDProximityDetectionMask)(fMode ? fMode :
+			    (kIOHIDProximityDetectionReceiver | kIOHIDProximityDetectionLargeBodyContact)) : (IOHIDProximityDetectionMask)0;
+			e = IOHIDEvent::proximityEvent(ts, m, v[0] ? 1 : 0);
+			IOLog("SWEET HID: proximity %s (mask %#x)\n", v[0] ? "NEAR" : "far", (unsigned)m);
+		}
+		break;
+	default:
+		break;
+	}
+	if (e) {
+		dispatchEvent(e);
+		e->release();
+	}
+}
+
+extern "C" void sweet_hid_sensor_sample(int kind, uint64_t ts, const int32_t *v, int n);
+void
+sweet_hid_sensor_sample(int kind, uint64_t ts, const int32_t *v, int n)
+{
+	if (kind >= 0 && kind < kSweetSensorN && gSweetSensors[kind]) {
+		gSweetSensors[kind]->sample(ts, v, n);
+	}
+}
