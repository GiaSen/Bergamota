+/*
+ * 3072: the SLPI boots by itself on the Mi 8, SS_AUTO_DELAY_S after the root file system is up (after the audio DSP,
+ * which shares the modem partition's FAT reader), when its files are on the iOS root (tools/dipper-sensor-files.sh);
+ * without them it would crash anyway (USER-PD DOG). kern.sweet_ssc can still run it by hand. No boot-arg: the field is full.
+ */
+#define SS_AUTO_DELAY_S         190u
+static void
+ss_auto_thread(void *arg, wait_result_t w)
+{
+	(void)arg;
+	(void)w;
+	delay((uint64_t)SS_AUTO_DELAY_S * 1000000ull);
+	vnode_t vp = NULLVP;
+	if (vnode_lookup(SS_FILES "/vendor/etc/sensors/sns_reg_config", 0, &vp, vfs_context_kernel()) != 0 || vp == NULLVP) {
+		printf("SWEET SSC: autostart: no sensor files under " SS_FILES " (tools/dipper-sensor-files.sh), SLPI not started\n");
+		(void)thread_terminate(current_thread());
+		return;
+	}
+	vnode_put(vp);
+	if (__atomic_exchange_n(&ss.busy, true, __ATOMIC_ACQUIRE)) {
+		printf("SWEET SSC: autostart: a kern.sweet_ssc run is going on, skipped\n");
+	} else {
+		ss.off = 0;
+		ss.log[0] = 0;
+		ss.runs++;
+		SS_LOG("run %u, autostart %u s after the root\n", ss.runs, SS_AUTO_DELAY_S);
+		if (ss_probe()) {
+			(void)ss_boot();
+		}
+		sweet_log_sync();
+		__atomic_store_n(&ss.busy, false, __ATOMIC_RELEASE);
+	}
+	(void)thread_terminate(current_thread());
+}
+
+void dipper_sensors_init(void);
+void
+dipper_sensors_init(void)
+{
+	thread_t th;
+	if (!sweet_board_is("xiaomi,dipper")) {
+		return;
+	}
+	if (kernel_thread_start(ss_auto_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_set_thread_name(th, "sweet ssc auto");
+		thread_deallocate(th);
+	}
+}
