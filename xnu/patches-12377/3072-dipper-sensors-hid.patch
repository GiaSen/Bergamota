     "the last 64 QMI indications from the SLPI to the pass-through port (3071)");
 
+/*
+ * ---- 3072: the kernel's own SNS client (S4): feeds SweetHIDSensor (iokit/Kernel/arm/hid/SweetHID.cpp). From QRTR port
+ * QR_SC_PORT, same protocol as tools/sweetnet/sweetssc.c (libssc): once the SNS service (400) is up and the PD has had
+ * SC_SETTLE_MS to load its registry, one SUID lookup per kind (default sensor of its data type); then each kind's stream
+ * follows what iOS asks (sweet_ssc_sensor_rate(), from the HID service's ReportInterval): 513 {rate} for streaming
+ * kinds, 514 for on-change ones, 10 to stop. Samples (1025 floats, proximity 769) are converted with integer math only
+ * (no FP in the kernel) and handed to sweet_hid_sensor_sample(): accel in g 16.16 with Apple's sign (gravity at rest
+ * face up = -1 g on z; Android and the SLPI report +9.8 m/s^2), ambient light in lux, proximity near/far.
+ */
+#define QR_SC_PORT              0x4021u
+#define SC_SETTLE_MS            25000u
+#define SC_REQ_TIMEOUT_MS       3000u
+#define SNS_LOOKUP_UID          0xababababababababull
+enum { SC_ACCEL, SC_GYRO, SC_MAG, SC_ALS, SC_PROX, SC_N };
+static const char *const sc_type[SC_N] = { "accel", "gyro", "mag", "ambient_light", "proximity" };
+static const bool sc_on_change[SC_N] = { false, false, false, true, true };
+extern void sweet_hid_sensor_sample(int kind, uint64_t ts, const int32_t *v, int n);
+
+static struct {
+	uint64_t suid_lo[SC_N], suid_hi[SC_N];
+	bool have[SC_N], looked[SC_N];
+	uint32_t want_us[SC_N];         /* what iOS asks: interval in us, 0 = off (written by the HID services) */
+	uint32_t have_us[SC_N];         /* what the SLPI was told */
+	uint32_t node, port;
+	uint16_t txn;
+	bool busy;                      /* a request is out */
+	int busy_kind, busy_what;       /* what it is: 0 lookup, 1 rate */
+	uint32_t busy_us;
+	unsigned sent_ms;
+	bool lookup_answered;
+	unsigned samples[SC_N], requests, errors;
+	bool ts_checked;
+	int64_t ts_skew;                /* mach_absolute_time - SLPI timestamp, first sample */
+} sc;
+
+void sweet_ssc_sensor_rate(int kind, uint32_t interval_us);
+void
+sweet_ssc_sensor_rate(int kind, uint32_t interval_us)
+{
+	if (kind >= 0 && kind < SC_N) {
+		__atomic_store_n(&sc.want_us[kind], interval_us, __ATOMIC_RELEASE);
+	}
+}
+
+/* protobuf, the wire types used here */
+static size_t
+pb_varint(uint8_t *o, uint64_t v)
+{
+	size_t n = 0;
+	do {
+		o[n] = (uint8_t)(v & 0x7f);
+		v >>= 7;
+		o[n++] |= v ? 0x80 : 0;
+	} while (v);
+	return n;
+}
+
+static size_t
+pb_len(uint8_t *o, unsigned field, const void *d, size_t n)
+{
+	size_t k = pb_varint(o, (uint64_t)field << 3 | 2);
+	k += pb_varint(o + k, n);
+	memcpy(o + k, d, n);
+	return k + n;
+}
+
+static size_t
+pb_f64(uint8_t *o, unsigned field, uint64_t v)
+{
+	size_t k = pb_varint(o, (uint64_t)field << 3 | 1);
+	memcpy(o + k, &v, 8);
+	return k + 8;
+}
+
+static size_t
+pb_f32(uint8_t *o, unsigned field, uint32_t v)
+{
+	size_t k = pb_varint(o, (uint64_t)field << 3 | 5);
+	memcpy(o + k, &v, 4);
+	return k + 4;
+}
+
+static size_t
+pb_vi(uint8_t *o, unsigned field, uint64_t v)
+{
+	size_t k = pb_varint(o, (uint64_t)field << 3);
+	return k + pb_varint(o + k, v);
+}
+
+struct pbr {
+	const uint8_t *p, *end;
+};
+struct pbv {
+	unsigned field, wt;
+	uint64_t v;
+	const uint8_t *d;
+	size_t n;
+};
+
+static bool
+pb_rvarint(struct pbr *b, uint64_t *v)
+{
+	*v = 0;
+	for (unsigned s = 0; b->p < b->end && s < 64; s += 7) {
+		uint8_t c = *b->p++;
+		*v |= (uint64_t)(c & 0x7f) << s;
+		if (!(c & 0x80)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static bool
+pb_rnext(struct pbr *b, struct pbv *f)
+{
+	uint64_t k, n;
+	if (b->p >= b->end || !pb_rvarint(b, &k)) {
+		return false;
+	}
+	f->field = (unsigned)(k >> 3);
+	f->wt = (unsigned)(k & 7);
+	f->v = 0;
+	f->d = NULL;
+	f->n = 0;
+	switch (f->wt) {
+	case 0:
+		return pb_rvarint(b, &f->v);
+	case 1:
+		if (b->end - b->p < 8) {
+			return false;
+		}
+		memcpy(&f->v, b->p, 8);
+		b->p += 8;
+		return true;
+	case 5:
+		if (b->end - b->p < 4) {
+			return false;
+		}
+		memcpy(&f->v, b->p, 4);
+		b->p += 4;
+		return true;
+	case 2:
+		if (!pb_rvarint(b, &n) || n > (uint64_t)(b->end - b->p)) {
+			return false;
+		}
+		f->d = b->p;
+		f->n = (size_t)n;
+		b->p += n;
+		return true;
+	default:
+		return false;
+	}
+}
+
+/* round(float(bits) * k_q16 / 65536), saturated; integer only */
+static int32_t
+f32_scale(uint32_t bits, uint64_t k_q16)
+{
+	uint32_t e = (bits >> 23) & 0xff, m = (bits & 0x7fffff) | 0x800000;
+	bool neg = (bits >> 31) != 0;
+	if (e == 0) {
+		return 0;
+	}
+	if (e == 0xff) {
+		return neg ? INT32_MIN : INT32_MAX;
+	}
+	uint64_t p = (uint64_t)m * k_q16, r;
+	int sh = (int)e - 150 - 16;
+	if (sh >= 0) {
+		r = sh > 8 ? (uint64_t)INT32_MAX : p << sh;
+	} else {
+		sh = -sh;
+		r = sh >= 64 ? 0 : (p + (1ull << (sh - 1))) >> sh;
+	}
+	if (r > (uint64_t)INT32_MAX) {
+		r = INT32_MAX;
+	}
+	return neg ? -(int32_t)r : (int32_t)r;
+}
+
+/* one SNS request (SscClientRequest in QMI msg 0x20, TLV 0x01 + report type TLV 0x10 = large) */
+static bool
+sc_send(uint64_t lo, uint64_t hi, uint32_t msg_id, const uint8_t *payload, size_t plen)
+{
+	uint8_t u[24], cfg[8], body[64], pbm[160], q[200];
+	size_t un = 0, cn = 0, bn = 0, n = 0;
+	if (plen > 48) {
+		return false;
+	}
+	un += pb_f64(u + un, 1, lo);
+	un += pb_f64(u + un, 2, hi);
+	cn += pb_vi(cfg + cn, 1, 1);            /* processor: APSS */
+	cn += pb_vi(cfg + cn, 2, 0);            /* suspend mode: wakeup */
+	if (payload) {
+		bn += pb_len(body + bn, 2, payload, plen);
+	}
+	n += pb_len(pbm + n, 1, u, un);
+	n += pb_f32(pbm + n, 2, msg_id);
+	n += pb_len(pbm + n, 3, cfg, cn);
+	n += pb_len(pbm + n, 4, body, bn);
+	uint16_t msg = 0x20, t1 = (uint16_t)(2 + n), pl = (uint16_t)n, t10 = 1, total = (uint16_t)(3 + t1 + 3 + t10);
+	sc.txn = (uint16_t)(sc.txn + 1 ? sc.txn + 1 : 1);
+	q[0] = 0;
+	memcpy(q + 1, &sc.txn, 2);
+	memcpy(q + 3, &msg, 2);
+	memcpy(q + 5, &total, 2);
+	q[7] = 0x01;
+	memcpy(q + 8, &t1, 2);
+	memcpy(q + 10, &pl, 2);
+	memcpy(q + 12, pbm, n);
+	size_t o = 12 + n;
+	q[o] = 0x10;
+	memcpy(q + o + 1, &t10, 2);
+	q[o + 3] = 1;
+	o += 4;
+	sc.requests++;
+	return qs_send(Q_DATA, QR_SC_PORT, sc.node, sc.port, q, (uint32_t)o);
+}
+
+/* one report from the SNS service (indication 0x21 / 0x22, TLV 0x02 = u16 length + SscClientResponse) */
+static void
+sc_report(const uint8_t *pl, size_t plen)
+{
+	struct pbr b = { pl, pl + plen };
+	struct pbv f;
+	uint64_t lo = 0, hi = 0;
+	/* the uid comes first; the events after it */
+	while (pb_rnext(&b, &f)) {
+		if (f.field == 1 && f.wt == 2) {
+			struct pbr u = { f.d, f.d + f.n };
+			struct pbv g;
+			while (pb_rnext(&u, &g)) {
+				lo = g.field == 1 ? g.v : lo;
+				hi = g.field == 2 ? g.v : hi;
+			}
+			continue;
+		}
+		if (f.field != 2 || f.wt != 2) {
+			continue;
+		}
+		struct pbr e = { f.d, f.d + f.n };
+		struct pbv g;
+		uint32_t id = 0;
+		uint64_t ts = 0;
+		const uint8_t *pd = NULL;
+		size_t pn = 0;
+		while (pb_rnext(&e, &g)) {
+			if (g.field == 1) {
+				id = (uint32_t)g.v;
+			} else if (g.field == 2) {
+				ts = g.v;
+			} else if (g.field == 3 && g.wt == 2) {
+				pd = g.d;
+				pn = g.n;
+			}
+		}
+		if (lo == SNS_LOOKUP_UID && hi == SNS_LOOKUP_UID && id == 768 && pd) {      /* SUID event */
+			struct pbr s = { pd, pd + pn };
+			struct pbv h;
+			char type[32];
+			memset(type, 0, sizeof(type));
+			uint64_t flo = 0, fhi = 0;
+			bool found = false;
+			while (pb_rnext(&s, &h)) {
+				if (h.field == 1 && h.wt == 2) {
+					memcpy(type, h.d, MIN(h.n, sizeof(type) - 1));
+				} else if (h.field == 2 && h.wt == 2 && !found) {
+					struct pbr u = { h.d, h.d + h.n };
+					struct pbv x;
+					while (pb_rnext(&u, &x)) {
+						flo = x.field == 1 ? x.v : flo;
+						fhi = x.field == 2 ? x.v : fhi;
+					}
+					found = true;
+				}
+			}
+			for (int k = 0; k < SC_N; k++) {
+				if (strcmp(type, sc_type[k]) == 0) {
+					sc.have[k] = found;
+					sc.looked[k] = true;
+					sc.suid_lo[k] = flo;
+					sc.suid_hi[k] = fhi;
+					sc.lookup_answered = true;
+					SG_LOG("sensors: %s -> %s %016llx%016llx\n", type, found ? "SUID" : "none", fhi, flo);
+				}
+			}
+			continue;
+		}
+		int k;
+		for (k = 0; k < SC_N; k++) {
+			if (sc.have[k] && sc.suid_lo[k] == lo && sc.suid_hi[k] == hi) {
+				break;
+			}
+		}
+		if (k == SC_N || !pd || !sc.have_us[k]) {
+			continue;
+		}
+		int32_t v[4] = { 0, 0, 0, 0 };
+		int nv = 0;
+		struct pbr s = { pd, pd + pn };
+		struct pbv h;
+		if (id == 1025) {               /* sns_std_sensor_event: repeated float (packed) data = 1, status = 2 */
+			/* accel m/s^2 -> g 16.16 (2^32 / 9.80665); gyro rad/s and mag uT -> 16.16; light lux -> integer */
+			uint64_t kq = k == SC_ACCEL ? 437964779ull : k == SC_GYRO || k == SC_MAG ? 4294967296ull : 65536ull;
+			while (pb_rnext(&s, &h)) {
+				if (h.field == 1 && h.wt == 2) {
+					for (size_t o = 0; o + 4 <= h.n && nv < 4; o += 4) {
+						uint32_t bits;
+						memcpy(&bits, h.d + o, 4);
+						v[nv++] = f32_scale(bits, kq);
+					}
+				} else if (h.field == 1 && h.wt == 5 && nv < 4) {
+					v[nv++] = f32_scale((uint32_t)h.v, kq);
+				}
+			}
+			if (k == SC_ACCEL) {    /* Apple's sign: the gravity vector, not the reaction */
+				for (int i = 0; i < nv; i++) {
+					v[i] = -v[i];
+				}
+			}
+		} else if (id == 769) {         /* proximity: near = 1, distance = 2 */
+			while (pb_rnext(&s, &h)) {
+				if (h.field == 1 && h.wt == 0) {
+					v[0] = (int32_t)h.v;
+				} else if (h.field == 2 && h.wt == 0) {
+					v[1] = (int32_t)h.v;
+				}
+			}
+			nv = 2;
+		} else {
+			continue;               /* config events (768) and others */
+		}
+		uint64_t now = mach_absolute_time();
+		if (!sc.ts_checked) {
+			sc.ts_checked = true;
+			sc.ts_skew = (int64_t)(now - ts);
+			SG_LOG("sensors: first %s sample: SLPI timestamp %llu, mach_absolute_time %llu (difference %lld)\n",
+			    sc_type[k], ts, now, sc.ts_skew);
+		}
+		/* the SLPI's QTimer and xnu's timebase: the SLPI time when they agree within 1 s, else now */
+		uint64_t at = ts && (int64_t)(now - ts) >= 0 && now - ts < 19200000ull ? ts : now;
+		sc.samples[k]++;
+		sweet_hid_sensor_sample(k, at, v, nv);
+	}
+}
+
+/* QMI from the SNS service to our client port */
+static void
+sc_rx(uint32_t node, uint32_t port, const uint8_t *p, uint32_t len)
+{
+	uint16_t txn, msg, mlen, vl = 0;
+	if (len < 7) {
+		return;
+	}
+	memcpy(&txn, p + 1, 2);
+	memcpy(&msg, p + 3, 2);
+	memcpy(&mlen, p + 5, 2);
+	const uint8_t *t = p + 7, *v;
+	uint32_t tl = MIN((uint32_t)mlen, len - 7);
+	(void)node;
+	(void)port;
+	if (p[0] == 2 && sc.busy && txn == sc.txn) {
+		uint16_t res = 0xffff, err = 0xffff;
+		if ((v = qs_tlv(t, tl, 2, &vl)) && vl >= 4) {
+			memcpy(&res, v, 2);
+			memcpy(&err, v + 2, 2);
+		}
+		if (res) {
+			sc.errors++;
+			SG_LOG("sensors: %s %s refused: QMI result %u error %u\n", sc.busy_what ? "rate of" : "lookup of",
+			    sc_type[sc.busy_kind], res, err);
+			if (sc.busy_what == 0) {
+				sc.looked[sc.busy_kind] = true;         /* no retry */
+			} else {
+				sc.have_us[sc.busy_kind] = sc.busy_us;  /* no retry until iOS asks something else */
+			}
+			sc.busy = false;
+		} else if (sc.busy_what == 1) {
+			sc.have_us[sc.busy_kind] = sc.busy_us;
+			SG_LOG("sensors: %s %s\n", sc_type[sc.busy_kind], sc.busy_us ? "on" : "off");
+			sc.busy = false;
+		}
+		/* an accepted lookup stays busy until its SUID event (sc_step) */
+		return;
+	}
+	if (p[0] == 4 && (msg == 0x21 || msg == 0x22) && (v = qs_tlv(t, tl, 2, &vl)) && vl >= 2) {
+		uint16_t pl;
+		memcpy(&pl, v, 2);
+		if (pl <= vl - 2) {
+			sc_report(v + 2, pl);
+		}
+	}
+}
+
+/* the thread's step: lookups once, then each kind's stream to what iOS asks */
+static void
+sc_step(void)
+{
+	if (!sg.sns_port || sg.fatal || fr.state != FR_NEXT2 || sg_ms() < SC_SETTLE_MS) {
+		return;
+	}
+	sc.node = sg.sns_node;
+	sc.port = sg.sns_port;
+	if (sc.busy) {
+		if (sc.busy_what == 0 && sc.looked[sc.busy_kind]) {
+			sc.busy = false;
+		} else if (sg_ms() - sc.sent_ms > SC_REQ_TIMEOUT_MS) {
+			SG_LOG("sensors: no answer to the %s of %s in %u ms\n", sc.busy_what ? "rate" : "lookup", sc_type[sc.busy_kind],
+			    SC_REQ_TIMEOUT_MS);
+			sc.errors++;
+			if (sc.busy_what == 0) {
+				sc.looked[sc.busy_kind] = true;         /* no retry */
+			}
+			sc.busy = false;
+		}
+		if (sc.busy) {
+			return;
+		}
+	}
+	for (int k = 0; k < SC_N; k++) {
+		if (!sc.looked[k]) {
+			uint8_t req[48];
+			size_t n = pb_len(req, 1, sc_type[k], strlen(sc_type[k]));
+			n += pb_vi(req + n, 2, 0);
+			n += pb_vi(req + n, 3, 1);
+			sc.busy = sc_send(SNS_LOOKUP_UID, SNS_LOOKUP_UID, 512, req, n);
+			sc.busy_kind = k;
+			sc.busy_what = 0;
+			sc.sent_ms = sg_ms();
+			if (!sc.busy) {
+				sc.looked[k] = true;
+			}
+			return;
+		}
+	}
+	for (int k = 0; k < SC_N; k++) {
+		uint32_t want = __atomic_load_n(&sc.want_us[k], __ATOMIC_ACQUIRE);
+		if (!sc.have[k] || want == sc.have_us[k]) {
+			continue;
+		}
+		uint8_t req[8];
+		size_t n = 0;
+		uint32_t msg;
+		if (!want) {
+			msg = 10;
+		} else if (sc_on_change[k]) {
+			msg = 514;
+		} else {
