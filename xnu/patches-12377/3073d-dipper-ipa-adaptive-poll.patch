--- a/bsd/dev/dipper_ipa.c.inc
+++ b/bsd/dev/dipper_ipa.c.inc
@@ -25,6 +25,9 @@
  *   DRIVER_INIT_COMPLETE, 16 a log line per packet, 32 no TLV 0x18 (skip_uc_load) in INIT_DRIVER
  * kern.sweet_ipa_session (string, write): "ADDR MASK GATEWAY MTU" gives rmnet0 the data session's address; "down".
  * kern.sweet_ipa_status (string): where it stands.
+ * kern.sweet_ipa_idle_ms (3073d): the receive thread's longest poll interval while rmnet0 is up and quiet (default 16 ms):
+ *   1 ms for 100 ms after a packet came in or went out (an LTE round trip), then doubling up to this; a packet sent wakes
+ *   it at once. With rmnet0 down: every second.
  *
  * Sources: Linux drivers/net/ipa (ipa_data-v3.5.1.c, reg/ipa_reg-v3.1.c, reg/gsi_reg-v3.1.c, gsi.c, ipa_endpoint.c,
  * ipa_table.c, ipa_mem.c, ipa_qmi.c, ipa_qmi_msg.c, ipa_smp2p.c) for the layout and the values; HakiOS's OnePlus 6T port
@@ -209,6 +212,12 @@ static struct {
 static const uint8_t ipa_mac[ETHER_ADDR_LEN] = { 0x02, 0x53, 0x57, 0x49, 0x50, 0x41 };     /* rmnet0: "SWIPA" */
 static const uint8_t ipa_gw_mac[ETHER_ADDR_LEN] = { 0x02, 0x53, 0x57, 0x49, 0x50, 0x01 };  /* the made-up router */
 static int ipa_rx_chan;
+/* 3073d: the receive thread's poll interval (adaptive: there is no interrupt here, every driver of this port polls) */
+static uint32_t ipa_idle_max_ms = 16;           /* kern.sweet_ipa_idle_ms */
+static volatile uint32_t ipa_rx_wait_ms;        /* the thread's current interval */
+static volatile uint32_t ipa_rx_kick;           /* a packet was sent: poll again at once */
+static uint64_t ipa_rx_wakeups;
+#define IPA_RX_FAST_MS          100u            /* 1 ms polls this long after the last packet in or out */
 /* 3073b: where stage 3 asks TrustZone to put ipa_fws, and how much (0: the image's extent rounded up to 4 KB) */
 static uint32_t ipa_fw_pa = IPA_FW_PA, ipa_fw_size;
 
@@ -1219,6 +1228,11 @@ ipa_if_output(ifnet_t ifp, mbuf_t m)
 			bool ok = ipa_transmit(m, ETHER_HDR_LEN, len - ETHER_HDR_LEN);
 			ifnet_stat_increment_out(ifp, ok ? 1 : 0, ok ? (uint32_t)len : 0, ok ? 0 : 1);
 			ipa.tx_ip++;
+			/* 3073d: the answer comes soon: poll at 1 ms again (wake the thread only if it sleeps longer) */
+			__atomic_store_n(&ipa_rx_kick, 1, __ATOMIC_RELEASE);
+			if (ipa_rx_wait_ms > 1) {
+				thread_wakeup(&ipa_rx_chan);
+			}
 		} else if (type == ETHERTYPE_ARP) {
 			ipa.tx_arp++;
 			ipa_arp_answer(m);
@@ -1292,7 +1306,8 @@ ipa_smmu_watch(void)
 static void
 ipa_rx_thread(__unused void *arg, __unused wait_result_t wr)
 {
-	uint64_t next_watch = 0;
+	uint64_t next_watch = 0, last_active = 0, fast_window;
+	nanoseconds_to_absolutetime((uint64_t)IPA_RX_FAST_MS * NSEC_PER_MSEC, &fast_window);
 	thread_set_thread_name(current_thread(), "sweet ipa rx");
 	for (;;) {
 		unsigned n = 0;
@@ -1315,10 +1330,37 @@ ipa_rx_thread(__unused void *arg, __unused wait_result_t wr)
 				ipa_input(rc.head);
 			}
 		}
+		/*
+		 * 3073d: until 3073c it polled every 2 ms whenever rmnet0 was up (about 500 wake-ups a second with data idle) and
+		 * every 50 ms when down. Now: 1 ms for IPA_RX_FAST_MS after the last packet in or out (so an answer is not held
+		 * back), then doubling while quiet up to kern.sweet_ipa_idle_ms (16), every second while rmnet0 is down (the SMMU
+		 * watch only).
+		 */
+		bool kicked = __atomic_exchange_n(&ipa_rx_kick, 0, __ATOMIC_ACQ_REL) != 0;
+		uint32_t wait_ms = ipa_rx_wait_ms;
+		uint64_t now = mach_absolute_time();
+		if (n || kicked) {
+			last_active = now;
+		}
+		if (!ipa.if_up) {
+			wait_ms = 1000;
+		} else if (now - last_active < fast_window) {
+			wait_ms = 1;
+		} else {
+			uint32_t mx = ipa_idle_max_ms ? ipa_idle_max_ms : 1;
+			mx = mx > 1000 ? 1000 : mx;
+			wait_ms = (wait_ms == 0 || wait_ms >= mx) ? mx : (wait_ms * 2 > mx ? mx : wait_ms * 2);
+		}
+		ipa_rx_wait_ms = wait_ms;
 		uint64_t deadline;
-		clock_interval_to_deadline(n ? 1 : (ipa.if_up ? 2 : 50), NSEC_PER_MSEC, &deadline);
+		clock_interval_to_deadline(wait_ms, NSEC_PER_MSEC, &deadline);
 		(void)assert_wait_deadline((event_t)&ipa_rx_chan, THREAD_UNINT, deadline);
-		thread_block(THREAD_CONTINUE_NULL);
+		if (__atomic_load_n(&ipa_rx_kick, __ATOMIC_ACQUIRE)) {
+			clear_wait(current_thread(), THREAD_AWAKENED);  /* sent while we were getting ready to sleep */
+		} else {
+			thread_block(THREAD_CONTINUE_NULL);
+		}
+		ipa_rx_wakeups++;
 	}
 }
 
