+#define QR_NODE_LOCAL           1u
+#define QR_PORT_CTRL            0xfffffffeu
+#define QR_PDM_PORT             0x4002u
+#define QR_PDM_SERVICE          0x40u
+#define QR_PDM_INSTANCE         0x101u          /* qmi_add_server: version 0x101 | instance 0 << 8 */
+enum { Q_DATA = 1, Q_HELLO = 2, Q_BYE = 3, Q_NEW_SERVER = 4, Q_DEL_SERVER = 5, Q_DEL_CLIENT = 6, Q_RESUME_TX = 7,
+       Q_NEW_LOOKUP = 10, Q_DEL_LOOKUP = 11 };
+extern uint32_t sweet_pdm_answer(const uint8_t *req, uint32_t len, uint8_t *r);
+/* the DSP's service notifier (QMI SERVREG_NOTIFIER 0x42, pdr_internal.h): our listener for the audio PD */
+#define QR_NOTIF_SERVICE        0x42u
+#define QR_NOTIF_PORT           0x4010u         /* our client socket */
+#define SERVREG_REGISTER_LISTENER 0x20u
+#define SERVREG_STATE_UPDATED   0x22u
+#define SERVREG_SET_ACK         0x23u
+static const char au_pd_path[] = "msm/adsp/audio_pd";
+static struct {
+	uint32_t node, port;            /* the notifier, from its NEW_SERVER */
+	uint16_t txn;
+	bool asked, answered;
+	uint32_t state;
+} nf;
+
+static const char *
+nf_state(uint32_t st)
+{
+	switch (st) {
+	case 0x0fffffffu: return "DOWN";
+	case 0x1fffffffu: return "UP";
+	case 0x2fffffffu: return "EARLY_DOWN";
+	case 0x7fffffffu: return "UNINIT";
+	default: return "?";
+	}
+}
+
+static bool qr_send(uint32_t type, uint32_t src_port, uint32_t dst_node, uint32_t dst_port, const void *pl, uint32_t size);
+
+/* pdr_register_listener(): enable (TLV 1, u8 1) + service path (TLV 2, the string without NUL) */
+static void
+nf_register(void)
+{
+	uint8_t q[7 + 4 + 3 + sizeof(au_pd_path)];
+	uint16_t plen = (uint16_t)(sizeof(au_pd_path) - 1), one = 1, mlen, msg = SERVREG_REGISTER_LISTENER;
+	uint32_t n = 7;
+	q[0] = 0;                               /* QMI_REQUEST */
+	nf.txn++;
+	memcpy(q + 1, &nf.txn, 2);
+	memcpy(q + 3, &msg, 2);
+	q[n] = 1;
+	memcpy(q + n + 1, &one, 2);
+	q[n + 3] = 1;
+	n += 4;
+	q[n] = 2;
+	memcpy(q + n + 1, &plen, 2);
+	memcpy(q + n + 3, au_pd_path, plen);
+	n += 3 + plen;
+	mlen = (uint16_t)(n - 7);
+	memcpy(q + 5, &mlen, 2);
+	nf.asked = qr_send(1, QR_NOTIF_PORT, nf.node, nf.port, q, n);
+	printf("SWEET AUDIO: servreg: register listener for %s at %u:%#x %s\n", au_pd_path, nf.node, nf.port,
+	    nf.asked ? "sent" : "NOT SENT");
+}
+
+/* a TLV's value in a QMI message body, NULL when absent */
+static const uint8_t *
+nf_tlv(const uint8_t *t, uint32_t len, uint8_t type, uint16_t *vlen)
+{
+	for (uint32_t o = 0; o + 3 <= len;) {
+		uint16_t l;
+		memcpy(&l, t + o + 1, 2);
+		if (o + 3 + l > len) {
+			return NULL;
+		}
+		if (t[o] == type) {
+			*vlen = l;
+			return t + o + 3;
+		}
+		o += 3 + l;
+	}
+	return NULL;
+}
+
+/* the notifier's answer (type 2) or state indication (type 4) */
+static void
+nf_rx(uint32_t snode, uint32_t sport, const uint8_t *p, uint32_t len)
+{
+	if (len < 7) {
+		return;
+	}
+	uint16_t txn, msg, mlen, vl = 0;
+	memcpy(&txn, p + 1, 2);
+	memcpy(&msg, p + 3, 2);
+	memcpy(&mlen, p + 5, 2);
+	const uint8_t *t = p + 7, *v;
+	uint32_t tl = MIN((uint32_t)mlen, len - 7);
+	if (p[0] == 2 && msg == SERVREG_REGISTER_LISTENER) {
+		uint16_t res = 0xffff, err = 0xffff;
+		if ((v = nf_tlv(t, tl, 2, &vl)) && vl >= 4) {
+			memcpy(&res, v, 2);
+			memcpy(&err, v + 2, 2);
+		}
+		uint32_t st = 0;
+		bool have = (v = nf_tlv(t, tl, 0x10, &vl)) && vl >= 4;
+		if (have) {
+			memcpy(&st, v, 4);
+			nf.state = st;
+		}
+		nf.answered = true;
+		printf("SWEET AUDIO: servreg: listener registered: result %u error %u, %s state %#x (%s)\n", res, err, au_pd_path,
+		    st, have ? nf_state(st) : "not given");
+	} else if (p[0] == 4 && msg == SERVREG_STATE_UPDATED) {
+		uint32_t st = 0;
+		uint16_t tid = 0;
+		if ((v = nf_tlv(t, tl, 1, &vl)) && vl >= 4) {
+			memcpy(&st, v, 4);
+		}
+		if ((v = nf_tlv(t, tl, 3, &vl)) && vl >= 2) {
+			memcpy(&tid, v, 2);
+		}
+		nf.state = st;
+		printf("SWEET AUDIO: servreg: %s is now %#x (%s), transaction %u -> ack\n", au_pd_path, st, nf_state(st), tid);
+		/* pdr_send_indack_msg(): SERVREG_SET_ACK with the path (TLV 1) and the transaction (TLV 2) */
+		uint8_t q[7 + 3 + sizeof(au_pd_path) + 5];
+		uint16_t plen = (uint16_t)(sizeof(au_pd_path) - 1), two = 2, m = SERVREG_SET_ACK, ml;
+		uint32_t n = 7;
+		q[0] = 0;
+		nf.txn++;
+		memcpy(q + 1, &nf.txn, 2);
+		memcpy(q + 3, &m, 2);
+		q[n] = 1;
+		memcpy(q + n + 1, &plen, 2);
+		memcpy(q + n + 3, au_pd_path, plen);
+		n += 3 + plen;
+		q[n] = 2;
+		memcpy(q + n + 1, &two, 2);
+		memcpy(q + n + 3, &tid, 2);
+		n += 5;
+		ml = (uint16_t)(n - 7);
+		memcpy(q + 5, &ml, 2);
+		(void)qr_send(1, QR_NOTIF_PORT, snode, sport, q, n);
+	} else {
+		printf("SWEET AUDIO: servreg: QMI type %u message %#x (%u bytes)\n", p[0], msg, len);
+	}
+}
+
+static bool
+qr_send(uint32_t type, uint32_t src_port, uint32_t dst_node, uint32_t dst_port, const void *pl, uint32_t size)
+{
+	static uint8_t pkt[32 + 600];
+	uint32_t h[8] = { 1, type, QR_NODE_LOCAL, src_port, 0, size, dst_node, dst_port };
+	uint32_t padded = (size + 3u) & ~3u;
+	if (padded > sizeof(pkt) - 32) {
+		return false;
+	}
+	memcpy(pkt, h, 32);
+	memcpy(pkt + 32, pl, size);
+	bzero(pkt + 32 + size, padded - size);
+	return gl_send(CH_QRTR, pkt, 32 + padded);
+}
+
+static void
+qr_rx(const uint8_t *p, uint32_t len)
+{
+	uint32_t h[8];
+	if (len < 32 || p[0] != 1) {
+		printf("SWEET AUDIO: qrtr: version %u packet of %u bytes ignored\n", len ? p[0] : 0, len);
+		return;
+	}
+	memcpy(h, p, 32);
+	uint32_t type = h[1], snode = h[2], sport = h[3], confirm = h[4], size = h[5], dport = h[7];
+	if (32 + size > len) {
+		return;
+	}
+	const uint8_t *pl = p + 32;
+	gl.qnode = snode;
+	switch (type) {
+	case Q_HELLO: {
+		uint32_t hello[5] = { Q_HELLO, 0, 0, 0, 0 };
+		uint32_t srv[5] = { Q_NEW_SERVER, QR_PDM_SERVICE, QR_PDM_INSTANCE, QR_NODE_LOCAL, QR_PDM_PORT };
+		bool a = qr_send(Q_HELLO, QR_PORT_CTRL, snode, QR_PORT_CTRL, hello, sizeof(hello));
+		bool b = qr_send(Q_NEW_SERVER, QR_PORT_CTRL, snode, QR_PORT_CTRL, srv, sizeof(srv));
+		printf("SWEET AUDIO: qrtr: hello from node %u -> hello %s, service locator 0x40 at %u:%#x %s\n", snode,
+		    a ? "sent" : "NOT SENT", QR_NODE_LOCAL, QR_PDM_PORT, b ? "announced" : "NOT ANNOUNCED");
+		break;
+	}
+	case Q_NEW_SERVER:
+	case Q_DEL_SERVER:
+		if (size >= 20) {
+			uint32_t v[5];
+			memcpy(v, pl, 20);
+			gl.servers++;
+			printf("SWEET AUDIO: qrtr: the DSP %s service %u (%#x) version %u instance %u at %u:%#x\n",
+			    type == Q_NEW_SERVER ? "offers" : "removes", v[1], v[1], v[2] & 0xff, v[2] >> 8, v[3], v[4]);
+			if (type == Q_NEW_SERVER && v[1] == QR_NOTIF_SERVICE && (v[2] >> 8) == 74 && !nf.asked) {
+				nf.node = v[3];
+				nf.port = v[4];
+				nf_register();
+			}
+		}
+		break;
+	case Q_NEW_LOOKUP:
+		if (size >= 20) {
+			uint32_t v[5];
+			memcpy(v, pl, 20);
+			printf("SWEET AUDIO: qrtr: the DSP looks up service %#x instance %#x\n", v[1], v[2]);
+		}
+		break;
+	case Q_DATA:
+		if (dport == QR_PDM_PORT) {
+			uint8_t r[512];
+			uint32_t n = sweet_pdm_answer(pl, size, r);
+			gl.pdm_reqs++;
+			if (n) {
+				(void)qr_send(Q_DATA, QR_PDM_PORT, snode, sport, r, n);
+			}
+		} else if (dport == QR_NOTIF_PORT) {
+			nf_rx(snode, sport, pl, size);
+		} else {
+			printf("SWEET AUDIO: qrtr: %u bytes from %u:%#x to port %#x (no server)\n", size, snode, sport, dport);
+		}
+		if (confirm) {
+			uint32_t r[5] = { Q_RESUME_TX, QR_NODE_LOCAL, dport, 0, 0 };
+			(void)qr_send(Q_RESUME_TX, dport, snode, sport, r, sizeof(r));
+		}
+		break;
+	case Q_RESUME_TX:
+	case Q_DEL_CLIENT:
+		break;
+	default:
+		printf("SWEET AUDIO: qrtr: control %u from %u:%#x (%u bytes)\n", type, snode, sport, size);
+		break;
+	}
+}
