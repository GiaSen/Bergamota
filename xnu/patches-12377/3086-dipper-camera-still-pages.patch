+/* the window's level-2 table (GiB 1 of the bank's level-1 table), made once; with smmu_lock held */
+static int
+smmu_w32_table(void)
+{
+	if (smmu_w32_l2v) {
+		return 0;
+	}
+	vm_offset_t l2v = 0;
+	if (kmem_alloc_contig(kernel_map, &l2v, L1_SIZE, PAGE_MASK, 0, 0, KMA_DATA | KMA_ZERO | KMA_PERMANENT,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)l2v);
+	if (!pn) {
+		return ENOMEM;
+	}
+	sweet_dma_sync_va((const void *)l2v, L1_SIZE);
+	smmu_w32_l2v = l2v;
+	((volatile uint64_t *)smmu_l1v)[1] = ptoa_64(pn) | 3;   /* table */
+	sweet_dma_sync_va((const void *)smmu_l1v, L1_SIZE);
+	return 0;
+}
+
+/* both banks' TLBs after a window change; with smmu_lock held */
+static void
+smmu_w32_tlbi(void)
+{
+	uint32_t id1 = smmu_rd(0x24);
+	unsigned pgshift = (id1 >> 31) ? 16 : 12;
+	for (int b = 0; b < 2; b++) {
+		int bank = b ? smmu_cb2 : smmu_cb;
+		if (bank < 0) {
+			continue;
+		}
+		uint32_t cb = ((1u << (((id1 >> 28) & 7) + 1)) << pgshift) + ((uint32_t)bank << pgshift);
+		smmu_wr(cb + 0x618, 0);                 /* TLBIALL */
+		smmu_wr(cb + 0x7f0, 0);                 /* TLBSYNC */
+		for (int t = 0; t < 100000 && (smmu_rd(cb + 0x7f4) & 1); t++) {
+			delay(1);
+		}
+	}
+}
