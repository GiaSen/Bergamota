+/*
+ * 3085d: a wired kernel buffer of any pages (not physically contiguous) in the same 32-bit window, page by page: level-3
+ * tables (4 KiB pages, one table a 2 MiB slot) under the window's level-2 slots. Only the buffer's own pages are mapped, so
+ * a write master running past its end meets unmapped addresses (a context fault, terminated; with HUPCF the bank's other
+ * masters go on) instead of the kernel memory that shares the buffer's 2 MiB blocks. va and len page aligned (3085e: the
+ * rest of the last 2 MiB slot stays unmapped); the buffer must stay wired for good (never unmapped). *iova = va's address.
+ */
+int sweet_smmu_map32_pages(vm_offset_t va, uint64_t len, uint32_t *iova);
+int
+sweet_smmu_map32_pages(vm_offset_t va, uint64_t len, uint32_t *iova)
+{
+	int error = 0;
+	vm_offset_t l3v = 0;
+
+	if (!iova || !va || (va & PAGE_MASK) || len == 0 || (len & PAGE_MASK) || len > (64ull << 20)) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&smmu_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	if (smmu_cb < 0 || smmu_base == 0 || smmu_l1v == 0) {
+		error = ENODEV;
+		goto out;
+	}
+	unsigned nb = (unsigned)((len + 0x1fffffull) >> 21);
+	if (smmu_w32_next + nb > 512) {
+		error = ENOSPC;
+		goto out;
+	}
+	if ((error = smmu_w32_table()) != 0) {
+		goto out;
+	}
+	if (kmem_alloc_contig(kernel_map, &l3v, round_page((vm_size_t)nb * L1_SIZE), PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		error = ENOMEM;
+		goto out;
+	}
+	ppnum_t tpn = pmap_find_phys(kernel_pmap, (addr64_t)l3v);
+	if (!tpn) {
+		error = ENOMEM;
+		goto out;
+	}
+	uint64_t l3pa = ptoa_64(tpn);
+	volatile uint64_t *l3 = (volatile uint64_t *)l3v;
+	for (uint64_t off = 0; off < len; off += PAGE_SIZE) {
+		ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)(va + off));
+		if (!pn) {
+			error = EFAULT;         /* not wired: nothing mapped (the tables are permanent, unused) */
+			goto out;
+		}
+		uint64_t pa = ptoa_64(pn);
+		for (uint64_t s4 = 0; s4 < PAGE_SIZE; s4 += 0x1000u) {
+			l3[(off + s4) >> 12] = (pa + s4) | 1u << 10 | 2u << 8 | 1u << 6 | 3;     /* page, AF, OSH, RW, Normal NC */
+		}
+	}
+	sweet_dma_sync_va((const void *)l3v, (size_t)nb * L1_SIZE);
+	volatile uint64_t *l2 = (volatile uint64_t *)smmu_w32_l2v;
+	for (unsigned k = 0; k < nb; k++) {
+		l2[smmu_w32_next + k] = (l3pa + (uint64_t)k * L1_SIZE) | 3;     /* table */
+	}
+	sweet_dma_sync_va((const void *)smmu_w32_l2v, L1_SIZE);
+	smmu_w32_tlbi();
+	*iova = 0x40000000u + (smmu_w32_next << 21);
+	smmu_w32_next += nb;
+	printf("SWEET SMMU: bank %d: %llu KiB of pages at 32-bit IOVA %#x (level-3 tables at %#llx)\n", smmu_cb, len >> 10, *iova, l3pa);
+out:
+	__atomic_store_n(&smmu_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
