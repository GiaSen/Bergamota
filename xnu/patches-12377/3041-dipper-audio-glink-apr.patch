 #define AU_CHUNK                (1u << 20)
+#define GL_DESC                 478u
+#define GL_TX_ITEM              479u            /* XPRT_FIFO_0: ours */
+#define GL_RX_ITEM              480u            /* XPRT_FIFO_1: the DSP's */
+#define GL_TX_SIZE              0x4000u
+#define GL_DOORBELL             8u              /* glink-smem-native-xprt-adsp qcom,irq-mask = <0x100> */
+#define GL_FEATURE_REUSE        1u
+#define GL_LCID                 1u              /* our id for apr_audio_svc */
+#define GL_INTENTS              5u
+#define GL_INTENT_SIZE          4096u
+#define GL_MAX_LI               16u
+#define GL_MAX_RI               64u
+#define GL_TX_MAX               0x2000u
+#define APR_DOMAIN_APPS         5u
+#define APR_DOMAIN_ADSP         4u
+#define APR_SVC_ADSP_CORE       3u
+#define APR_HDR_FIELD_SEQ_CMD   0x0180u         /* APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD, APR_HDR_LEN(32), APR_PKT_VER) */
+#define APR_BASIC_RSP_RESULT    0x000110e8u
