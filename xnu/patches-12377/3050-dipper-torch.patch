+#define TOR_TGR_CURRENT(n)      (TOR_BASE + 0x43 + (n)) /* bits 6:0: mA / IRES - 1 */
+#define TOR_MOD_CTRL            (TOR_BASE + 0x46)       /* bit 7 module enable */
+#define TOR_IRES                (TOR_BASE + 0x47)       /* 2 bits per LED: 0 = 12.5 mA steps */
+#define TOR_STROBE_CTRL(n)      (TOR_BASE + 0x49 + (n)) /* bit 2: 0 = software strobe */
+#define TOR_EN_LED_CTRL         (TOR_BASE + 0x4c)       /* bit n: LED n on */
+#define TOR_HDRM_PRGM(n)        (TOR_BASE + 0x4d + (n)) /* read only here */
+#define TOR_LEDS                0x03u                   /* led_switch_0 qcom,led-mask */
+#define TOR_NLEDS               2u
+#define TOR_IRES_UA             12500u
+#define TOR_SAFETY_TMR_OFF      0x13u
+#define TOR_MAX_MA              150u                    /* per LED at level 1000: half the DT's torch max-current 300 */
+#define TOR_LEVEL_MAX           1000u
