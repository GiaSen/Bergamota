     hap_sysctl, "S", "Mi 8 vibration motor: u32 ms [+ u32 mV] in, the state out (bsd/dev/dipper_haptics.c)");
 
+/* ---- the flashlight (3050) ---- */
+
+static int
+tor_wr(unsigned addr, uint8_t v)
+{
+	int e = sweet_spmi_write(HAP_SID, addr, &v, 1);
+	if (e) {
+		tor.errors++;
+	}
+	return e;
+}
+
+static int
+tor_update(unsigned addr, uint8_t mask, uint8_t v)
+{
+	uint8_t old = 0;
+	if (sweet_spmi_read(HAP_SID, addr, &old) != 0) {
+		tor.errors++;
+		return -1;
+	}
+	return tor_wr(addr, (uint8_t)((old & ~mask) | (v & mask)));
+}
+
+/* get_current_reg_code(): mA / IRES - 1, rounded; at least the 12.5 mA step */
+static uint8_t
+tor_code(uint32_t level)
+{
+	uint32_t ua = level * TOR_MAX_MA;                       /* level/1000 * TOR_MAX_MA mA = level * TOR_MAX_MA uA */
+	uint32_t steps = (ua + TOR_IRES_UA / 2) / TOR_IRES_UA;
+	return (uint8_t)(steps > 1 ? steps - 1 : 0);
+}
+
+/* qpnp_flash_led_switch_disable(): LEDs off, module off, current 0, safety timer off; hap_mtx held */
+static void
+tor_off(void)
+{
+	(void)tor_update(TOR_EN_LED_CTRL, TOR_LEDS, 0);
+	(void)tor_update(TOR_MOD_CTRL, 0x80, 0);
+	for (unsigned n = 0; n < TOR_NLEDS; n++) {
+		(void)tor_update(TOR_TGR_CURRENT(n), 0x7f, 0);
+		(void)tor_wr(TOR_SAFETY_TMR(n), TOR_SAFETY_TMR_OFF);
+	}
+	tor.on = false;
+	tor.level = 0;
+}
+
+/* qpnp_flash_led_switch_set(on) for led_switch_0 in torch mode, or a new level while on; hap_mtx held */
+static int
+tor_set(uint32_t level)
+{
+	uint8_t code = tor_code(level);
+	if (tor.on) {
+		for (unsigned n = 0; n < TOR_NLEDS; n++) {
+			if (tor_update(TOR_TGR_CURRENT(n), 0x7f, code) != 0) {
+				tor_off();
+				return EIO;
+			}
+		}
+		tor.level = level;
+		return 0;
+	}
+	bool ok = tor_update(TOR_IRES, 0x0f, 0x00) == 0;        /* 12.5 mA steps for LED1 and LED2 */
+	for (unsigned n = 0; ok && n < TOR_NLEDS; n++) {
+		ok = tor_update(TOR_STROBE_CTRL(n), 0x04, 0x00) == 0 &&    /* software strobe */
+		    tor_update(TOR_TGR_CURRENT(n), 0x7f, code) == 0 &&
+		    tor_wr(TOR_SAFETY_TMR(n), TOR_SAFETY_TMR_OFF) == 0;
+	}
+	ok = ok && tor_update(TOR_MOD_CTRL, 0x80, 0x80) == 0 && tor_update(TOR_EN_LED_CTRL, TOR_LEDS, TOR_LEDS) == 0;
+	if (!ok) {
+		tor_off();
+		return EIO;
+	}
+	tor.on = true;
+	tor.level = level;
+	tor.ons++;
+	return 0;
+}
+
+static void
+tor_status(char *text, size_t len, const char *what)
+{
+	uint8_t st1 = 0, st2 = 0, mod = 0, en = 0, ires = 0, cur[TOR_NLEDS] = { 0 }, hdrm[TOR_NLEDS] = { 0 };
+	(void)sweet_spmi_read(HAP_SID, TOR_STATUS1, &st1);
+	(void)sweet_spmi_read(HAP_SID, TOR_STATUS2, &st2);
+	(void)sweet_spmi_read(HAP_SID, TOR_MOD_CTRL, &mod);
+	(void)sweet_spmi_read(HAP_SID, TOR_EN_LED_CTRL, &en);
+	(void)sweet_spmi_read(HAP_SID, TOR_IRES, &ires);
+	for (unsigned n = 0; n < TOR_NLEDS; n++) {
+		(void)sweet_spmi_read(HAP_SID, TOR_TGR_CURRENT(n), &cur[n]);
+		(void)sweet_spmi_read(HAP_SID, TOR_HDRM_PRGM(n), &hdrm[n]);
+	}
+	snprintf(text, len, "%s %s, level %u of %u (%u.%u mA per LED, %u max), %u times on, %u SPMI errors; STATUS1 %#x "
+	    "STATUS2 %#x MOD %#x EN %#x IRES %#x TGR %#x %#x HDRM %#x %#x\n", what, tor.on ? "on" : "off", tor.level,
+	    TOR_LEVEL_MAX, tor.on ? ((cur[0] & 0x7fu) + 1u) * 125u / 10u : 0u, tor.on ? ((cur[0] & 0x7fu) + 1u) * 125u % 10u : 0u,
+	    TOR_MAX_MA, tor.ons, tor.errors, st1, st2, mod, en, ires, cur[0], cur[1], hdrm[0], hdrm[1]);
+}
+
+static int
+tor_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	if (!tor.live) {
+		return ENXIO;
+	}
+	int err = 0;
+	if (req->newptr != USER_ADDR_NULL) {
+		uint32_t level = 0;
+		if (req->newlen != sizeof(level)) {
+			return EINVAL;
+		}
+		if ((err = SYSCTL_IN(req, &level, sizeof(level)))) {
+			return err;
+		}
+		level = MIN(level, TOR_LEVEL_MAX);
+		lck_mtx_lock(&hap_mtx);
+		if (!level) {
+			if (tor.on) {
+				tor_off();
+			}
+		} else {
+			err = tor_set(level);
+		}
+		lck_mtx_unlock(&hap_mtx);
+		if (err) {
+			return err;
+		}
+	}
+	char text[256];
+	lck_mtx_lock(&hap_mtx);
+	tor_status(text, sizeof(text), "torch");
+	lck_mtx_unlock(&hap_mtx);
+	return SYSCTL_OUT(req, text, strlen(text) + 1);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_torch, CTLTYPE_OPAQUE | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED, 0, 0,
+    tor_sysctl, "S", "Mi 8 flashlight: u32 level 0..1000 in (0 off), the state out (bsd/dev/dipper_haptics.c)");
+
+static bool
+tor_config(void)
+{
+	if (sweet_spmi_prepare_write(HAP_SID, TOR_EN_LED_CTRL) != 0) {
+		return false;                                   /* not ours (EE ownership) or no APID: logged there */
+	}
+	tor_off();                                              /* a known state: nothing lit */
+	char text[256];
+	tor_status(text, sizeof(text), "SWEET HAPTICS: PMI8998 flash LED block, torch");
+	printf("%s", text);
+	return tor.errors == 0;
+}
