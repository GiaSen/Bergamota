+/*
+ * 3107: the panel asleep while the display is off. Stepped by the vsync timer through dsiTick, one command at a time,
+ * every SWEET_PANEL_TICK_US while a sequence runs:
+ *   0 awake -> (off and dark) the off sequence -> 1 -> done -> 2 asleep -> (on) the on sequence -> 3 -> done -> 0.
+ * The sequences are the panel's own, from the phone's device tree (dtb/dipper/live.dtb, the 1080x2248 EA8074's
+ * qcom,mdss-dsi-off-command and -on-command, both sent in low power mode): off = display off, sleep in, 120 ms;
+ * on = sleep out, 10 ms, the page address, the vendor's registers between its unlock and lock, tearing effect on,
+ * brightness 0, the brightness control, 110 ms, display on. Sleep out alone is not enough: without "tearing effect on"
+ * the panel gives no sync signal and the display engine showed 2 frames a second of the 58 rendered (2026-11-21).
+ * A frame goes to the panel only when it is fully awake (panelReady): sent earlier it waited for that sync signal and
+ * each tick sat half a second in the wait. No brightness goes out while the panel is not awake: iOS ramps it at every
+ * wake, one level a tick, and that ramp starved the wake's own commands in the first version; after "display on" the
+ * level iOS wants is sent again. An "on" during the off sequence waits for it to finish, an "off" during the on
+ * sequence lets it finish. A command that does not finish is sent again, three times at most.
+ */
+struct sweet_panel_cmd {
+	uint8_t n, wait;        /* bytes; fast ticks to wait after it */
+	uint8_t b[8];
+};
+static const struct sweet_panel_cmd kPanelOff[] = {
+	{ 1, 0, { 0x28 } }, { 1, 60, { 0x10 } },
+};
+static const struct sweet_panel_cmd kPanelOn[] = {
+	{ 1, 5, { 0x11 } },
+	{ 5, 0, { 0x2b, 0x00, 0x00, 0x08, 0xc7 } },
+	{ 3, 0, { 0xf0, 0x5a, 0x5a } },
+	{ 8, 0, { 0xef, 0xf0, 0x31, 0x00, 0x33, 0x31, 0x14, 0x35 } },
+	{ 2, 0, { 0xb0, 0x01 } }, { 2, 0, { 0xbb, 0x03 } }, { 2, 0, { 0xb0, 0x4f } }, { 2, 0, { 0xcb, 0x00 } },
+	{ 2, 0, { 0xb0, 0x6b } }, { 2, 0, { 0xcb, 0x00 } }, { 2, 0, { 0xf7, 0x03 } }, { 2, 0, { 0xb0, 0x05 } },
+	{ 2, 0, { 0xb1, 0x10 } }, { 2, 0, { 0xb0, 0x02 } },
+	{ 5, 0, { 0xd5, 0x02, 0x17, 0x54, 0x14 } },
+	{ 3, 0, { 0xf0, 0xa5, 0xa5 } },
+	{ 2, 0, { 0x35, 0x00 } },
+	{ 3, 0, { 0x51, 0x00, 0x00 } },
+	{ 2, 0, { 0x53, 0x20 } },
+	{ 2, 55, { 0x55, 0x00 } },
+	{ 1, 0, { 0x29 } },
+};
+#define SWEET_PANEL_SEQ(st, seq, count) \
+	const struct sweet_panel_cmd *seq = (st) == 1 ? kPanelOff : kPanelOn; \
+	unsigned count = (st) == 1 ? (unsigned)(sizeof(kPanelOff) / sizeof(kPanelOff[0])) : (unsigned)(sizeof(kPanelOn) / sizeof(kPanelOn[0]))
+
+/* One DCS long write of n bytes through the host's FIFO, in low power mode, as the brightness has always gone */
+void
+AppleCLCD::dsiSend(const uint8_t *b, unsigned n)
+{
+	uint32_t t = mdp_rd(fDsi, DSI_R_TRIG_CTRL);
+	if ((t & 7u) != DSI_TRIG_SW) {
+		mdp_wr(fDsi, DSI_R_TRIG_CTRL, (t & ~7u) | DSI_TRIG_SW);
+	}
+	mdp_wr(fDsi, DSI_R_TPG_CTRL, DSI_TPG_CUSTOM_FIFO);
+	mdp_wr(fDsi, DSI_R_TPG_DMA_INIT, 0xc0390000u | n);      /* { WC low, WC high, DI 0x39, last | long } */
+	for (unsigned i = 0; i < n; i += 4) {
+		uint32_t w = 0xffffffffu;
+		for (unsigned k = 0; k < 4 && i + k < n; k++) {
+			w = (w & ~(0xffu << (8 * k))) | ((uint32_t)b[i + k] << (8 * k));
+		}
+		mdp_wr(fDsi, DSI_R_TPG_DMA_INIT, w);
+	}
+	mdp_wr(fDsi, DSI_R_DMA_CTRL, (mdp_rd(fDsi, DSI_R_DMA_CTRL) & ~((1u << 31) | (1u << 30))) | DSI_DMA_LPM | DSI_DMA_EMBEDDED);
+	mdp_wr(fDsi, DSI_R_DMA_LENGTH, 4 + ((n + 3) & ~3u));
+	__asm__ volatile ("dsb osh" ::: "memory");
+	mdp_wr(fDsi, DSI_R_DMA_SW_TRIGGER, 1);
+	fDsiBusy = true;
+	fDsiWait = 0;
+}
+
+/* from dsiTick, with no command in flight */
+void
+AppleCLCD::panelTick(bool off, bool dark)
+{
+	if (fPanelState == 0 && off && dark && sweet_fb_panel_sleep && fHeight == 2248 &&
+	    __atomic_load_n(&sweet_fb_dcs, __ATOMIC_RELAXED) == 0) {
+		fPanelState = 1;
+		fPanelIdx = fPanelWait = 0;
+	} else if (fPanelState == 2 && !off) {
+		fPanelState = 3;
+		fPanelIdx = fPanelWait = 0;
+	}
+	if (fPanelState == 1 || fPanelState == 3) {
+		SWEET_PANEL_SEQ(fPanelState, seq, count);
+		if (fPanelWait != 0) {
+			fPanelWait--;
+		} else if (fPanelIdx < count) {
+			dsiSend(seq[fPanelIdx].b, seq[fPanelIdx].n);
+			fPanelFlight = true;
+		} else if (fPanelState == 1) {
+			fPanelState = 2;
+			if (sweet_fb_panel_sleeps++ < 4) {
+				IOLog("SWEET FB: panel asleep\n");
+			}
+		} else {
+			fPanelState = 0;
+			fDsiLevel = 0;          /* the brightness iOS wants is sent again */
+			if (sweet_fb_panel_wakes++ < 4) {
+				IOLog("SWEET FB: panel awake\n");
+			}
+		}
+	}
+	sweet_fb_panel_state = (int)fPanelState;
+}
