diff --git a/bsd/dev/dipper_sensors.c b/bsd/dev/dipper_sensors.c
index 2bd33ff..955586c 100644
--- a/bsd/dev/dipper_sensors.c
+++ b/bsd/dev/dipper_sensors.c
@@ -2903,6 +2903,16 @@ sc_step(void)
 			msg = 10;
 		} else if (sc_on_change[k]) {
 			msg = 514;
+		} else if (sc.have_us[k] != 0) {
+			/*
+			 * 3088: a new rate on a running stream: stop it first, the new rate goes out on the next round (one request per
+			 * stream, not a second 513 on top of the first). Observed (image 135): the SLPI then still sends ~50 samples a
+			 * second for a fresh 10 Hz request, so that is its floor for the accelerometer; SweetHIDSensor::sample is what
+			 * holds iOS to the interval it asked.
+			 */
+			msg = 10;
+			want = 0;
+			SG_LOG("sensors: %s stopped for its new rate\n", sc_type[k]);
 		} else {
 			uint32_t hz = MAX(1u, MIN(200u, 1000000u / MAX(want, 1u)));     /* integer Hz as an IEEE float */
 			uint32_t e = 127 + 31 - (uint32_t)__builtin_clz(hz), bits = (e << 23) | ((hz << (23 - (e - 127))) & 0x7fffff);
