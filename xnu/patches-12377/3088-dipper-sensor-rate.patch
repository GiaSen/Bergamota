@@ -774,6 +774,7 @@ private:
 	UInt32 fSeq;
 	unsigned fPropLogs, fSampleLogs;
 	UInt32 fInterval;               /* ReportInterval from a client, us; 0 = not asked */
+	uint64_t fLastTs;               /* 3088: the last streamed sample handed on (absolute time) */
