@@ -944,6 +945,18 @@ SweetHIDSensor::sample(uint64_t ts, const int32_t *v, int n)
 		IOLog("SWEET HID: %s sample %d %d %d (%d values, %u clients)\n", sweet_sensor_names[fKind], n > 0 ? v[0] : 0,
 		    n > 1 ? v[1] : 0, n > 2 ? v[2] : 0, n, _clients ? _clients->getCount() : 0);
 	}
+	/*
+	 * 3088: streamed kinds no faster than the interval iOS asked (3/4 of it, for jitter): the SLPI can deliver more
