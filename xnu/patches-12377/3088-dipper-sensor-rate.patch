+		if (fLastTs != 0 && ts > fLastTs && ts - fLastTs < gap) {
+			return;
+		}
+		fLastTs = ts;
+	}
 	switch (fKind) {
 	case kSweetSensorAccel:
 		e = n >= 3 ? IOHIDEvent::accelerometerEvent(ts, v[0], v[1], v[2], 0, 0, fSeq++) : NULL;
