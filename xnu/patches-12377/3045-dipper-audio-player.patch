+/*
+ * ---- the speaker player (test boots, sweetaudio>=3, 3045): PCM from a ring at the start of the PCM window through ASM
+ * session 1 (multi-channel PCM v2, 16-bit stereo 48 kHz, post-processing none) -> an ADM COPP (NULL_COPP_TOPOLOGY) on
+ * QUAT_MI2S_RX -> the TAS2557. The audio thread keeps PL_DEPTH writes of one 20 ms period each queued in the DSP and
+ * sends the next at each ASM_DATA_EVENT_WRITE_DONE_V2 (which comes once the DSP has played the buffer); with nothing in
+ * the ring it sends a period of zeros, so the stream never starves and its WRITE_DONEs keep time. The amp's on and off
+ * scripts come from user space (TI's firmware stays out of the kernel): on once the port's bit clock runs, off and
+ * reset before the port stops; while playing, the amp's fault flags are read every second and a critical one (TI's
+ * masks: FLAGS_1 & 0xfc over-current/clock/die temperature, FLAGS_2 & 0x0c brownout) stops everything.
+ *
+ *   kern.sweet_audio_amp   write u8 which (1 on, 0 off) + an I2C script; read: their sizes, as text
+ *   kern.sweet_audio_play  write u32 op [+ data], then read struct pl_status (both in one call or apart):
+ *                          1 start (returns once the stream runs; EIO if a step failed, all undone), 2 stop now,
+ *                          3 + PCM (whole frames, up to 64 KiB): appended to the ring, EAGAIN while it does not fit,
+ *                          4 drain: stop once everything appended has been played
+ */
+#define AU_SID                  0x1821u         /* apps_smmu stream of qcom,msm-audio-ion */
+#define PL_PERIOD               3840u           /* 20 ms of 16-bit stereo at 48 kHz */
+#define PL_RING                 (273u * PL_PERIOD)      /* 5.46 s at offset 0 of the window */
+#define PL_ZEROS                PL_RING         /* one period of zeros after it */
+#define PL_DEPTH                4u              /* writes queued in the DSP: 80 ms */
+#define PL_STALL_MS             1000u
+#define TAS_ADDR                0x4cu
+enum { PL_OFF, PL_PLAYING, PL_DRAINING };
+enum { PL_OP_START = 1, PL_OP_STOP = 2, PL_OP_DATA = 3, PL_OP_DRAIN = 4 };
+_Static_assert(PL_ZEROS + PL_PERIOD <= AU_POOL_SIZE, "the ring and its zeros fit the window");
+
+struct pl_status {
+	uint32_t state, result, ring, period;
+	uint64_t written, sent, played;         /* bytes appended, handed to the DSP, played */
+	uint32_t queued, zeros, gaps, writes;   /* zeros: periods of zeros sent; gaps: those after the first data */
+	uint32_t errors, handle, copp, amp_checks;
+	uint8_t flags1, flags2, amp, reserved;
+} __attribute__((packed));
+
+static struct {
+	uint32_t state, req, result;
+	uint32_t gen;                           /* bumped by the audio thread once it has taken a request */
+	uint32_t handle, copp;
+	uint64_t wpos, spos, dpos;              /* as written, sent, played above */
+	struct {
+		uint32_t len, token;
+		bool data;
+	} q[PL_DEPTH];                          /* the writes in the DSP, oldest at qhead */
+	uint32_t qhead, qn, seq;
+	uint64_t last_done, last_check;
+	uint32_t zeros, gaps, writes, errors, amp_checks;
+	uint8_t flags[2];
+	bool amp_used;
+	uint8_t *amp[2];                        /* [0] off, [1] on */
+	uint32_t amp_len[2];
+} pl;
+
+/* from gl_apr_rx: the oldest queued write is done */
+static void
+pl_write_done(uint32_t token, uint32_t status)
+{
+	if (!pl.qn) {
+		return;         /* after a stop: the DSP handing back what was queued */
+	}
+	unsigned i = pl.qhead;
+	pl.qhead = (pl.qhead + 1) % PL_DEPTH;
+	pl.qn--;
+	if (pl.q[i].data) {
+		pl.dpos += pl.q[i].len;
+	}
+	pl.writes++;
+	pl.last_done = mach_absolute_time();
+	if ((status || token != pl.q[i].token) && pl.errors++ < 8) {
+		printf("SWEET AUDIO: player: WRITE_DONE token %u (expected %u) status %#x\n", token, pl.q[i].token, status);
+	}
+}
+
+static bool
+pl_send(uint32_t off, uint32_t len, bool data)
+{
+	struct {
+		struct au_apr_hdr h;
+		uint32_t lsw, msw, handle, size, seq, ts_lsw, ts_msw, flags;
+	} __attribute__((packed)) w = {
+		{ APR_HDR_FIELD_SEQ_CMD, (uint16_t)sizeof(w), APR_SVC_ASM, APR_DOMAIN_APPS, ASM_PORT, APR_SVC_ASM, APR_DOMAIN_ADSP,
+		  ASM_PORT, pl.seq, ASM_DATA_CMD_WRITE_V2 },
+		(uint32_t)AU_POOL_PA + off, AU_POOL_MSW, pl.handle, len, pl.seq, 0, 0, 0
+	};
+	if (!gl_send(CH_APR, &w, (uint32_t)sizeof(w))) {
+		return false;   /* no free intent from the DSP: next round */
+	}
+	unsigned i = (pl.qhead + pl.qn) % PL_DEPTH;
+	pl.q[i].len = len;
+	pl.q[i].token = pl.seq++;
+	pl.q[i].data = data;
+	pl.qn++;
+	return true;
+}
+
+static void
+pl_submit(void)
+{
+	while (pl.qn < PL_DEPTH) {
+		uint64_t avail = pl.wpos - pl.spos;
+		if (avail >= PL_PERIOD || (avail && pl.state == PL_DRAINING)) {
+			uint32_t len = (uint32_t)MIN(avail, (uint64_t)PL_PERIOD);
+			if (!pl_send((uint32_t)(pl.spos % PL_RING), len, true)) {      /* spos stays period aligned until the last */
+				return;
+			}
+			pl.spos += len;
+		} else if (pl.state == PL_PLAYING) {
+			if (!pl_send(PL_ZEROS, PL_PERIOD, false)) {
+				return;
+			}
+			pl.zeros++;
+			pl.gaps += pl.spos != 0;
+		} else {
+			return;
+		}
+	}
+}
+
+/* the amp's script which (1 on, 0 off); off also holds the amp in reset afterwards */
+static bool
+pl_amp(unsigned which)
+{
+	if (!pl.amp[which] || !ai_setup()) {
+		return false;
+	}
+	uint8_t rd[64];
+	size_t o = 0;
+	uint32_t done = 0;
+	int32_t e = ai_run(pl.amp[which], pl.amp_len[which], rd, sizeof(rd), &o, &done);
+	if (!which) {
+		ai_reset_pin(false);
+	}
+	char hex[3 * 8 + 1] = "";
+	for (size_t i = o > 8 ? o - 8 : 0, h = 0; i < o; i++) {
+		h += (size_t)snprintf(hex + h, sizeof(hex) - h, " %02x", rd[i]);
+	}
+	printf("SWEET AUDIO: player: amp %s: %u ops, error %d, last bytes read%s\n", which ? "on" : "off", done, e, hex);
+	return e == 0;
+}
+
+/* FLAGS_1 (B0P0R104, cleared by the read) and FLAGS_2 (R108); false: unreadable or critical */
+static bool
+pl_amp_check(void)
+{
+	static const uint8_t page0[2] = { 0, 0 }, book0[2] = { 127, 0 };
+	int e = ai_write(TAS_ADDR, page0, 2);
+	e = e ? e : ai_write(TAS_ADDR, book0, 2);
+	e = e ? e : ai_write(TAS_ADDR, page0, 2);
+	e = e ? e : ai_read(TAS_ADDR, 104, &pl.flags[0], 1);
+	e = e ? e : ai_read(TAS_ADDR, 108, &pl.flags[1], 1);
+	pl.amp_checks++;
+	if (e || (pl.flags[0] & 0xfcu) || (pl.flags[1] & 0x0cu)) {
+		printf("SWEET AUDIO: player: amp flags %#x %#x (I2C error %d): stopping\n", pl.flags[0], pl.flags[1], e);
+		return false;
+	}
+	return true;
+}
