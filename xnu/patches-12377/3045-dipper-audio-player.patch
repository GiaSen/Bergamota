+	(void)ap_pins(false);
+	pl.qn = 0;
+	printf("SWEET AUDIO: player off (%s): amp off %s, pause %d, close %d, COPP close %d, unmap %d, port stop %d, clock off %d; "
+	    "%llu bytes played of %llu, %u writes, %u periods of zeros (%u after data), %u errors, %u amp checks\n", why,
+	    a ? "ok" : "FAILED", st[0], st[1], st[2], st[3], st[4], st[5], pl.dpos, pl.wpos, pl.writes, pl.zeros, pl.gaps,
+	    pl.errors, pl.amp_checks);
+	sweet_log_sync();
+}
+
+static int
+pl_start(void)
+{
+	if (!au_pool && !(au_pool = ml_io_map_unmappable((vm_offset_t)AU_POOL_PA, AU_POOL_SIZE, VM_WIMG_WCOMB))) {
+		return ENOMEM;
+	}
+	bzero((void *)(au_pool + PL_ZEROS), PL_PERIOD);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	pl.wpos = pl.spos = pl.dpos = 0;
+	pl.qhead = pl.qn = 0;
+	pl.zeros = pl.gaps = pl.writes = pl.errors = pl.amp_checks = 0;
+	pl.flags[0] = pl.flags[1] = 0;
+	pl.handle = pl.copp = 0;
+	pl.amp_used = false;
+	int st = sweet_smmu_map_sid(AU_SID);
+	if (st != 0) {
+		printf("SWEET AUDIO: player: apps_smmu sid %#x not mapped (%d)\n", AU_SID, st);
+		return EIO;
+	}
+	const char *step = "pins";
+	bool port = false, mapped = false, stream = false, copp = false;
+	uint32_t r[2];
+	if (!ap_pins(true)) {
+		goto fail;
+	}
+	step = "clock";
+	if (afe_mi2s_clock(AU_BCLK) != 0) {
+		goto fail;
+	}
+	step = "I2S config";
+	if (afe_quat_i2s_config() != 0) {
+		goto fail;
+	}
+	step = "port start";
+	if (afe_port_cmd(AFE_PORT_QUAT_MI2S_RX, AFE_PORT_CMD_DEVICE_START) != 0) {
+		goto fail;
+	}
+	port = true;
+	step = "amp on";
+	if (pl.amp[1]) {
+		pl.amp_used = true;
+		if (!pl_amp(1)) {
+			goto fail;
+		}
+	}
+	/* ASM_CMD_SHARED_MEM_MAP_REGIONS: pool 3 (SHMEM8_4K), one region (the window), flags 0 -> {mem map handle} */
+	struct {
+		uint16_t pool, regions;
+		uint32_t flags, lsw, msw, size;
+	} __attribute__((packed)) m = { 3, 1, 0, (uint32_t)AU_POOL_PA, AU_POOL_MSW, AU_POOL_SIZE };
+	step = "memory map";
+	if (apr_request_port(APR_SVC_ASM, 0, 0, ASM_SESSION << 8, ASM_CMD_SHARED_MEM_MAP_REGIONS, &m, sizeof(m),
+	    ASM_CMDRSP_SHARED_MEM_MAP_REGIONS, 2000) != 0 || gl.apr_opcode != ASM_CMDRSP_SHARED_MEM_MAP_REGIONS || gl.apr_pl_len < 4) {
+		goto fail;
+	}
+	memcpy(&pl.handle, gl.apr_pl, 4);
+	mapped = true;
+	/* ASM_STREAM_CMD_OPEN_WRITE_V3: mode 0, sink the device matrix, 16 bits, post-processing none, multi-channel PCM */
+	struct {
+		uint32_t mode;
+		uint16_t sink, bits;
+		uint32_t postproc, fmt;
+	} __attribute__((packed)) o = { 0, 0, 16, ASM_STREAM_POSTPROC_TOPO_ID_NONE, ASM_MEDIA_FMT_MULTI_CHANNEL_PCM_V2 };
+	step = "stream open";
+	if (apr_request_port(APR_SVC_ASM, ASM_PORT, ASM_PORT, ASM_PORT, ASM_STREAM_CMD_OPEN_WRITE_V3, &o, sizeof(o),
+	    APR_BASIC_RSP_RESULT, 2000) != 0) {
+		goto fail;
+	}
+	stream = true;
+	/* ADM_CMD_DEVICE_OPEN_V5: RX, endpoint the port, NULL_COPP_TOPOLOGY, 2 ch 16 bit 48 kHz FL FR -> {status, COPP} */
+	struct {
+		uint16_t flags, mode, ep1, ep2;
+		uint32_t topology;
+		uint16_t channels, bits;
+		uint32_t rate;
+		uint8_t map[8];
+	} __attribute__((packed)) a = { 0, 1, AFE_PORT_QUAT_MI2S_RX, 0xffff, ADM_NULL_COPP_TOPOLOGY, 2, 16, AU_RATE, { 1, 2 } };
+	step = "COPP open";
+	if (apr_request_port(APR_SVC_ADM, AFE_PORT_QUAT_MI2S_RX, AFE_PORT_QUAT_MI2S_RX, 0, ADM_CMD_DEVICE_OPEN_V5, &a, sizeof(a),
+	    ADM_CMDRSP_DEVICE_OPEN_V5, 2000) != 0 || gl.apr_opcode != ADM_CMDRSP_DEVICE_OPEN_V5 || gl.apr_pl_len < 8) {
+		goto fail;
+	}
+	memcpy(r, gl.apr_pl, 8);
+	if (r[0] != 0) {
+		goto fail;
+	}
+	pl.copp = r[1];
+	copp = true;
+	/* ADM_CMD_MATRIX_MAP_ROUTINGS_V5: the audio RX matrix, session 1 -> that COPP */
+	struct {
+		uint32_t matrix, sessions;
+		uint16_t session, copps, copp, reserved;
+	} __attribute__((packed)) rt = { 0, 1, ASM_SESSION, 1, (uint16_t)pl.copp, 0 };
+	step = "routing";
+	if (apr_request_port(APR_SVC_ADM, 0, 0, 0, ADM_CMD_MATRIX_MAP_ROUTINGS_V5, &rt, sizeof(rt), APR_BASIC_RSP_RESULT, 2000) != 0) {
+		goto fail;
+	}
+	/* ASM_DATA_CMD_MEDIA_FMT_UPDATE_V2: multi-channel PCM, 2 ch, 16 bit, 48 kHz, signed, FL FR */
+	struct {
+		uint32_t size;
+		uint16_t channels, bits;
+		uint32_t rate;
+		uint16_t is_signed, reserved;
+		uint8_t map[8];
+	} __attribute__((packed)) f = { 20, 2, 16, AU_RATE, 1, 0, { 1, 2 } };
+	step = "media format";
+	if (apr_request_port(APR_SVC_ASM, ASM_PORT, ASM_PORT, ASM_PORT, ASM_DATA_CMD_MEDIA_FMT_UPDATE_V2, &f, sizeof(f),
+	    APR_BASIC_RSP_RESULT, 2000) != 0) {
+		goto fail;
+	}
+	uint32_t run[3] = { 0, 0, 0 };          /* ASM_SESSION_CMD_RUN_V2: now */
+	step = "run";
+	if (apr_request_port(APR_SVC_ASM, ASM_PORT, ASM_PORT, ASM_PORT, ASM_SESSION_CMD_RUN_V2, run, sizeof(run),
+	    APR_BASIC_RSP_RESULT, 2000) != 0) {
+		goto fail;
+	}
+	pl.state = PL_PLAYING;
+	pl.last_done = pl.last_check = mach_absolute_time();
+	pl_submit();
+	printf("SWEET AUDIO: player on: mem map handle %#x, COPP %u, amp %s, %u writes of %u bytes queued, ring %u bytes\n",
+	    pl.handle, pl.copp, pl.amp_used ? "on" : "not scripted (silent)", pl.qn, PL_PERIOD, PL_RING);
+	return 0;
+fail:
+	printf("SWEET AUDIO: player: %s failed (last APR opcode %#x status %#x)\n", step, gl.apr_opcode, gl.apr_status);
+	pl_teardown("start failed", pl.amp_used, stream, copp, mapped, port);
+	return EIO;
+}
+
+/* the audio thread, au_mtx held: requests, refills, the stall/drain/amp checks */
+static void
+pl_step(void)
+{
+	static uint64_t one_s;
+	if (!one_s) {
+		nanoseconds_to_absolutetime(NSEC_PER_SEC, &one_s);
+	}
+	if (pl.req) {
+		uint32_t r = pl.req;
+		pl.req = 0;
+		if (r == PL_OP_START) {
+			pl.result = pl.state == PL_OFF ? (uint32_t)pl_start() : EBUSY;
+		} else if (pl.state != PL_OFF) {
+			pl_teardown("stop", pl.amp_used, true, true, true, true);
+		}
+		__atomic_add_fetch(&pl.gen, 1, __ATOMIC_RELEASE);
+	}
+	if (pl.state == PL_OFF) {
+		return;
+	}
+	pl_submit();
+	uint64_t now = mach_absolute_time();
+	if (pl.qn && now - pl.last_done > one_s * PL_STALL_MS / 1000u) {
+		printf("SWEET AUDIO: player: no WRITE_DONE for %u ms with %u writes queued\n", PL_STALL_MS, pl.qn);
+		pl_teardown("stalled", pl.amp_used, true, true, true, true);
+	} else if (pl.state == PL_DRAINING && !pl.qn && pl.spos == pl.wpos) {
+		pl_teardown("drained", pl.amp_used, true, true, true, true);
+	} else if (pl.amp_used && now - pl.last_check >= one_s) {
+		pl.last_check = now;
+		if (!pl_amp_check()) {
+			pl_teardown("amp fault", pl.amp_used, true, true, true, true);
+		}
+	}
+}
+
+static int
+au_play_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	if (!au_live) {
+		return ENXIO;
+	}
+	int err = 0;
+	if (req->newptr != USER_ADDR_NULL) {
+		size_t n = req->newlen;
+		uint32_t op = 0;
+		if (n < 4 || n > 4 + 65536) {
+			return EINVAL;
+		}
+		if ((err = SYSCTL_IN(req, &op, 4))) {
+			return err;
+		}
+		if (op == PL_OP_DATA) {
+			uint32_t len = (uint32_t)(n - 4);
+			uint8_t *tmp = len && !(len & 3u) ? kalloc_data(len, Z_WAITOK) : NULL;
+			if (!tmp) {
+				return len && !(len & 3u) ? ENOMEM : EINVAL;
+			}
+			err = SYSCTL_IN(req, tmp, len);
+			lck_mtx_lock(&au_mtx);
+			if (!err && pl.state != PL_PLAYING) {
+				err = EPIPE;
+			} else if (!err && pl.wpos + len - pl.dpos > PL_RING) {
+				err = EAGAIN;
+			} else if (!err) {
+				uint32_t off = (uint32_t)(pl.wpos % PL_RING), first = MIN(len, PL_RING - off);
+				memcpy((void *)(au_pool + off), tmp, first);
+				memcpy((void *)au_pool, tmp + first, len - first);
+				__asm__ volatile ("dsb sy" ::: "memory");
+				pl.wpos += len;
+			}
+			lck_mtx_unlock(&au_mtx);
+			kfree_data(tmp, len);
+		} else if (op == PL_OP_DRAIN) {
+			lck_mtx_lock(&au_mtx);
+			if (pl.state == PL_PLAYING) {
+				pl.state = PL_DRAINING;
+			}
+			lck_mtx_unlock(&au_mtx);
+		} else if (op == PL_OP_START || op == PL_OP_STOP) {
+			lck_mtx_lock(&au_mtx);
+			uint32_t g = pl.gen;
+			pl.req = op;
+			lck_mtx_unlock(&au_mtx);
+			unsigned w = 0;
+			for (; w < 10000 && __atomic_load_n(&pl.gen, __ATOMIC_ACQUIRE) == g; w += 5) {
+				au_sleep(5);
+			}
+			err = w >= 10000 ? ETIMEDOUT : op == PL_OP_START ? (int)pl.result : 0;
+		} else {
+			err = EINVAL;
+		}
+		if (err) {
+			return err;
+		}
+	}
+	lck_mtx_lock(&au_mtx);
+	struct pl_status s = { pl.state, pl.result, PL_RING, PL_PERIOD, pl.wpos, pl.spos, pl.dpos, pl.qn, pl.zeros, pl.gaps,
+		               pl.writes, pl.errors, pl.handle, pl.copp, pl.amp_checks, pl.flags[0], pl.flags[1], pl.amp_used, 0 };
+	lck_mtx_unlock(&au_mtx);
+	return SYSCTL_OUT(req, &s, sizeof(s));
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_audio_play, CTLTYPE_OPAQUE | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0, au_play_sysctl, "S",
+    "Mi 8 speaker player: u32 op (1 start, 2 stop, 3 + PCM, 4 drain) in, its state out (bsd/dev/dipper_audio.c)");
+
+static int
+au_amp_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	if (!au.stage) {
+		return ENXIO;
+	}
+	int err = 0;
+	if (req->newptr != USER_ADDR_NULL) {
+		size_t n = req->newlen;
+		uint8_t which = 0;
+		if (n < 2 || n > 1 + 65536) {
+			return EINVAL;
+		}
+		if ((err = SYSCTL_IN(req, &which, 1))) {
+			return err;
+		}
+		if (which > 1) {
+			return EINVAL;
+		}
+		uint32_t len = (uint32_t)(n - 1);
+		uint8_t *s = kalloc_data(len, Z_WAITOK);
+		if (!s) {
+			return ENOMEM;
+		}
+		if ((err = SYSCTL_IN(req, s, len))) {
+			kfree_data(s, len);
+			return err;
+		}
+		lck_mtx_lock(&au_mtx);
+		if (pl.state != PL_OFF) {
+			err = EBUSY;
+		} else {
+			uint8_t *old = pl.amp[which];
+			uint32_t old_len = pl.amp_len[which];
+			pl.amp[which] = s;
+			pl.amp_len[which] = len;
+			s = old;
+			len = old_len;
+		}
+		lck_mtx_unlock(&au_mtx);
+		if (s) {
+			kfree_data(s, len);
+		}
+		if (err) {
+			return err;
+		}
+	}
+	char text[64];
+	snprintf(text, sizeof(text), "amp scripts: on %u bytes, off %u bytes\n", pl.amp_len[1], pl.amp_len[0]);
+	return SYSCTL_OUT(req, text, strlen(text) + 1);
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_audio_amp, CTLTYPE_OPAQUE | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0, au_amp_sysctl, "S",
+    "Mi 8 speaker player: the amp's on (1) and off (0) I2C scripts, u8 which + script (bsd/dev/dipper_audio.c)");
