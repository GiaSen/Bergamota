diff --git a/bsd/dev/dipper_audio.c b/bsd/dev/dipper_audio.c
index 1313c71..711bb26 100644
--- a/bsd/dev/dipper_audio.c
+++ b/bsd/dev/dipper_audio.c
@@ -3508,8 +3508,12 @@ cx_cap_read(unsigned k, uint32_t seq)
 	if (!gl_send(CH_APR, pkt, APR_HDR_SIZE + sizeof(rd))) {
 		return 0;
 	}
+	/* au_mtx is released while waiting, so the audio thread keeps feeding the speaker (its gl_poll may take the
+	 * READ_DONE instead: cx_cap_done runs either way) */
 	for (unsigned w = 0; w < 500 && !cap.done && !gl.bad; w += 2) {
+		lck_mtx_unlock(&au_mtx);
 		au_sleep(2);
+		lck_mtx_lock(&au_mtx);
 		gl_poll();
 	}
 	if (!cap.done || cap.status != 0 || cap.size > CX_CAP_BUF) {
@@ -3530,7 +3534,8 @@ cx_stage_capture(unsigned seconds)
 	lck_mtx_lock(&au_mtx);
 	bool ok = cx_cap_open();
 	uint64_t sum2 = 0, n = 0;
-	int64_t sum = 0;
+	int64_t sum = 0, g1 = 0, g2 = 0;                /* Goertzel state at 1 kHz: coefficient 2cos(2pi/48) in Q14 */
+	const int64_t gk = 32487;
 	unsigned peak = 0, reads = 0, bytes = 0, zero_bufs = 0;
 	for (unsigned i = 0; ok && i < seconds * 25u; i++) {
 		unsigned k = i % CX_CAP_NBUF;
@@ -3551,6 +3556,9 @@ cx_stage_capture(unsigned seconds)
 			sum += v;
 			sum2 += (uint64_t)((int64_t)v * v);
 			n++;
+			int64_t g0 = v + ((gk * g1) >> 14) - g2;
+			g2 = g1;
+			g1 = g0;
 		}
 		zero_bufs += nz == 0;
 		if ((i % 5) == 4 && n) {            /* every 200 ms */
@@ -3562,8 +3570,20 @@ cx_stage_capture(unsigned seconds)
 				}
 			}
 			int rdb = cx_db10(rms), pdb = cx_db10(peak);
-			CX_LOG("  %4u ms: rms %d.%d dBFS (%llu), peak %d.%d dBFS (%u), mean %lld\n", (i + 1) * 40, rdb / 10,
-			    rdb < 0 ? -rdb % 10 : rdb % 10, rms, pdb / 10, pdb < 0 ? -pdb % 10 : pdb % 10, peak, sum / (int64_t)n);
+			/* tone amplitude ~ 2 * |X(1 kHz)| / N; |X|^2 = g1^2 + g2^2 - k*g1*g2 */
+			int64_t pw = g1 * g1 + g2 * g2 - ((gk * g1) >> 14) * g2;
+			uint64_t mag = 0, pu = pw > 0 ? (uint64_t)pw : 0;
+			for (uint64_t bit = 1ull << 31; bit; bit >>= 1) {     /* pu < 2^63: the root fits in 32 bits */
+				if ((mag + bit) * (mag + bit) <= pu) {
+					mag += bit;
+				}
+			}
+			uint64_t amp = n ? 2 * mag / n : 0;
+			int tdb = cx_db10(amp);
+			CX_LOG("  %4u ms: rms %d.%d dBFS (%llu), peak %d.%d dBFS (%u), 1 kHz %d.%d dBFS (%llu), mean %lld\n",
+			    (i + 1) * 40, rdb / 10, rdb < 0 ? -rdb % 10 : rdb % 10, rms, pdb / 10, pdb < 0 ? -pdb % 10 : pdb % 10,
+			    peak, tdb / 10, tdb < 0 ? -tdb % 10 : tdb % 10, amp, sum / (int64_t)n);
+			g1 = g2 = 0;
 			sum2 = 0;
 			sum = 0;
 			n = 0;
