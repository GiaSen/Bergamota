+
+/*
+ * 3069: from ready on, GLINK + QRTR on the dsps edge in the thread "sweet ssc"; this call waits SS_WATCH_MS (or the
+ * SLPI's fatal bit) and logs a summary; the thread goes on after it (its lines are on the console only).
+ */
+#define SS_WATCH_MS             60000u
+static bool
+ss_live(uint32_t bits)
+{
+	sg.bits = bits;
+	if (!sg_up()) {
+		return false;
+	}
+	thread_t th;
+	if (kernel_thread_start(ss_thread, NULL, &th) != KERN_SUCCESS) {
+		SS_LOG("kernel_thread_start failed\n");
+		return false;
+	}
+	thread_set_thread_name(th, "sweet ssc");
+	thread_deallocate(th);
+	unsigned t0 = sg_ms();
+	while (sg_ms() < t0 + SS_WATCH_MS && !sg.fatal) {
+		delay(100 * 1000);
+	}
+	char sum[512];
+	size_t o = (size_t)snprintf(sum, sizeof(sum), "%u channels:", sg.nch);
+	for (unsigned c = 0; c < sg.nch && o < sizeof(sum); c++) {
+		o += (size_t)snprintf(sum + o, sizeof(sum) - o, " %s (%s, %u packets)", sg.ch[c].name,
+		    sg.ch[c].open_acked ? "open" : "half open", sg.ch[c].pkts);
+	}
+	SS_LOG("+%u ms: %s (crash reason above when fatal); %s\n", sg_ms(), sg.fatal ? "SLPI FATAL" : "SLPI still up", sum);
+	SS_LOG("qrtr node %u: %u hellos, %u servers, %u lookups, %u locator requests, %u other data; SNS 400 %s; %s %s\n",
+	    sg.qnode, sg.hellos, sg.servers, sg.lookups, sg.pdm_reqs, sg.data_other, sg.sns_port ? "offered" : "not offered",
+	    sg_pd_path, sg.nf.answered || sg.nf.state ? nf_state_name(sg.nf.state) : "state unknown");
+	return !sg.fatal;
 }
 
