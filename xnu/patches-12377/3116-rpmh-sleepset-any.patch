  * active votes for that rail move it by themselves. Nothing happens until the cluster powers down in mode 3
  * (kern.sweet_cluster=3); whether the rail then really drops is the power controller's to decide, with every other
  * subsystem's vote: kern.sweet_sleep_stats counts it (cxsd). A probe: nothing sets this by itself.
+ * 3116: any resource of the command database, NAME=S:W or NAME+4=S:W (a regulator's or clock buffer's enable register),
+ * S and W the raw request values, decimal or 0x hex; up to 16 entries, all in one sleep and one wake slot. For a bus
+ * vote write the whole word: 0x40000000 (commit) for "nothing", 0x60000000 | y for a vote, as the active requests do.
+ * W is what kern.sweet_rpmh_read gives for the resource now (plus the commit bit for a bus vote). cx.lvl and mx.lvl
+ * keep their check (W 4-7, S <= W); nothing else is checked: a wrong S for the memory's rail or the crystal hangs the
+ * phone at the next cluster power-down.
  */
+static bool
+rh_number(const char *t, uint32_t *out)
+{
+	uint32_t v = 0, base = 10;
+	if (t[0] == '0' && (t[1] == 'x' || t[1] == 'X')) {
+		base = 16;
+		t += 2;
+	}
+	if (*t == 0) {
+		return false;
+	}
+	for (; *t; t++) {
+		uint32_t d = (*t >= '0' && *t <= '9') ? (uint32_t)(*t - '0') : (*t >= 'a' && *t <= 'f') ? (uint32_t)(*t - 'a' + 10) :
+		    (*t >= 'A' && *t <= 'F') ? (uint32_t)(*t - 'A' + 10) : 99u;
+		if (d >= base || v > (0xffffffffu - d) / base) {
+			return false;
+		}
+		v = v * base + d;
+	}
+	*out = v;
+	return true;
+}
