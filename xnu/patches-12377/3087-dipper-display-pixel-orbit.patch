+	}
+	fOrbitLast = now;
+	uint32_t side = 2 * fOrbitN + 1, cells = side * side;
+	fOrbitIdx = (fOrbitIdx + 1) % (2 * cells - 2);
+	uint32_t k = fOrbitIdx < cells ? fOrbitIdx : 2 * cells - 2 - fOrbitIdx;   /* there and back: no jump at the end */
