+/*
+ * 3087: the next orbit position, from the vsync timer while the display is on. The origin follows a serpentine over the
+ * (2N+1) x (2N+1) offsets (rows of x, alternating direction, then back up the same way: every move is one pixel).
+ */
+void
+AppleCLCD::orbitTick(uint64_t now)
+{
+	if (fOrbitN == 0 || !fHw || now - fOrbitLast < fOrbitPeriod) {
