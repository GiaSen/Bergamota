diff --git a/bsd/dev/sweet_charger.c b/bsd/dev/sweet_charger.c
index 0976d01..73bdf89 100644
--- a/bsd/dev/sweet_charger.c
+++ b/bsd/dev/sweet_charger.c
@@ -533,6 +533,53 @@ sc_battery_now_sysctl(__unused struct sysctl_oid *oidp, __unused void *arg1, __u
 	return sysctl_handle_string(oidp, buf, sizeof(buf), req);
 }
 
+/*
+ * 3026: sysctl kern.sweet_usbin_off=SECONDS (1..120): USBIN suspended for that long, then back, the call returns then. The phone runs from the
+ * battery with the cable still in, so kern.sweet_battery_now is the whole system's current, with no charger loss to guess.
+ */
+extern void IOSleep(unsigned int milliseconds);
+static int sc_usbin_off_busy;
+
+static int
+sc_usbin_off_sysctl(__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2, struct sysctl_req *req)
+{
+	int secs = 0, error = sysctl_handle_int(oidp, &secs, 0, req);
+	uint8_t was = 0, off;
+	if (error || !req->newptr) {
+		return error;
+	}
+	if (secs < 1 || secs > 120) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&sc_usbin_off_busy, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	if (sweet_spmi_read(SC_SID, R_CMD_IL, &was) != 0) {
+		__atomic_store_n(&sc_usbin_off_busy, 0, __ATOMIC_RELEASE);
+		return EIO;
+	}
+	off = was | 1u;
+	if (sweet_spmi_write(SC_SID, R_CMD_IL, &off, 1) != 0) {
+		__atomic_store_n(&sc_usbin_off_busy, 0, __ATOMIC_RELEASE);
+		return EPERM;
+	}
+	printf("SWEET CHARGER: USBIN suspended for %d s (test)\n", secs);
+	IOSleep((unsigned)secs * 1000u);
+	was &= ~1u;
+	for (unsigned attempt = 0; attempt < 5; attempt++) {
+		if (sweet_spmi_write(SC_SID, R_CMD_IL, &was, 1) == 0) {
+			printf("SWEET CHARGER: USBIN back\n");
+			break;
+		}
+		IOSleep(100);
+	}
+	__atomic_store_n(&sc_usbin_off_busy, 0, __ATOMIC_RELEASE);
+	return 0;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_usbin_off, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0, sc_usbin_off_sysctl, "I",
+    "Mi 8: run from the battery for this many seconds (test)");
+
 SYSCTL_PROC(_kern, OID_AUTO, sweet_battery_now,
     CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0, sc_battery_now_sysctl, "A",
     "Mi 8 fuel gauge now: millivolts, milliamps out of the battery");
@@ -626,6 +673,10 @@ sc_control(struct sc_snap *s)
