index af27cbe..a290c27 100644
--- a/bsd/dev/dipper_camera.c
+++ b/bsd/dev/dipper_camera.c
@@ -2292,12 +2292,318 @@ static unsigned cam_live_readers[C4_NBUF];
 static uint32_t cam_live_seq;
 static struct cam_live_hdr cam_live_meta[C4_NBUF];
 
+/*
+ * 3085: full-resolution stills. The stream stays in mode 2 (1920x1080, 2x2 binned); kern.sweet_cam_still=1 asks the stream
+ * thread for one frame in the sensor's mode 0 (4032x3024): at a frame boundary it stops the sensor, writes mode 0's sequence
+ * (kern.sweet_cam_seq0), the PHY's settle count for its rate and the write master's size and address, takes frames until
+ * the exposure (converted by the line times, then corrected by the first frame's meter: whether binning sums is not known)
+ * has settled, keeps the last, and goes back to mode 2. kern.sweet_cam_still then reads it: header + 4032x3024 MIPI RAW10.
+ * kern.sweet_cam_still_half (1 by default): mode 0 at half its MIPI rate (0.69 Gb/s a lane, line length doubled, 15 fps):
+ * the CSID runs at 384 MHz and mode 0's own output pixel clock is 552 MHz.
+ * The 15.2 MB frame lives in eight separate 2 MiB pieces mapped one after the other in the 32-bit window (one piece of
+ * 8.8 MB was already refused by kmem_alloc_contig): the write master sees one 16 MiB buffer, the frame then 1.5 MB of guard.
+ */
+#define ST_W            4032u
+#define ST_H            3024u
+#define ST_STRIDE       (ST_W * 10u / 8u)       /* 5040 bytes a line */
+#define ST_FRAME        (ST_STRIDE * ST_H)      /* 15240960 */
+#define ST_CHUNK        (2u << 20)
+#define ST_NCHUNK       8u                      /* 16 MiB */
+#define ST_GUARD_CHECK  0x40000u                /* bytes after the frame that must stay C3_FILL */
+#define ST_FLL          3140u                   /* mode 0's frame length */
+#define ST_LINE_NS_FULL 10615u                  /* 8832 / 832 Mpx/s */
+#define ST_LINE_NS_HALF 21231u                  /* the line length doubled */
+static vm_offset_t st_va[ST_NCHUNK];
+static uint64_t st_pa[ST_NCHUNK];
+static uint32_t st_iova;
+static struct cam_seq_rec *cam_seq0;
+static unsigned cam_seq0_n;
+static volatile bool cam_still_req, cam_still_busy;
+static volatile int cam_still_result;
+static uint32_t cam_still_seq;
+static struct cam_live_hdr cam_still_hdr;
+static unsigned cam_still_half = 1;
+static unsigned cam_still_frames = 4;          /* mode 0 frames taken a still (the last is kept) */
+SYSCTL_UINT(_kern, OID_AUTO, sweet_cam_still_half, CTLFLAG_RW | CTLFLAG_LOCKED, &cam_still_half, 0,
+    "3085: full-resolution stills at half mode 0's MIPI rate (1) or its own 1.38 Gb/s a lane (0)");
+SYSCTL_UINT(_kern, OID_AUTO, sweet_cam_still_frames, CTLFLAG_RW | CTLFLAG_LOCKED, &cam_still_frames, 0,
+    "3085: mode 0 frames a still (2-8, the last kept)");
+
+/* the still buffer: 8 pieces of 2 MiB, physically aligned to 2 MiB, mapped in order into the 32-bit window (once a boot) */
+static bool
+st_buffer(void)
+{
+	if (st_iova) {
+		return true;
+	}
+	for (unsigned k = 0; k < ST_NCHUNK; k++) {
+		if (st_va[k]) {
+			continue;
+		}
+		vm_offset_t v = 0;
+		if (kmem_alloc_contig(kernel_map, &v, ST_CHUNK, PAGE_MASK, 0, (ppnum_t)((ST_CHUNK >> PAGE_SHIFT) - 1),
+		    KMA_DATA | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			cam_say("still: no 2 MiB piece %u", k);
+			return false;
+		}
+		ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)v);
+		uint64_t pa = pn ? ptoa_64(pn) : 0;
+		if (!pa || (pa & (ST_CHUNK - 1)) || pa < 0x80000000ull || pa + ST_CHUNK > 0x280000000ull) {
+			cam_say("still: piece %u at %#llx: not 2 MiB aligned or outside the identity map", k, pa);
+			return false;
+		}
+		st_va[k] = v;
+		st_pa[k] = pa;
+	}
+	uint32_t base = 0;
+	for (unsigned k = 0; k < ST_NCHUNK; k++) {
+		uint32_t io = 0;
+		int e = sweet_smmu_map32(st_pa[k], ST_CHUNK, &io);
+		if (e != 0) {
+			cam_say("still: piece %u not mapped (%d)", k, e);
+			return false;
+		}
+		if (k == 0) {
+			base = io;
+		} else if (io != base + k * ST_CHUNK) {
+			cam_say("still: piece %u at IOVA %#x, not after the others (%#x): no still buffer", k, io, base + k * ST_CHUNK);
+			return false;
+		}
+	}
+	st_iova = base;
+	cam_say("still buffer: %u x 2 MiB at IOVA %#x (PA %#llx ... %#llx)", ST_NCHUNK, st_iova, st_pa[0], st_pa[ST_NCHUNK - 1]);
+	return true;
+}
+
+/* a byte of the still frame (it spans the pieces) */
+static inline const uint8_t *
+st_at(size_t off)
+{
+	return (const uint8_t *)st_va[off / ST_CHUNK] + off % ST_CHUNK;
+}
+
+/* the green mean (10-bit above black, as c4_meter) of the still frame: every 32nd line pair, every 8th 4-pixel group */
+static unsigned
+st_meter(void)
+{
+	uint64_t sum = 0;
+	unsigned n = 0;
+	for (unsigned y = 0; y + 1 < ST_H; y += 32) {
+		size_t o0 = (size_t)y * ST_STRIDE, o1 = o0 + ST_STRIDE;
+		sweet_dma_sync_va(st_at(o0), 1);
+		for (unsigned g = 0; g < ST_W / 4; g += 8) {
+			const uint8_t *r0 = st_at(o0 + 5 * g), *r1 = st_at(o1 + 5 * g);
+			sweet_dma_sync_va(r0, 5);
+			sweet_dma_sync_va(r1, 5);
+			const unsigned v[4] = { r0[1], r0[3], r1[0], r1[2] };
+			for (unsigned k = 0; k < 4; k++) {
+				unsigned p = v[k] * 4u;
+				sum += p > 64u ? p - 64u : 0u;
+				n++;
+			}
+		}
+	}
+	return n ? (unsigned)(sum / n) : 0;
+}
+
+/* a sensor sequence; for mode 0 at half rate the output system clock divider (0x030b) 2 and the line length (0x0342) doubled */
+static unsigned
+s0_write_seq(const struct cam_seq_rec *seq, unsigned n, bool half)
+{
+	unsigned bad = 0;
+	for (unsigned i = 0; i < n; i++) {
+		const struct cam_seq_rec *q = &seq[i];
+		if (q->op == 2) {
+			delay((int)(q->val > 100000 ? 100000 : q->val));
+			continue;
+		}
+		uint32_t val = q->val;
+		if (half && q->op == 0 && q->reg == 0x030b) {
+			val = 2;
+		} else if (half && q->op == 0 && q->reg == 0x0342) {
+			val = (17664u >> 8) & 0xff;
+		} else if (half && q->op == 0 && q->reg == 0x0343) {
+			val = 17664u & 0xff;
+		} else if (half && q->op == 1 && q->reg == 0x0342) {
+			val = 17664u;
+		}
+		uint8_t b[2] = { (uint8_t)(q->op == 1 ? val >> 8 : val), (uint8_t)val };
+		if (!i2c_write(0x34, q->reg, q->op == 1 ? b : &b[1], q->op == 1 ? 2 : 1)) {
+			bad++;
+		}
+	}
+	return bad;
+}
+
+static void
+st_settle(unsigned settle)
+{
+	for (unsigned i = 0; i < sizeof(csiphy_lane_regs) / sizeof(csiphy_lane_regs[0]); i++) {
+		if (csiphy_lane_regs[i].s) {
+			cam_wr(csiphy0, csiphy_lane_regs[i].off, settle);
+		}
+	}
+}
+
+/* the write master's frame done within ms (cleared); false on a timeout */
+static bool
+st_wait_done(unsigned ms)
+{
+	for (unsigned t = 0; t < ms; t++) {
+		if (cam_rd(vfe0, VFE_BUS_STATUS(1)) & 1u) {
+			cam_wr(vfe0, VFE_BUS_CLEAR(1), 1u);
+			cam_wr(vfe0, VFE_BUS_CLEAR_GLOBAL, 1);
+			return true;
+		}
+		delay(1000);
+	}
+	return false;
+}
+
+static bool
+s0_stream(bool on)
+{
+	uint8_t v = on ? 1 : 0;
+	return i2c_write(0x34, 0x0100, &v, 1);
+}
+
+/*
+ * The still, from the stream thread right after a frame done (the write master armed with c4_iova[target] for the frame now
+ * coming): that frame finishes in mode 2, then mode 0's frames go to the still buffer, then mode 2 again. 0 or an errno.
+ */
+static int
+c4_still(struct c4_run *r, unsigned target, unsigned preview_mean)
+{
+	const bool half = cam_still_half != 0;
+	const unsigned line_ns = half ? ST_LINE_NS_HALF : ST_LINE_NS_FULL, settle = half ? 16u : 15u;
+	const unsigned frame_ms = (unsigned)((uint64_t)ST_FLL * line_ns / 1000000u) + 1;
+	unsigned nframes = cam_still_frames < 2 ? 2 : cam_still_frames > 8 ? 8 : cam_still_frames, got = 0, csid = 0;
+	int err = 0;
+	uint64_t t0 = mach_absolute_time();
+	struct cam_exp e;
+
+	if (!cam_seq0 || cam_seq0_n == 0) {
+		cam_say("still: no mode 0 sequence (kern.sweet_cam_seq0)");
+		return ENOENT;
+	}
+	if (!st_buffer()) {
+		return ENOMEM;
+	}
+	for (unsigned k = 0; k < ST_NCHUNK; k++) {
+		memset((void *)st_va[k], C3_FILL, ST_CHUNK);
+		sweet_dma_sync_va((const void *)st_va[k], ST_CHUNK);
+	}
+	/* mode 2's frame in flight lands where it was going; then the sensor is quiet */
+	(void)s0_stream(false);
+	(void)st_wait_done(80);
+	delay(2000);
+	cam_wr(csid0, CSID_RDI0_CLEAR, cam_rd(csid0, CSID_RDI0_STATUS));
+	cam_wr(csid0, CSID_IRQ_CMD, 1);
+
+	/* mode 0 */
+	cam_wr(vfe0, VFE_WM(0, 0x58), ST_FRAME);
+	cam_wr(vfe0, VFE_WM(0, 0x14), st_iova);
+	cam_wr(vfe0, VFE_REG_UPDATE, 1u << 1);
+	st_settle(settle);
+	unsigned bad = s0_write_seq(cam_seq0, cam_seq0_n, half);
+	/* the same exposure time and gain: integration lines by the line times */
+	e = r->exp;
+	e.lines = (unsigned)((uint64_t)r->exp.lines * C4_LINE_NS / line_ns);
+	if (e.lines < 4) {
+		e.lines = 4;
+	}
+	e.fll = e.lines + C4_MARGIN > ST_FLL ? e.lines + C4_MARGIN : ST_FLL;
+	bool eok = s0_set_exposure(&e);
+	bool on = s0_stream(true);
+	cam_say("still: mode 0 %s rate, sequence %u records (%u NAK), settle %u, exposure %u lines (fll %u) again %u dgain %#x%s, stream %s",
+	    half ? "half" : "full", cam_seq0_n, bad, settle, e.lines, e.fll, e.acode, e.dgain, eok ? "" : " (NAK)", on ? "on" : "NAK");
+	if (bad || !on) {
+		err = EIO;
+	}
+	for (unsigned f = 0; !err && f < nframes; f++) {
+		if (!st_wait_done(f == 0 ? 400u : 2u * frame_ms + 50u)) {
+			cam_say("still: no frame done %u (%u ms); CSID RDI0 status %#x", f, f == 0 ? 400u : 2u * frame_ms + 50u,
+			    cam_rd(csid0, CSID_RDI0_STATUS));
+			err = got ? 0 : ETIMEDOUT;
+			break;
+		}
+		got++;
+		cam_wr(vfe0, VFE_WM(0, 0x14), st_iova);
+		if (f == 0) {
+			/* the first frame's brightness against the preview's: the exposure of the next ones scaled to match */
+			unsigned m = st_meter();
+			if (m > 4 && preview_mean > 4) {
+				uint64_t l = (uint64_t)e.lines * preview_mean / m;
+				unsigned lmax = 2u * ST_FLL - C4_MARGIN;
+				l = l < 4 ? 4 : l > lmax ? lmax : l;
+				cam_say("still: first frame mean %u against the preview's %u: %u -> %llu lines", m, preview_mean, e.lines, l);
+				e.lines = (unsigned)l;
+				e.fll = e.lines + C4_MARGIN > ST_FLL ? e.lines + C4_MARGIN : ST_FLL;
+				(void)s0_set_exposure(&e);
+			}
+		}
+		if (f + 1 == nframes) {
+			(void)s0_stream(false);
+			if (st_wait_done(2u * frame_ms + 50u)) {        /* the frame already under way when the stream was stopped */
+				got++;
+			}
+		}
+	}
+	csid = cam_rd(csid0, CSID_RDI0_STATUS);
+	(void)s0_stream(false);
+	(void)st_wait_done(2u * frame_ms + 50u);
+	unsigned mean = got ? st_meter() : 0, guard = 0;
+	for (size_t o = ST_FRAME; o < ST_FRAME + ST_GUARD_CHECK; o += 4096) {
+		sweet_dma_sync_va(st_at(o), 1);
+		guard += *st_at(o) != C3_FILL;
+	}
+	cam_say("still: %u frames in %llu ms, kept mean %u, guard %s, CSID RDI0 status %#x", got,
+	    c4_ns(mach_absolute_time() - t0) / 1000000u, mean, guard ? "WRITTEN" : "untouched", csid);
+	if (got) {
+		struct cam_live_hdr *h = &cam_still_hdr;
+		bzero(h, sizeof(*h));
+		h->magic = CAM_LIVE_MAGIC;
+		h->version = 1;
+		h->hdr_size = sizeof(*h);
+		h->seq = ++cam_still_seq;
+		h->width = ST_W;
+		h->height = ST_H;
+		h->stride = ST_STRIDE;
+		h->format = 1;
+		h->black = 64;
+		h->white = 1023;
+		h->exposure_lines = e.lines;
+		h->line_ns = line_ns;
+		h->again_x256 = (unsigned)(512u * 256u / (512u - e.acode));
+		h->dgain_x256 = e.dgain;
+		h->lens = af_pos;
+		h->timestamp_ns = c4_ns(mach_absolute_time());
+	}
+
+	/* mode 2 again */
+	cam_wr(vfe0, VFE_WM(0, 0x58), C4_FRAME);
+	cam_wr(vfe0, VFE_WM(0, 0x14), c4_iova[target]);
+	cam_wr(vfe0, VFE_REG_UPDATE, 1u << 1);
+	cam_wr(csid0, CSID_RDI0_CLEAR, cam_rd(csid0, CSID_RDI0_STATUS));
+	cam_wr(csid0, CSID_IRQ_CMD, 1);
+	st_settle(C4_SETTLE);
+	bad = s0_write_seq(cam_seq, cam_seq_n, false);
+	eok = s0_set_exposure(&r->exp);
+	on = s0_stream(true);
+	cam_say("still: back to mode 2 (%u NAK, exposure %s, stream %s)", bad, eok ? "set" : "NAK", on ? "on" : "NAK");
+	if (bad || !on) {
+		return EIO;
+	}
+	return got && !guard ? 0 : (err ? err : EIO);
+}
+
 static void
 cam_stream_thread(void *arg __unused, wait_result_t wr __unused)
 {
 	struct c4_run *r = &c4r;
 	struct c4_af af;
 	unsigned target = 0, since = 0, frames = 0, af_state = 0;     /* af_state: 0 not yet, 1 sweeping, 2 done */
+	unsigned last_mean = 0;
 	bool ae_on = false;
 	uint64_t t_prev = 0;
 
@@ -2367,6 +2673,16 @@ cam_stream_thread(void *arg __unused, wait_result_t wr __unused)
 		t_prev = now;
 		frames++;
 		since++;
+		if (cam_still_req) {
+			cam_still_busy = true;
+			cam_still_result = c4_still(r, target, last_mean);
+			cam_still_busy = false;
+			cam_still_req = false;
+			thread_wakeup((event_t)&cam_still_seq);
+			since = 0;
+			t_prev = 0;
+			continue;
+		}
 		if (since < 3) {
 			continue;
 		}
@@ -2383,6 +2699,7 @@ cam_stream_thread(void *arg __unused, wait_result_t wr __unused)
 		if (cam_ae) {
 			unsigned mean, sat;
 			c4_meter(fb, &mean, &sat);
+			last_mean = mean;
 			bool on = c4_ae_step(r, mean, sat, C4_FLL_MAX);
 			if (on && !ae_on) {
 				cam_say("stream: exposure on target at frame %u: %u lines, analog code %u, digital %#x", frames,
@@ -2566,6 +2883,115 @@ cam_live_sysctl SYSCTL_HANDLER_ARGS
 SYSCTL_PROC(_kern, OID_AUTO, sweet_cam_live, CTLTYPE_OPAQUE | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED, 0, 0,
     cam_live_sysctl, "S", "3080: the newest streamed frame (header + 1920x1080 MIPI RAW10); write the last seq seen to wait for a newer one");
 
+/* 3085: kern.sweet_cam_still: write 1 = take a full-resolution still (waits, up to 4 s); read = header + 4032x3024 MIPI RAW10 */
+static int
+cam_still_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int error = 0;
+
+	if (!cam_caller_ok()) {
+		return EPERM;
+	}
+	if (req->newptr) {
+		int v = 0;
+		error = SYSCTL_IN(req, &v, sizeof(v));
+		if (error) {
+			return error;
+		}
+		if (v != 1) {
+			return EINVAL;
+		}
+		if (cam_stream_state != 2) {
+			return ENXIO;
+		}
+		if (cam_still_req || cam_still_busy) {
+			return EBUSY;
+		}
+		uint32_t was = cam_still_seq;
+		cam_still_result = EIO;
+		cam_still_req = true;
+		for (int i = 0; i < 400 && cam_still_req && cam_stream_state == 2; i++) {
+			assert_wait_timeout((event_t)&cam_still_seq, THREAD_INTERRUPTIBLE, 10, NSEC_PER_MSEC);
+			(void)thread_block(THREAD_CONTINUE_NULL);
+		}
+		if (cam_still_req) {
+			cam_still_req = false;
+			return ETIMEDOUT;
+		}
+		return cam_still_result ? cam_still_result : (cam_still_seq != was ? 0 : EIO);
+	}
+	if (!req->oldptr) {
+		return SYSCTL_OUT(req, NULL, sizeof(struct cam_live_hdr) + ST_FRAME);
+	}
+	if (cam_still_seq == 0 || !st_iova) {
+		return ENOENT;
+	}
+	if (cam_still_req || cam_still_busy) {
+		return EBUSY;
+	}
+	struct cam_live_hdr h = cam_still_hdr;
+	error = SYSCTL_OUT(req, &h, sizeof(h));
+	for (size_t o = 0; !error && o < ST_FRAME; o += ST_CHUNK) {
+		size_t n = ST_FRAME - o < ST_CHUNK ? ST_FRAME - o : ST_CHUNK;
+		sweet_dma_sync_va(st_at(o), n);
+		error = SYSCTL_OUT(req, st_at(o), n);
+	}
+	return error;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_cam_still, CTLTYPE_OPAQUE | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED, 0, 0,
+    cam_still_sysctl, "S", "3085: write 1 = a full-resolution still while streaming; read = header + 4032x3024 MIPI RAW10");
+
+/* 3085: mode 0's sequence (as kern.sweet_cam_seq; may be loaded while streaming, not during a still) */
+static int
+cam_seq0_sysctl SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	int error = 0;
+
+	if (!cam_caller_ok()) {
+		return EPERM;
+	}
+	if (cam_still_req || cam_still_busy) {
+		return EBUSY;
+	}
+	if (req->oldptr) {
+		return cam_seq0 ? SYSCTL_OUT(req, cam_seq0, cam_seq0_n * sizeof(cam_seq0[0])) : SYSCTL_OUT(req, "", 0);
+	}
+	if (!req->newptr) {
+		return SYSCTL_OUT(req, NULL, cam_seq0_n * sizeof(cam_seq0[0]));
+	}
+	size_t len = req->newlen;
+	if (len == 0 || len % sizeof(struct cam_seq_rec) || len > C4_SEQ_MAX * sizeof(struct cam_seq_rec)) {
+		return EINVAL;
+	}
+	struct cam_seq_rec *buf = kalloc_data(C4_SEQ_MAX * sizeof(struct cam_seq_rec), Z_WAITOK | Z_ZERO);
+	if (!buf) {
+		return ENOMEM;
+	}
+	error = SYSCTL_IN(req, buf, len);
+	unsigned n = (unsigned)(len / sizeof(struct cam_seq_rec));
+	for (unsigned i = 0; !error && i < n; i++) {
+		if (buf[i].op > 2 || (buf[i].op != 2 && buf[i].reg == 0x0100)) {
+			error = EINVAL;
+		}
+	}
+	if (error) {
+		kfree_data(buf, C4_SEQ_MAX * sizeof(struct cam_seq_rec));
+		return error;
+	}
+	struct cam_seq_rec *old = cam_seq0;
+	cam_seq0_n = 0;
+	cam_seq0 = buf;
+	cam_seq0_n = n;
+	if (old) {
+		kfree_data(old, C4_SEQ_MAX * sizeof(struct cam_seq_rec));
+	}
+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, sweet_cam_seq0, CTLTYPE_OPAQUE | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED, 0, 0, cam_seq0_sysctl, "S",
+    "3085: the rear main sensor's mode 0 (4032x3024) sequence for kern.sweet_cam_still (camx_v1.py --seq 0); root and cameracaptured");
+
 /* 3077: the sensor's register sequence (8-byte records: u16 register, u8 op 0 write8 / 1 write16 / 2 wait us, u8 0, u32 value) */
 static int
 cam_seq_sysctl SYSCTL_HANDLER_ARGS
