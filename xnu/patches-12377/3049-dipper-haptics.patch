diff --git a/iokit/Kernel/arm/SweetHaptics.cpp b/iokit/Kernel/arm/SweetHaptics.cpp
new file mode 100644
index 0000000..0ff90e8
--- /dev/null
+++ b/iokit/Kernel/arm/SweetHaptics.cpp
@@ -0,0 +1,46 @@
+/*
+ * The Mi 8's stand-in for what Apple's haptics driver (AppleHapticsSupport) tells user space, patch 3049.
+ *
+ * audiomxd's haptic server (AudioToolbox, AVHapticServer: com.apple.audio.hapticd, what CoreHaptics, UIKit's
+ * feedbacks and the system sounds' vibrations talk to) initialises only after an IOKit matching notification for an
+ * AHSFirmwareReadyNotifier service ("Failed to add matching notification for AHSFirmwareReadyNotifier"): on an iPhone
+ * the haptics driver publishes it once the Taptic Engine's firmware is up. Here bsd/dev/dipper_haptics.c publishes this
+ * empty one once the PMI8998 motor is configured (sweethap=1); the waveforms themselves reach the motor through the
+ * audio HAL's "Actuator" device (SweetSpeaker.driver) and kern.sweet_haptic.
+ */
+#include <IOKit/IOService.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOLib.h>
+
+extern "C" int sweet_haptics_publish_ready(void);
+
+class AHSFirmwareReadyNotifier : public IOService
+{
+	OSDeclareDefaultStructors(AHSFirmwareReadyNotifier);
+};
+
+OSDefineMetaClassAndStructors(AHSFirmwareReadyNotifier, IOService);
+
+extern "C" int
+sweet_haptics_publish_ready(void)
+{
+	static bool published;
+	if (published) {
+		return 0;
+	}
+	IOService *platform = IOService::getPlatform();
+	AHSFirmwareReadyNotifier *n = OSTypeAlloc(AHSFirmwareReadyNotifier);
+	if (platform == NULL || n == NULL || !n->init()) {
+		OSSafeReleaseNULL(n);
+		return -1;
+	}
+	if (!n->attach(platform)) {
+		n->release();
+		return -1;
+	}
+	n->registerService();
+	n->release();
+	published = true;
+	IOLog("SWEET HAPTICS: AHSFirmwareReadyNotifier published\n");
+	return 0;
+}
