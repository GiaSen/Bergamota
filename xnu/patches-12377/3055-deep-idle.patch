+/*
+ * 3055: per-core power-down in idle (osfmk/arm64/cpu.c, sweet_deep_idle_*). Live switches; the stats count
+ * CPU_SUSPEND calls, real power-downs (res), early returns, CPU 0's wake-up IPIs (kick) and the sleepers' timer
+ * IPIs to CPU 0, the time spent powered down and the worst wake after a core's own timer.
+ */
+extern uint32_t sweet_deep_idle, sweet_deep_idle_mask, sweet_deep_idle_screen;
+extern uint32_t sweet_deep_idle_min_us, sweet_deep_idle_lead_us;
+extern int sweet_deep_idle_configure(uint32_t mode);
+extern int sweet_deep_idle_stats(char *buf, size_t len);
+
+static int
+sysctl_sweet_deep_idle SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2)
+	int v = (int)sweet_deep_idle, error = sysctl_handle_int(oidp, &v, 0, req);
+	if (error || !req->newptr) {
+		return error;
+	}
+	if (v < 0 || v > 2 || sweet_deep_idle_configure((uint32_t)v) != 0) {
+		return EINVAL;
+	}
+	printf("SWEET CPU: deep idle %s\n", v == 0 ? "off" : (v == 1 ? "rail-pc" : "pc"));
+	return 0;
+}
+
+static int
+sysctl_sweet_deep_idle_us SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg2)
+	uint32_t *p = (uint32_t *)arg1, old = *p;
+	int v = (int)old, error = sysctl_handle_int(oidp, &v, 0, req);
+	if (error || !req->newptr) {
+		return error;
+	}
+	if (v < 100 || v > 100000) {
+		return EINVAL;
+	}
+	*p = (uint32_t)v;
+	if (sweet_deep_idle_configure(sweet_deep_idle) != 0) {
+		*p = old;
+		return EINVAL;
+	}
+	return 0;
+}
+
+static int
+sysctl_sweet_deep_idle_stats SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2)
+	char buf[1024];
+	sweet_deep_idle_stats(buf, sizeof(buf));
+	return sysctl_handle_string(oidp, buf, sizeof(buf), req);
+}
+
+static int
+sysctl_sweet_deep_idle_mask SYSCTL_HANDLER_ARGS
+{
+#pragma unused(arg1, arg2)
+	int v = (int)sweet_deep_idle_mask, error = sysctl_handle_int(oidp, &v, 0, req);
+	if (error || !req->newptr) {
+		return error;
+	}
+	sweet_deep_idle_mask = (uint32_t)v & 0xFEu;    /* never CPU 0: it is the sleepers' timer */
+	return 0;
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, sweet_deep_idle, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0,
+    sysctl_sweet_deep_idle, "I", "power idle cores down: 0 off, 1 rail-pc, 2 pc (3055)");
+SYSCTL_PROC(_kern, OID_AUTO, sweet_deep_idle_min_us, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    &sweet_deep_idle_min_us, 0, sysctl_sweet_deep_idle_us, "I", "power down only if the next timer is this far (us)");
+SYSCTL_PROC(_kern, OID_AUTO, sweet_deep_idle_lead_us, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    &sweet_deep_idle_lead_us, 0, sysctl_sweet_deep_idle_us, "I", "CPU 0 wakes a core this long before its timer (us)");
+SYSCTL_PROC(_kern, OID_AUTO, sweet_deep_idle_mask, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED, 0, 0,
+    sysctl_sweet_deep_idle_mask, "I", "CPUs that may power down (bit 0 ignored)");
+SYSCTL_UINT(_kern, OID_AUTO, sweet_deep_idle_screen, CTLFLAG_RW | CTLFLAG_LOCKED, &sweet_deep_idle_screen, 0,
+    "1: power cores down only while the display is off");
+SYSCTL_PROC(_kern, OID_AUTO, sweet_deep_idle_stats, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0,
+    sysctl_sweet_deep_idle_stats, "A", "per-CPU deep idle counters (3055)");
 #endif /* ARM64_BOARD_CONFIG_SWEET */
