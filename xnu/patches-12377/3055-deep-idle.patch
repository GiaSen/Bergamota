+#if defined(SWEET)
+static bool sweet_deep_idle_enter(cpu_data_t *cdp);
+#endif
+
 /*
  *	Routine:	cpu_idle
  *	Function:
@@ -611,6 +615,10 @@ cpu_idle(void)
 #if HAS_RETENTION_STATE
 		arm64_retention_wfi();
 #else
