+{
+#pragma unused(arg1, arg2)
+	static const char *const kinds[3] = { "arc", "vrm", "bcm" };
+	char buf[400];
+	/* rh_poisoned is also set while a request is being written: read it between requests (stopped=-1: none found in 20 ms) */
+	int stopped = -1;
+	for (unsigned tries = 0; tries < 200 && stopped < 0; tries++) {
+		if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE) == 0) {
+			stopped = rh_poisoned;
+			__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+		} else {
