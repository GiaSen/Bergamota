+	    stopped, rh_n_reclaimed, rh_n_refused, rh_n_nofree, rh_n_conflict, rh_n_busfail);
+	for (unsigned k = 0; k < 3 && n > 0 && (size_t)n < sizeof(buf); k++) {
+		n += snprintf(buf + n, sizeof(buf) - (size_t)n, "%s sent=%u early=%u stale=%u resent=%u timeouts=%u\n", kinds[k], rh_st[k].sent,
