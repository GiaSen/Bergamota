 static uint32_t vc_color_fore = 0;
 static uint32_t vc_color_back = 0;
+
+/*
+ * Bergamota: the verbose console draws over a dimmed Bergamota logo. While the
+ * background is the default black (32 bpp only), background pixels come from
+ * the logo centred on the screen instead of vc_color_back; since the console
+ * repaints from its character buffer when it scrolls, the logo stays put.
+ * Decoded once (palette indices, static: clear_screen can run before the VM).
+ */
+#include "console_logo.h"
+static uint8_t vc_logo_idx[CONSOLE_LOGO_W * CONSOLE_LOGO_H];
+static boolean_t vc_logo_ready;
+
+static void
+vc_logo_decode(void)
+{
+	const unsigned char *p = console_logo_rle, *end = p + sizeof(console_logo_rle);
+	uint8_t *o = vc_logo_idx, *oend = o + sizeof(vc_logo_idx);
+
+	while (p < end && o < oend) {
+		unsigned int c = *p++, n = (c & 0x7f) + 1;
+		if (n > (unsigned int)(oend - o)) {
+			return;
+		}
+		if (c & 0x80) {
+			if (n > (unsigned int)(end - p)) {
+				return;
+			}
+			memcpy(o, p, n);
+			p += n;
+		} else {
+			if (p >= end) {
+				return;
+			}
+			memset(o, *p++, n);
+		}
+		o += n;
+	}
+	vc_logo_ready = (o == oend);
+}
+
+/* the logo's top-left corner on screen, or FALSE if the logo is not used now */
+static boolean_t
+vc_logo_origin(int *x0, int *y0)
+{
+	if (!vc_logo_ready || vinfo.v_depth != 32 || vc_color_back != 0) {
+		return FALSE;
+	}
+	*x0 = ((int)vinfo.v_width - CONSOLE_LOGO_W) / 2;
+	*y0 = ((int)vinfo.v_height - CONSOLE_LOGO_H) / 2;
+	return TRUE;
+}
 
+static inline uint32_t
+vc_logo_back(int x0, int y0, unsigned int px, unsigned int py)
+{
+	unsigned int lx = (unsigned int)((int)px - x0), ly = (unsigned int)((int)py - y0);
+
+	if (lx < CONSOLE_LOGO_W && ly < CONSOLE_LOGO_H) {
+		return console_logo_pal[vc_logo_idx[ly * CONSOLE_LOGO_W + lx]] & 0x00ffffff;
+	}
+	return vc_color_back;
+}
