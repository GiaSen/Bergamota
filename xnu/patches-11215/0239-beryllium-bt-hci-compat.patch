+		for (i = 0; i < len; i++) {
+			ev[i] = pkt[i];
+		}
+		len = bt_hci_compat(ev, len);
+		pkt = ev;
+	}
 	lck_mtx_lock(&bt_lock);
 	used = bt.wr - bt.rd;
 	if (BT_RING_SIZE - used < len) {
@@ -266,7 +424,10 @@ bt_tx_feed(const uint8_t *p, size_t n)
