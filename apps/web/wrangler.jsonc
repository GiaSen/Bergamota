{
  // Static site on Cloudflare Workers (assets only, no Worker code): / is the landing page, /flash/ the flasher.
  // Nothing from Apple or Qualcomm is ever part of dist/: users bring their own files and everything runs locally.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bergamota-web",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "bergamota.zesmoi.com.br", "custom_domain": true }]
}
