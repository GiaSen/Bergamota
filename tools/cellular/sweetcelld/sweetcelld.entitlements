<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- sweetcelld: IOS-26-Hot's cellulard-ents.plist (MIT) without the CallKit/call-history ones (no calls here yet) -->
<plist version="1.0">
<dict>
	<key>application-identifier</key>
	<string>com.apple.coretelephony</string>
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.systemstatus.publisher.domains</key>
	<array>
		<string>telephony</string>
		<string>data-access</string>
	</array>
	<key>com.apple.systemstatus.domains</key>
	<array>
		<string>telephony</string>
		<string>data-access</string>
	</array>
	<key>com.apple.CommCenter.fine-grained</key>
	<array>
		<string>spi</string>
		<string>identity</string>
		<string>data-usage</string>
		<string>cellular-plan</string>
	</array>
	<key>com.apple.coretelephony.Identity.get</key>
	<true/>
	<key>com.apple.private.network.socket-delegate</key>
	<true/>
	<key>com.apple.SystemConfiguration.SCDynamicStore-write-access</key>
	<true/>
	<key>com.apple.SystemConfiguration.SCPreferences-write-access</key>
	<true/>
</dict>
</plist>
